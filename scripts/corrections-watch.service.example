# The corrections pipeline, weekly: draft correction proposals from the
# newest claim-sweep report's state-changed flags (agent, propose-only),
# then deterministically validate and apply them (operator account).
#   sudo cp corrections-watch.service.example /etc/systemd/system/corrections-watch.service
#   sudo cp corrections-watch.timer.example /etc/systemd/system/corrections-watch.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now corrections-watch.timer
#
# Replace USER and REPO with the account and checkout path. The drafting half
# needs REVIEW_AGENT_BIN or CORRECTIONS_AGENT_BIN in REPO/.env (see
# .env.example); the applying half needs nothing but GNU patch on PATH.
#
# The two halves are separate ExecStart lines, both '-'-prefixed, so a failed
# or unset drafting agent never stops the applier from clearing proposals a
# previous run left queued, and neither failure reads as a failed unit: a
# rejection is routine output, not an error (apply_corrections.py exits 0).
# The alert stream carries what matters: one correction-applied alert per
# applied proposal, guard-rejection for an overreaching run.
[Unit]
Description=corrections pipeline: agent-drafted proposals, deterministic apply
Wants=network-online.target
After=network-online.target
# Reads the claim sweep's newest report, so run after it, not on top of it.
After=claim-sweep.service

[Service]
Type=oneshot
User=USER
WorkingDirectory=REPO
ExecStart=-REPO/scripts/agent-corrections.sh
ExecStart=-REPO/.venv/bin/python REPO/scripts/apply_corrections.py --yes
TimeoutStartSec=3600
Environment=PATH=/home/cc-vuln/.local/bin:/usr/local/bin:/usr/bin:/bin
# NoNewPrivileges is not set: it would block the setuid transition the driver
# uses to drop into the agent account. See agent-hardening.conf.example.
#
# The drafting half runs an agent over pages and captures strangers wrote, so
# install the shared hardening drop-in beside this unit
# (scripts/agent-hardening.conf.example) and the agent account it drops to
# (docs/operations.md, "The agent account"), plus the loopback drop-in
# (scripts/agent-loopback-deny.conf.example). The agent never fetches: the
# driver hydrates the flags, the affected pages and the capture excerpts
# first, so the only outbound traffic is the agent CLI reaching its model
# API.

[Install]
WantedBy=multi-user.target
