# Fire publish-scheduled.service every three hours. See the .service example.
#
# Three hours, not thirty minutes: a deploy is a public act and each one leaves
# a Cloudflare Pages deployment behind that stays reachable at its own
# subdomain, so a tighter cadence accumulates published copies faster than it
# adds freshness. The service skips cleanly when nothing has changed, so the
# real cost of a quiet tick is one hash.
#
# Pinned to :50 (9 Aug 2026): the anchored 3-hourly tick raced record-commit —
# it evaluated the tree at :35, two minutes before the hourly :37 commit
# landed, and skipped on the dirt the commit was about to sweep. :50 is after
# the commit tick and clear of the :23/:53 polls.
[Unit]
Description=publish the site every three hours if the record has moved

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:50:00 UTC
RandomizedDelaySec=180
Unit=publish-scheduled.service

[Install]
WantedBy=timers.target
