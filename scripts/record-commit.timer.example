# Fire record-commit.service hourly. See record-commit.service.example.
#
# Hourly, not on the poll's thirty minutes: a commit is cheap but each one is
# history, and an hour of pipeline churn reads well as one commit. Pinned to
# :37, just after the :23 poll typically releases the archive writer lock
# (observed 8-9 Aug 2026: the anchored hourly tick with jitter kept landing
# mid-poll and blocking on exit 21 more often than it committed).
[Unit]
Description=commit guard-passed pipeline output every hour

[Timer]
OnCalendar=*-*-* *:37:00 UTC
RandomizedDelaySec=120
Unit=record-commit.service

[Install]
WantedBy=timers.target
