# Run community-thread discovery and intake once. Paired with
# discover-community.timer.
#   sudo cp discover-community.service.example /etc/systemd/system/discover-community.service
#   sudo cp discover-community.timer.example /etc/systemd/system/discover-community.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now discover-community.timer
#
# Replace USER and REPO with the account and checkout path.
#
# Three steps, one quiet run: Stacker News discovery (two feed requests),
# Reddit discovery (two listing reads through the capture browser session),
# BitcoinTalk discovery (two board index pages, direct), then the intake
# agent assessing whatever is pending in DISCOVERY.md. The
# discovery steps carry "-" so one platform being unreachable does not skip
# the other or the intake. Nothing here writes to archive/ except the intake
# agent's first captures via capture.py's own lock. Keep the cadence at the
# timer's twice a day unless the site operators have been asked; see the
# script docstrings and BACKLOG.md.
[Unit]
Description=community-thread discovery and intake (Stacker News + Reddit, gentle)
Wants=network-online.target
After=network-online.target webbridge.service

[Service]
Type=oneshot
User=USER
WorkingDirectory=REPO
ExecStart=-REPO/.venv/bin/python scripts/discover_stackernews.py
ExecStart=-REPO/.venv/bin/python scripts/discover_reddit.py
ExecStart=-REPO/.venv/bin/python scripts/discover_bitcointalk.py
ExecStart=REPO/scripts/agent-discovery-intake.sh
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
