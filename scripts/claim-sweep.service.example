# Recheck unverified claim markers with the sweep agent (scripts/claim-sweep.sh).
# Optional: the site works without it; unverified claims then go stale until a
# human rechecks them. Install the pair:
#   sudo cp claim-sweep.service.example /etc/systemd/system/claim-sweep.service
#   sudo cp claim-sweep.timer.example /etc/systemd/system/claim-sweep.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now claim-sweep.timer
#
# Replace USER and REPO with the account and checkout path. Requires
# REVIEW_AGENT_BIN or CLAIM_SWEEP_AGENT_BIN in REPO/.env (see .env.example).
#
# Install the shared hardening drop-in beside it
# (scripts/agent-hardening.conf.example) and the agent
# account it drops to (docs/operations.md, "The agent account"). Without them
# claim-sweep.sh refuses to run rather than running unprotected.
[Unit]
Description=claim-verification sweep of unverified markers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=USER
WorkingDirectory=REPO
ExecStart=REPO/scripts/claim-sweep.sh
TimeoutStartSec=3600
# NoNewPrivileges is not set: it would block the setuid transition the driver
# uses to drop into the agent account. See agent-hardening.conf.example.
#
# Evidence is driver-held and the agent reaches only its model provider through
# the egress proxy. It has no business on other host services, so it also takes the loopback drop-in,
# scripts/agent-loopback-deny.conf.example, which puts the capture browser and
# the cloud metadata endpoint out of reach. Do not write that rule inline as
# `IPAddressAllow=any` plus `IPAddressDeny=localhost`: an allow entry beats a
# deny entry whatever its prefix, so that spelling silently permits
# everything. The drop-in explains it and carries the measurement.

[Install]
WantedBy=multi-user.target
