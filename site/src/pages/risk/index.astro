---
import Article from '../../layouts/Article.astro';
import Answer from '../../components/Answer.astro';
import Claim from '../../components/Claim.astro';
import Disclosure from '../../components/Disclosure.astro';
import SeedWarning from '../../components/SeedWarning.astro';
import { MODEL_RANGES, VENDOR_RANGE_AS_OF, vendorDivergences } from '../../lib/firmware';

// The affected ranges and the places the vendor states a narrower one both come
// from src/lib/firmware.ts, the same module the firmware record renders from.
const divergences = vendorDivergences();

const decisionFlow = `flowchart TD
  START(["Where did the mnemonic come from?"])
  START -->|"imported or generated elsewhere"| PROV{"Generation method and provenance independently verified?"}
  PROV -->|"yes, outside the affected path"| OUT["Not affected by this generator"]
  PROV -->|"no or unknown"| ORIGIN["Assess the original generation method"]
  START -->|"generated on a COLDCARD"| FW{"Firmware used at generation"}
  FW -->|"before affected range"| CLEAN["Not affected by this incident"]
  FW -->|"named vendor fix release"| FIX["Source fix verified; published binary not independently checked here"]
  FW -->|"inside affected range or unknown"| DICE{"Dice workflow"}
  DICE -->|"pure dice, sufficient fair secret rolls"| PURE["Affected generator bypassed"]
  DICE -->|"mixed dice"| MIX["Assess roll count and secrecy"]
  DICE -->|"none or unknown"| HELD{"How are funds controlled?"}
  MIX --> HELD
  HELD -->|"single signature"| SINGLE["Assess passphrase and migrate"]
  HELD -->|"threshold wallet"| THRESH["Count affected keys against threshold"]
  THRESH -->|"below threshold"| BELOW["Affected keys alone cannot sign\nrotate them"]
  THRESH -->|"at or above threshold"| PUB["Check script, descriptor and\npublic-key exposure before moving"]`;
---

<Article
  title="Assessing your exposure"
  description="A source-based decision path for determining whether a mnemonic used the affected COLDCARD generator and which wallet properties change the response."
  standfirst="Firmware at generation, dice workflow, passphrase generation and threshold structure are the facts that change the assessment."
  depth="plain"
  kicker="Your risk"
>
  <Answer>
    <p>
      The fact that settles whether your seed words are affected is the firmware
      version running when they were created. Installing an update later does not
      change an existing mnemonic. Four further facts change what you should do
      about it: the dice workflow used, how any passphrase was generated, the
      threshold structure of the wallet, and whether its script or descriptor has
      been exposed. None of them requires seed words, a passphrase, private keys
      or an extended private key. Seed words are not the only thing the affected
      generator produced, so if your seed came from dice or from elsewhere, the
      <a href="/how-it-broke/blast-radius/">other device-produced secrets</a> are a
      separate question worth reading.
    </p>
  </Answer>

  <p class="cap">
    Would rather answer questions than read a path?
    <a href="/affected/">The check on Am I affected?</a> asks the same things,
    six at most, entirely in your browser, and never asks for your seed words.
  </p>

  <h2>Decision path</h2>

  <div class="mermaid-wrap">
    <pre class="mermaid" set:text={decisionFlow}></pre>
  </div>
  <p class="cap">
    The branches identify which technical question comes next. They are not a
    substitute for the model-specific firmware range below.
  </p>

  <h2>Affected generation ranges</h2>

  <div class="table-wrap">
    <div class="table-scroll">
      <table class="data-table">
        <caption>
          Firmware status at mnemonic generation
          <Claim
            basis="verified"
            contested
            scope="The affected firmware ranges and source-level fixes represented in the generation-method table above, including the Mk2 and Mk3 range starting at v4.0.0"
            source="Firmware release histories, the v4.0.0 release commit 910e306e and its pinned libngu revision, the signed-release record listing the 17 March 2021 image, source at the relevant commits, and the vendor downloads page listing 4.2.0 for Mk2 and Mk3"
            href="/record/firmware/"
            compact
          />
          <Claim
            basis="unverified"
            scope="Whether the vendor-published hotfix binaries exactly reproduce the reviewed source-level fixes and provide the intended entropy at runtime"
            source="The signed release images have not been independently reproduced, compared with local builds or disassembled by this project"
            href="/how-it-broke/#the-fix"
            compact
          />
        </caption>
        <thead>
          <tr>
            <th scope="col" class="nw">Model</th>
            <th scope="col" class="nw">Not affected</th>
            <th scope="col" class="nw">Affected</th>
            <th scope="col" class="nw">Named vendor fix release</th>
          </tr>
        </thead>
        <tbody>
          {MODEL_RANGES.map((m) => (
            <tr>
              <td class="nw">{m.model}</td>
              <td class="nw">
                {m.lastSafe
                  ? <Fragment><code>{m.lastSafe}</code> or earlier</Fragment>
                  : m.notAffected}
              </td>
              <td class="nw">
                {m.affectedFrom
                  ? <Fragment><code>{m.affectedFrom}</code> to <code>{m.affectedTo}</code></Fragment>
                  : 'none identified'}
                <a
                  class="fnref"
                  href="#vendor-range"
                  hidden={!m.vendorAffectedFrom}
                  aria-label="Coinkite states a narrower lower bound; see the note below the table"
                >&#8224;</a>
              </td>
              <td class="nw">
                {m.fix
                  ? <Fragment><code>{m.fix}</code><small>{m.fixCaveat}</small></Fragment>
                  : m.fixCaveat}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="fn">
    {divergences.map((d) => (
      <p>
        <span class="fn__mark">&#8224;</span>
        Coinkite publishes a narrower lower bound for {d.modelsPhrase}:
        {' '}<code>{d.vendorAffectedFrom}</code> rather than
        {' '}<code>{d.affectedFrom}</code>.
        <Claim
          basis="reported"
          scope="Coinkite's currently published Mk2 and Mk3 lower bound of v4.0.1, marked against the table above and not adopted as this site's boundary"
          source="Captured Coinkite Mk3 advisory and entropy technical backgrounder, both of which state 4.0.1 through 4.1.9; the vendor has already revised this range once"
          href="/record/sources/coinkite-mk3-advisory/"
          compact
        />
        {' '}The evidence on each side is below.
      </p>
    ))}
  </div>

  <Disclosure
    id="vendor-range"
    title="Where Coinkite states a narrower affected range"
    note="neither boundary is a typographical slip"
  >
    <div class="fn">
      {divergences.map((d) => (
        <p>
          Coinkite's Mk3 advisory and technical backgrounder, in the versions
          held here as of {VENDOR_RANGE_AS_OF}, give the affected range for
          {' '}{d.modelsPhrase} as
          {' '}<code>{d.vendorAffectedFrom}</code> to <code>{d.affectedTo}</code>,
          rather than from <code>{d.affectedFrom}</code>. {d.note} {d.corroboration}
          <Claim
            basis="reported"
            scope="The chain-analysis sentence in the note above: Galaxy Research's statement that no coin drained in its first three waves was created before roughly block 674,951 on 17 March 2021"
            source="Galaxy Research's captured 1 August 2026 thread, which states that it has not tested whether the identified addresses were generated with low entropy; it corroborates a March 2021 onset and does not establish which release marks the boundary"
            href="/record/sources/glxyresearch-firmware-block-boundary/"
            compact
          />
          {' '}The
          {' '}<a href="/record/firmware/#vendor-lower-bound">firmware timeline</a>
          {' '}sets out the release commit, the pinned libngu revision, the
          signed-release entry and the limits on that chain analysis; the
          {' '}<a href="/record/sources/coinkite-mk3-advisory/">captured advisory</a>
          {' '}carries the vendor wording.
        </p>
      ))}
    </div>
  </Disclosure>

  <h2>Confirmed losses by model, as of 3 August 2026</h2>

  <p>
    The ranges above describe which devices could generate weak seeds. They do
    not say which models have demonstrably lost funds. As of 3 August 2026, no
    captured source demonstrates a confirmed drain of a wallet generated on a
    Mk4, Mk5 or Q, and close observers were asking exactly that question:
    <a href="/record/sources/robhamilton-mk4-confirmation-question/">Rob
    Hamilton asked on 2 August</a> whether any Mk4, Mk5 or Q compromise had
    been confirmed, noting that multiple earlier claims had been retracted,
    and asked how much collective effort was being applied to the larger
    Mk4-class keyspace.
    <Claim
      basis="reported"
      scope="Hamilton's 2 August question whether any Mk4, Mk5 or Q compromise had been confirmed, his note that multiple claims had been retracted, and his question about collective search effort"
      source="Rob Hamilton (AnchorWatch), captured X post, 2 Aug 2026"
      href="/record/sources/robhamilton-mk4-confirmation-question/"
      compact
    />
    The absence of a confirmed case by that date is not a
    safety finding: the <a href="/how-it-broke/entropy/">published
    estimates</a> disagree by many orders of magnitude about how large the
    effective Mk4-class search is, and the date is part of the statement.
    <Claim
      basis="unverified"
      scope="Whether any Mk4, Mk5 or Q wallet has in fact lost funds in this incident"
      source="No captured source demonstrates a confirmed Mk4-class drain as of 3 Aug 2026; such claims have been made and later retracted, and absence from this archive is not evidence of safety"
      compact
    />
  </p>

  <h2>What changes the response</h2>

  <div class="outcomes">
    <div class="oc oc--act">
      <span class="oc__tag">Higher priority</span>
      <p class="oc__head">An affected mnemonic with no independently generated secret protecting the spend</p>
      <ul>
        <li>Single-signature wallet without a uniformly generated BIP39 passphrase</li>
        <li>Threshold wallet where affected key targets meet the threshold and the complete script, descriptor or equivalent construction data is exposed</li>
        <li>Generation on affected firmware is established, but dice use cannot be established</li>
      </ul>
      <p class="oc__do">
        <a href="/risk/moving-funds/">Moving funds from an affected seed</a>:
        the ordered steps, with the threshold-wallet script-reveal problem in
        its closing rung.
      </p>
    </div>

    <div class="oc oc--plan">
      <span class="oc__tag">Needs individual assessment</span>
      <p class="oc__head">A separate source of uncertainty or a hidden script may change the search</p>
      <ul>
        <li>Dice were mixed into an affected generated seed</li>
        <li>A uniformly generated BIP39 passphrase is in use</li>
        <li>A threshold wallet has not revealed its script or descriptor</li>
        <li>The mnemonic was imported, but its original generation method or provenance cannot be independently verified</li>
      </ul>
      <p class="oc__do">
        Record the actual roll count, passphrase generation method and descriptor
        custody, then read
        <a href="/risk/mitigations/">dice, passphrases and multisig</a> and the
        <a href="/risk/estimator/">candidate-space estimator</a>.
      </p>
    </div>

    <div class="oc oc--safe">
      <span class="oc__tag">Not affected by this generator</span>
      <p class="oc__head">The mnemonic did not depend on the affected path</p>
      <ul>
        <li>Generated on a pre-affected firmware release identified in the table</li>
        <li>Imported from a source whose generation method and provenance were independently verified as outside the affected path</li>
        <li>Generated through the pure-dice path with sufficient fair, independent and undisclosed rolls</li>
      </ul>
      <p class="oc__do">
        This conclusion is limited to the predictable-generator incident. It is
        not a general security assessment of the wallet or backup process.
      </p>
    </div>
  </div>

  <p>
    Whether dice, a passphrase or a threshold wallet changes any of this is
    answered in one place:
    <a href="/risk/mitigations/">dice, passphrases and multisig</a>. What else
    was derived from the same words is on
    <a href="/how-it-broke/blast-radius/">what else is affected</a>.
  </p>

  <SeedWarning compact />

  <Disclosure
    id="other-products"
    title="TAPSIGNER, OPENDIME and SATSCARD"
    note="reported not affected, on a different codebase"
  >
    <p>
      Coinkite reports that TAPSIGNER, OPENDIME and SATSCARD use different
      codebases and are not affected.
      <Claim
        basis="reported"
        scope="Coinkite's statement that TAPSIGNER, OPENDIME and SATSCARD are not affected because they use different codebases"
        source="Coinkite entropy technical backgrounder; those product codebases have not been independently assessed by this archive"
        href="https://blog.coinkite.com/entropy-technical-backgrounder/"
        compact
      />
      Those codebases have not been independently
      assessed by this archive.
    </p>
  </Disclosure>
</Article>

<style>
  .outcomes {
    display: grid; gap: 1rem; margin-block: 1.6rem;
    grid-template-columns: repeat(auto-fit, minmax(272px, 1fr));
  }
  .oc {
    --tone: var(--info); --tone-soft: var(--info-soft);
    display: flex; flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--tone);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem;
    min-width: 0;
  }
  .oc--act  { --tone: var(--danger); --tone-soft: var(--danger-soft); }
  .oc--plan { --tone: var(--warn);   --tone-soft: var(--warn-soft); }
  .oc--safe { --tone: var(--safe);   --tone-soft: var(--safe-soft); }
  .oc__tag {
    align-self: flex-start;
    font-family: var(--font-mono); font-size: .62rem; font-weight: 700;
    letter-spacing: .13em; text-transform: uppercase;
    color: var(--tone); background: var(--tone-soft);
    padding: .22em .6em; border-radius: 999px;
  }
  .oc__head {
    font-weight: 500; font-size: 1rem; line-height: 1.45;
    margin-top: .7rem;
  }
  .oc ul {
    list-style: none; padding: 0;
    margin: .8rem 0 0; flex: 1;
    font-size: .86rem; line-height: 1.55; color: var(--ink-2);
  }
  .oc li { padding-left: .95rem; position: relative; margin-bottom: .4rem; }
  .oc li::before {
    content: ''; position: absolute; left: 0; top: .58em;
    width: 4px; height: 4px; border-radius: 50%; background: var(--tone);
  }
  .oc__do {
    margin-top: 1rem; padding-top: .8rem;
    border-top: 1px solid var(--rule);
    font-size: .85rem; line-height: 1.6;
  }
  /* Where this site and the vendor state different affected ranges, the marker
     has to sit in the cell the reader is actually reading. The cell stays a
     range; the disagreement gets its sentence directly beneath the table. */
  .fnref {
    font-size: .8em; vertical-align: super; line-height: 0;
    margin-left: .15em; text-decoration: none; color: var(--accent);
  }
  .fn {
    font-family: var(--font-ui); font-size: .84rem; color: var(--ink-3);
    line-height: 1.65; max-width: 74ch; margin: .6rem 0 1.2rem;
  }
  .fn p { position: relative; padding-left: 1.15rem; }
  .fn p + p { margin-top: .55rem; }
  .fn__mark { position: absolute; left: 0; color: var(--accent); }
</style>
