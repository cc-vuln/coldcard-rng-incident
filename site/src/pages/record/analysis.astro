---
import Article from '../../layouts/Article.astro';
import Answer from '../../components/Answer.astro';
import CaptureThumb from '../../components/CaptureThumb.astro';
import Claim from '../../components/Claim.astro';
import {
  xPosts, xPostById, sourceById, displayTitle, isoToHuman,
} from '../../lib/archive';
import { fig } from '../../lib/figures';

// Register original analyses separately from reporting that restates them.
const PRIMARY = [
  {
    who: 'Block engineering, with anonymous collaborators',
    what: 'The technical disclosure',
    url: '/record/sources/block-disclosure/',
    detail: 'Identified the migration commit, showed that the Mk4-class reseed carries at most 32 bits into one libngu state word, and published lower candidate-space scenarios. Bitcoin Optech reports that anonymous researchers participated and that disclosure was coordinated with Coinkite.',
    status: 'Verified against the report and source repositories.',
    scope: 'The candidate-space figures are scenarios with stated attacker-knowledge assumptions, not per-device measurements.',
  },
  {
    who: '3z',
    what: 'Mk3 binary reversal and bounded synthetic proof of concept',
    url: '/record/sources/threez-mk3-rng-disclosure/',
    detail: 'Reports reproducible builds of Mk3 4.1.9 and 4.2.0, compares the resolved RNG symbols in both binaries, and models the vulnerable path with fixed synthetic register inputs. The repository says it contains no enumeration, wallet-recovery or fund-targeting capability.',
    status: 'Reported independent binary analysis; the README is captured for revision tracking.',
    scope: 'This archive has not independently reproduced the builds or endorsed the author\'s candidate-state calculation. The synthetic proof establishes determinism for its inputs, not a measured remote-search cost for a wallet population.',
  },
  {
    who: 'Kelbie',
    what: 'A chain-derived and rapidly updated postmortem',
    url: '/record/sources/kelbie-rng-postmortem/',
    detail: 'Publishes frozen chain data, explicit rules for deriving collectors and waves, source recovery notes and reconciliation checks. The project distinguishes victim-named evidence, publisher attribution and its own pattern matches.',
    status: 'Reported independent chain analysis; its mutable README is captured for revision tracking.',
    scope: 'The chain can verify transactions and amounts. Wave grouping, common-control attribution, tool fingerprints and counterfactual claims remain the author\'s derivations and may change as new reports appear.',
  },
  {
    who: 'Kevin Kelbie',
    what: 'The 2 August tracker update',
    url: '/record/sources/kevinkelbie-tracker-update/',
    detail: `Announced a major update to the tracker built on that dataset: ${fig('kelbieTrackerBtc')} stated as tracked across ${fig('kelbieTrackerAddresses')}, coins followed from victim addresses to their current position, a timeline running from the 2021 bug to the July 2026 sweeps, and a searchable ledger, then at coldcard-hack.up.railway.app and <a href="/record/sources/kevinkelbie-tracker-move/">moved to coldcard.rip on 3 August</a>. The total is numerically close to Galaxy's revised ${fig('galaxyRevisedTotalBtc')} across ${fig('galaxyRevisedAddresses')}, but neither source states that the two sets are the same, so the <a href="/record/funds/">funds page</a> registers them as separate reported figures.`,
    status: 'Reported tracker totals.',
    scope: 'The post does not itemise which waves its set counts or restate the attribution rules behind the new total.',
  },
  {
    who: 'Álvaro P.',
    what: 'Reproducible firmware and chain investigation',
    url: '/record/sources/alvap-weak-rng-research/',
    detail: 'Reports independent checks of the fix commits, a chain reconstruction from a public consolidation point, and compiled vulnerable and patched firmware symbol comparisons. The repository separates completed evidence from planned synthetic and regtest demonstrations.',
    status: 'Reported independent reproduction; the public README is captured for revision tracking.',
    scope: 'The repository has not been audited in full by this archive. Deeper files contain public transaction identifiers, so only the address-free README is mirrored publicly here.',
  },
  {
    who: 'Rob Hamilton, AnchorWatch',
    what: 'On-chain forensics, and the front-running warning',
    url: '/record/sources/robhamilton-preliminary-sweep/',
    detail: 'Reported 1,324 UTXOs across 500 transactions, approximately 594.48 BTC and a later 562 BTC consolidation. The transactions occupy four block heights, not the "3 block window" in the post. Hamilton separately described the first-spend script-reveal risk for threshold wallets in a <a href="/record/sources/robhamilton-multisig-psa/">captured migration PSA</a>.',
    status: 'Reported primary analysis.',
    scope: 'The post labels the entropy attribution preliminary. The chain establishes movements, not the COLDCARD cause by itself.',
  },
  {
    who: 'Clay Garrett and Block engineering',
    what: 'The preliminary earlier-wave scan',
    url: '/record/sources/clay-earlier-waves-thread/',
    detail: `Reported ${fig('earlierTxs')} earlier transactions with the same stated fingerprint as the known wave: 204 sweeps in block 960,183 and 491 in block 960,185, with ${fig('earlierBtc')} reaching three first collectors. The thread describes a scan of 888,661 transactions and lists the matching properties.`,
    status: 'Reported primary chain analysis.',
    scope: 'Block explicitly said it had not confirmed that the earlier waves were related to the drain. The shared fingerprint and arithmetic do not establish common control or cause by themselves.',
  },
  {
    who: 'LLFOURN',
    what: 'The attack-cost model',
    url: '/record/sources/llfourn-model/',
    detail: 'Published a model using about 2^20 MCU identifiers, 80,000 timing states and 16 button-press variants. This gives about 2^40.3 for Mk3 and 2^72.3 for Mk4-class devices. The source does not decompose the 16 variants further. A follow-up said clock assumptions might reduce the latter by 10 to 14 bits, and another reply described a 2^32 lower scenario when UID, button-press variation and clock behaviour are known.',
    status: 'Reported model; arithmetic checked against the stated inputs.',
    scope: 'The 2^20 UID range and practical timing distribution have not been independently measured here.',
  },
  {
    who: 'Kevin Loaec',
    what: 'An early hypothesis from the observed sweep pattern',
    url: '/record/sources/kloaec-early-hypothesis/',
    detail: 'Before the full technical account was public, Loaec proposed a low-entropy generator as the cause and pointed to BIP84-only searching, limited derivation depth and partial sweeps. The post presented AI-assisted script generation and the operator\'s limited Bitcoin knowledge as a hypothesis, not a demonstrated attribution.',
    status: 'Reported early analysis; the low-entropy direction was later confirmed.',
    scope: 'The derivation-pattern observations do not establish that the operator used AI or identify who discovered the defect.',
  },
  {
    who: 'Gregory Sanders (instagibbs)',
    what: 'Independent public confirmation',
    url: '/record/sources/instagibbs-reproduction/',
    detail: 'Published the statement: "Confirmed. Mk2/3 vuln, I don\'t think mk4 is but can\'t be certain." A <a href="/record/sources/instagibbs-reproduction-followup/">later captured post</a> says it took about one hour and 50 minutes from deciding to investigate to an on-device proof on Mk3.',
    status: 'Reported confirmation.',
    scope: 'The follow-up identifies Mk3 and the full investigation-to-proof interval. Neither post identifies firmware, method, candidate inputs, brute-force runtime or scripts. The elapsed interval is not an attack benchmark.',
  },
  {
    who: 'Praveen Perera',
    what: 'Independent recovery against the known stolen set',
    url: '/record/sources/praveenperera-reproduction-cost/',
    detail: 'Reported scanning index-zero addresses against the known first-wave address set and recovering two private keys associated with approximately 34 BTC. Perera reported that the run took about five minutes and less than US$5 of GPU time.',
    status: 'Reported independent reproduction.',
    scope: 'The code, candidate inputs and recovered keys are not public. The run targeted known stolen addresses and does not measure discovery of unknown still-funded wallets.',
  },
  {
    who: 'JStefanop1',
    what: 'A collision-search demonstration under the 40-bit model',
    url: '/record/sources/jstefanop-collision-program/',
    detail: 'Reports a program built on the 40-bit effective-state model, stating that a duplicate wallet appears on average about every 1.3 million seed generations, and that a collision was found in 4.7 seconds on an M1 Max at roughly 268,000 evaluated states per second. The attached screenshot shows the reported duplicate-seed run.',
    status: 'Reported independent demonstration.',
    scope: 'The code and inputs are not audited here and the rates are the author\'s own measurements. A collision inside the modelled state space demonstrates duplicate generation under that model; it is not a measured cost of finding unknown funded wallets.',
  },
  {
    who: 'Galaxy Research',
    what: 'The wider flow-of-funds mapping',
    url: '/record/sources/glxyresearch-flow-map/',
    detail: `Published a wider attributed set from 01:10:20 to 01:51:26 UTC across blocks 960,183 to 960,191, a ${fig('galaxyGrossBtc')} gross total and four consolidation holdings. The <a href="/record/funds/">funds page</a> keeps it as Galaxy's figure for the 30 July waves. Galaxy has since <a href="/record/sources/glxyresearch-third-wave-revision/">revised the total upward</a> over a wider scope, recorded as a separate entry below.`,
    status: 'Reported attribution.',
    scope: 'Galaxy does not publish its address-counting method. The chain does not establish common control or cause by itself.',
  },
  {
    who: 'Galaxy Research',
    what: 'The third-wave revision, and the method limit stated with it',
    url: '/record/sources/glxyresearch-third-wave-revision/',
    detail: `Identified a third sweep wave of ${fig('thirdWaveBtc')} and revised the estimated observed size of the incident to ${fig('galaxyRevisedTotalBtc')}, given as approximately US$88.6m, across ${fig('galaxyRevisedAddresses')}. The same thread reports ${fig('attackerHoldingsBtc')} under attacker control with <a href="/record/sources/glxyresearch-attacker-holdings/">every endpoint attacker address fully unspent</a>, and states that the vulnerable firmware shipped on 17 March 2021 around <a href="/record/sources/glxyresearch-firmware-block-boundary/">block 674,951</a> with no identified coin created before it. What that boundary means for published version ranges is kept on the <a href="/record/firmware/">firmware page</a>. Galaxy sets out its <a href="/record/sources/glxyresearch-methodology-disclaimer/">own method limit</a> in the same thread, which bounds every figure in it. Why that revised total is not an alternative measurement of the 30 July set is set out on <a href="/record/funds/#galaxy-revision">the funds page</a>.`,
    status: 'Reported attributed estimate; the underlying transaction and address lists are not published.',
    scope: 'Galaxy states that the work derives solely from Bitcoin block data and the unspent-output set, that it has not used compute to test whether the addresses it identifies as possible victims were generated with low entropy, and that the analysis should not be treated as complete or definitive.',
  },
  {
    who: 'Galaxy Research',
    what: 'How the waves were identified, and where findings go',
    url: '/record/sources/glxyresearch-victim-outreach-update/',
    detail: 'A 2 August status update on the provenance of the wave identifications: the wave-1 pattern came from Block engineers, while waves 2 and 3 were identified because victims came forward. The update asks victims to share affected addresses and transaction IDs with @intangiblecoins without personal identifying information, states that findings are being shared with US authorities, SEAL, exchanges and cyber investigators, and promises a substantive update.',
    status: 'Reported status update; the stated sharing and escalation are not observable from here.',
    scope: 'The update describes process and provenance rather than new totals. Victim-supplied addresses are reports to Galaxy, not verified attributions, a limit Galaxy\'s own methodology disclaimer also states.',
  },
  {
    who: 'Galaxy Research',
    what: 'The 3 August confirmed total, and the wave-4 caveat',
    url: '/record/sources/glxy-losses-exceed-100m/',
    detail: `Revised the top line to a high-confidence ${fig('galaxyConfirmedBtc')} stolen from ${fig('galaxyConfirmedAddresses')} across three confirmed waves plus 14 smaller incidents, stated as exceeding US$100M and superseding the 1 August figure. The confirmation basis changed with the number: wave 1, first observed by Block engineers, is now fully confirmed through victim reports, waves 2 and 3 were discovered through victim reports, and 73 individual victims have contacted @intangiblecoins for tracing help. The 14 smaller footprints could be many different attackers individually exploiting the now-known vulnerability. Including a suspected fourth wave would bring the total to ${fig('galaxyInclWave4Btc')}, but Galaxy does not promote it without victim confirmation. The same thread states that 90 percent of stolen coins have not moved and 100 percent of waves 1 to 3 coins are unmoved, that confirmed attacker and victim addresses have been provided to US federal law enforcement, exchanges and compliance firms, and that the attack is ongoing.`,
    status: 'Reported victim-confirmed estimate; the underlying transaction and address lists are not published.',
    scope: 'Galaxy\'s 1 August method limit still bounds these figures: the work derives from block data and the unspent-output set, without testing whether identified addresses were generated with low entropy, and should not be treated as complete or definitive.',
  },
  {
    who: 'profedustream',
    what: 'A published mapping export and a two-actor hypothesis',
    url: '/record/sources/profedustream-mapping-export/',
    detail: 'Published the JSON export of a multi-day on-chain mapping. It describes a scripted first wave whose consolidations remain untouched; a noisier, more erratic pattern whose movements reach clusters the author links to Chivo Wallet and Binance, six ChangeNOW transactions, and one CoinJoin service whose outputs were later connected to Binance; and further script-like waves that also remain unmoved. On that split the author offers a working hypothesis of two actors.',
    status: 'Reported independent mapping; the export and its cluster attributions have not been rechecked here.',
    scope: 'The exchange and service cluster labels are the author\'s attributions, and the two-actor reading is stated as a working hypothesis rather than a finding. Behavioural differences between waves do not by themselves establish separate operators.',
  },
  {
    who: 'Clay Garrett, Block',
    what: 'The attribution finding',
    url: '/record/sources/clay-attribution/',
    detail: 'Reported that the operator queried the source addresses through a paid account at a blockchain-services provider during the sweeps, and that the provider\'s logs matched the suspected workflow "with extraordinary specificity, including the number, timing and sequence of requests".',
    status: 'Reported by Block; not independently verifiable from public data.',
    scope: 'The provider remains unnamed at its request. Block says it found no evidence that the provider knowingly participated.',
  },
  {
    who: 'Talip (@otaliptus)',
    what: 'Independent technical analysis',
    url: '/record/sources/otaliptus-technical/',
    detail: 'Published a separate, deliberately tentative Mk4 model. It assumes a remote attacker does not know the UID, estimates about 20 to 21 bits from the wafer-coordinate word, narrows the practical SysTick positions, and makes the unresolved RTC term visible. The post reports roughly 52 to 63 bits if RTC behaviour is problematic and roughly 75 to 88 bits if it is not. The author labels the work brainstorming and lists assumptions that may be wrong. <a href="https://x.com/otaliptus" rel="noopener nofollow">Profile</a>.',
    status: 'Unverified working hypothesis.',
    scope: 'The author calls it brainstorming, says details may be wrong and credits GPT-5.6 Pro with document checking. It is retained as commentary, not a settled estimate.',
  },
  {
    who: 'Kevin Loaec, Wizardsardine',
    what: 'The post-mortem and the derived-material argument',
    url: '/record/sources/wizardsardine-postmortem/',
    detail: 'Reconstructs the flaw at length and argues its reach goes past seed generation: on affected devices, features that draw on the same generator are reported broken even where the seed itself was imported or created with dice. The post opens with configuration-specific guidance for Liana, Miniscript and multisig users before turning to the incident. A <a href="/record/sources/kloaec-derived-feature-exposure/">companion post</a> enumerates the features in an attached graphic that did not render in the held capture.',
    status: 'Reported independent analysis; the mutable post is captured for revision tracking.',
    scope: 'Wizardsardine sells Liana, a competing wallet product, and the first section is written as guidance to its own users. The authors describe the post as written quickly under stress and invite corrections. The feature-exposure claims are their reading until checked against source, and nothing in the post has been reproduced here.',
  },
  {
    who: 'Dustin Dettmer',
    what: 'The commit-history reading of how the defect entered',
    url: '/record/sources/btcpp-dettmer-commit-history/',
    detail: 'Traces the firmware commit history behind the disabled hardware generator: a commit whose entire message is "runs" sets <code>MICROPY_HW_ENABLE_RNG</code> to zero next to a duplicate symbol definition that would not otherwise have compiled, and the overridden functions turn out not to be the ones seed generation reaches. Published on bitcoin++ Insider Edition and <a href="/record/sources/btcpp-dettmer-analysis-announcement/">announced there</a>.',
    status: 'Reported independent source reading; the commit-level claims are checkable against the pinned repository clones held here.',
    scope: 'The account of what the original author intended, and of the frustration inferred from it, is the writer\'s reading of commit messages and diffs rather than established fact. This archive has not rechecked every commit cited.',
  },
  {
    who: 'Milk Sad researchers',
    what: 'Contextual weak-key precedent',
    url: 'https://milksad.info/disclosure.html',
    detail: 'A separate weak-key incident with a public disclosure and an attempt to account for affected funds. It is included as context on the <a href="/response/#precedent">precedent comparison</a>, not as evidence about COLDCARD.',
    status: 'Verified contextual source.',
    scope: 'Different generator, affected population and disclosure process.',
  },
];

const trackers = ['coldcard-watch', 'coldcard-hack-tracker']
  .map((id) => sourceById(id))
  .filter(Boolean);

/*
 * Dates come from the source registry rather than being typed here, so a
 * register entry cannot drift away from the record it points at. `published` is
 * used for documents and `posted` for social threads; for a mutable repository
 * README it is when the work was first published, not when the held state was
 * captured. Where neither is established the entry says so rather than guessing.
 */
function publishedLabel(url: string): string {
  const id = /^\/record\/sources\/([^/]+)\//.exec(url)?.[1];
  if (!id) return 'publication date not established here';
  const iso = sourceById(id)?.published ?? xPostById(id)?.posted;
  return iso ? isoToHuman(iso) : 'publication date not established';
}

const primaryWithLinkMetadata = PRIMARY.map((entry) => ({
  ...entry,
  when: publishedLabel(entry.url),
  evidenceRel: entry.url.startsWith('http') ? 'noopener nofollow' : undefined,
  /*
   * Registry id behind a local evidence link, handed to CaptureThumb below.
   * The component applies both publication gates (staged via the x-media
   * manifest, and not withheld) and renders nothing for entries whose evidence
   * is a web page rather than a captured post, so this page keeps exactly its
   * text-only rendering when nothing is staged.
   */
  thumbId: /^\/record\/sources\/([^/]+)\//.exec(entry.url)?.[1] ?? '',
}));

const posts = xPosts();
---

<Article
  title="Primary-analysis register"
  description="A register of the primary research behind the COLDCARD entropy incident: Block, Rob Hamilton, LLFOURN, instagibbs, Galaxy Research and others, with what each contributed."
  standfirst="Original analyses are listed with what each source states, what has been independently checked, and what remains an assumption."
  depth="plain"
  kicker="Evidence"
>
  <Answer>
  <p>
    Original analysis and reporting that restates it are different things, and
    this page registers only the first. Each entry names who published it, what
    it added to the public record, what has been checked here, and what remains
    that source's assumption. The candidate-space estimates below differ because
    their authors assume different attacker knowledge; none is a measured
    population-wide search cost.
  </p>
  </Answer>

  <p>
    An entry is listed here when it introduced something no earlier source had:
    a firmware or binary reading, a chain derivation, a candidate-space model, a
    reproduction, or an attribution finding. Restatement belongs on the
    <a href="/record/">source list</a> instead. Inclusion records provenance
    rather than endorsement, and each date is the registered first publication,
    not the capture.
    <Claim
      basis="reported"
      scope="The attributed contributions, models and evidentiary limits in the primary-analysis register below"
      source="Original technical reports, researcher posts and captured publications linked from each entry"
      href="/record/"
      compact
    />
  </p>

  <p>
    The candidate-space estimates in this register apply different assumptions
    about what a remote attacker knows at the moment of generation. Each
    assumption is written out beside its number on the
    <a href="/how-it-broke/entropy/">attack-cost page</a>, and they should not be
    combined without carrying those assumptions with them.
    <Claim
      basis="reported"
      scope="The differing Mk4-class candidate-space figures attributed above to Coinkite, LLFOURN, Talip and Block"
      source="Each publisher's own stated estimate and assumptions, as captured; no independent measurement of a device is made here"
      href="/how-it-broke/entropy/"
    />
  </p>

  <div class="reg">
    {primaryWithLinkMetadata.map((p) => (
      <article class="reg__item">
        <div class="reg__head">
          <h2 class="reg__who">{p.who}</h2>
          <a class="reg__link" href={p.url} rel={p.evidenceRel}>evidence &rarr;</a>
        </div>
        <p class="reg__what">{p.what}</p>
        <p class="reg__when">{p.when}</p>
        <p class="reg__detail" set:html={p.detail} />
        <CaptureThumb id={p.thumbId} />
        <p class="reg__status">{p.status}</p>
        <p class="reg__scope">{p.scope}</p>
      </article>
    ))}
  </div>

  <h2>Community trackers</h2>

  <p>
    Two community trackers publish views of the attributed transaction set. They
    are independent of this archive. Their figures and methodology can change,
    and entering an address into any third-party site discloses that query to the
    operator and network intermediaries.
  </p>

  <ul class="node-list">
    {trackers.map((t) => (
      <li>
        <a href={`/record/sources/${t.id}/`}>{displayTitle(t)}</a>
        {' '}&middot;{' '}
        <a href={t.url} rel="noopener nofollow">{t.url}</a>
        <br /><span class="dim">{t.note}</span>
      </li>
    ))}
  </ul>

  <h2>Who is, and is not, investigating</h2>

  <p>
    The register above records who is doing the analysis. Two captured
    statements mark the edges of what else was reported. Galaxy's 2 August status update
    names the parties its findings are being shared with: US authorities,
    SEAL, exchanges and cyber investigators, alongside the victim outreach
    described in its register entry.
    <Claim
      basis="reported"
      scope="Galaxy's statement that its findings are being shared with US authorities, SEAL, exchanges and cyber investigators"
      source="Galaxy Research's captured 2 August status update; none of the stated sharing is observable from here"
      href="/record/sources/glxyresearch-victim-outreach-update/"
    />
    In the other direction, ZachXBT stated
    that he has no plans to monitor or trace the incident, citing where his
    donor support comes from.
    <Claim
      basis="reported"
      scope="ZachXBT's statement that he has no plans to monitor or trace the incident, and his stated reason"
      source="ZachXBT's captured post of 2 Aug 2026"
      href="/record/sources/zachxbt-declines-tracing/"
    />
    Both statements are recorded as made; neither
    the sharing nor the declination is adjudicated here.
  </p>

  {/*
    This was a second copy of the card wall on /record/: the same registry
    `why` field for the same {posts.length} posts, rendered in full, without
    the wall's facets, search or held-capture status. 2,624 nine-word
    sequences of this page were shared with /record/ because of it.
  */}
  <h2>Registered posts</h2>

  <p>
    {posts.length} social posts are registered, each with a local evidence
    record stating why it is retained and whether a capture is held:
    <a href="/record/#registered-posts">the registered-post wall</a>.
    Registry descriptions do not convert a reported claim into a verified one.
  </p>

  <div class="ve-card ve-card--blue">
    <div class="ve-card__label lbl-blue">Attribution corrections</div>
    <p>
      This page was corrected after timestamps showed that private-submission
      advice had been attributed to the wrong person. The
      <a href="/about/#editorial-standards">corrections process</a> accepts
      attributable evidence and records substantive changes.
    </p>
  </div>
</Article>

<style>
  .reg { display: grid; gap: 1rem; margin-block: 1.8rem; }
  .reg__item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
  }
  .reg__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .reg__who { font-size: 1.05rem; font-family: var(--font-display); font-weight: 400; margin: 0; }
  .reg__link {
    font-family: var(--font-mono); font-size: .68rem; color: var(--accent);
    text-decoration: none; white-space: nowrap;
  }
  .reg__link:hover { text-decoration: underline; }
  .reg__what {
    font-family: var(--font-mono); font-size: .64rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-3); margin-top: .35rem;
  }
  .reg__when {
    font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .04em; color: var(--ink-3); margin-top: .3rem;
  }
  .reg__detail { font-size: .89rem; line-height: 1.65; color: var(--ink-2); margin-top: .7rem; }
  .reg__status, .reg__scope {
    font-size: .82rem; line-height: 1.6; margin-top: .7rem;
    padding-top: .6rem; border-top: 1px solid var(--rule); color: var(--ink-3);
  }
  .reg__scope { margin-top: .35rem; padding-top: 0; border-top: 0; }
  .dim { color: var(--ink-3); font-size: .82rem; }
</style>
