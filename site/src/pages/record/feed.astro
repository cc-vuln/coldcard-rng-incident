---
import Base from '../../layouts/Base.astro';
import RecordSearch from '../../components/RecordSearch.astro';
import {
  sources, xPosts, revisions, snapshots, displayTitle, groupOf,
  isoToHuman, tsToIso, xArtifacts, summary, withholdsCapturedMedia,
} from '../../lib/archive';
import { xMedia } from '../../lib/xmedia';

/*
 * The record as one chronological stream.
 *
 * The register answers "what do we track"; this answers "what happened, in
 * order". Captures and detected changes interleave because to a reader they
 * are the same kind of event: something entered the record on a date. Every
 * entry links to the source page, where the artefacts and hashes live.
 *
 * Rendered in full at build time and revealed progressively, so the page
 * works with JavaScript off (everything visible) and stays light with it on.
 */

const srcById = new Map(sources().map((s) => [s.id, s]));

type Ev = {
  iso: string;
  kind: 'change' | 'post' | 'first';
  title: string;
  href: string;
  group: string;
  by: string;
  label: string;
  body: string;
  media: { src: string; name: string } | null;
};

const events: Ev[] = [];

// Detected differences: the archive's reason for existing.
for (const rev of revisions()) {
  const src = srcById.get(rev.sourceId);
  if (!src) continue;
  // The change is still reported; its content is withheld for sources
  // whose captured text is not ours to reproduce.
  // The diff body itself is published on /record/changes/ and on the source's
  // own page. Re-rendering it here made the feed a third copy of both: about
  // 10,300 of this page's words were already published elsewhere. The feed's
  // job is what happened, in order, and it links to each in one hop.
  events.push({
    iso: tsToIso(rev.ts),
    kind: 'change',
    title: displayTitle(src),
    href: `/record/sources/${src.id}/`,
    group: groupOf(src),
    by: src.org ?? '',
    label: rev.review.status === 'source-content'
      ? 'source content changed'
      : rev.review.status === 'capture-noise'
        ? 'collection difference'
        : rev.review.status === 'capture-correction'
          ? 'capture correction'
          : 'difference awaiting review',
    body: summary(rev.review.summary ?? `+${rev.added} -${rev.removed} lines`, 25),
    media: null,
  });
}

// First capture of each source: when it entered the record.
for (const src of sources()) {
  const snaps = snapshots(src.id);
  if (!snaps.length) continue;
  const first = snaps[0];
  events.push({
    iso: first.iso,
    kind: 'first',
    title: displayTitle(src),
    href: `/record/sources/${src.id}/`,
    group: groupOf(src),
    by: src.org ?? '',
    label: 'entered the record',
    body: summary(src.note?.trim().split('\n').join(' '), 25),
    media: null,
  });
}

// Registered X posts, shown with the held screenshot where there is one.
// Staging is a provenance check; withholding is the publication decision, and
// both must pass before an image renders. No source withholds today.
for (const post of xPosts()) {
  const shots = withholdsCapturedMedia(post) ? [] : xMedia(post.id);
  const held = xArtifacts(post).length;
  events.push({
    iso: post.posted ?? '',
    kind: 'post',
    title: displayTitle(post),
    href: `/record/sources/${post.id}/`,
    group: 'x',
    by: `@${post.author}${post.org ? ` · ${post.org}` : ''}`,
    label: held ? 'post captured' : 'post registered, capture pending',
    body: summary(post.why, 25),
    media: shots[0] ? { src: shots[0].src, name: shots[0].name } : null,
  });
}

const ordered = events
  .filter((e) => e.iso)
  .sort((a, b) => (a.iso < b.iso ? 1 : a.iso > b.iso ? -1 : 0));

const FACETS = [
  { value: 'vendor', label: 'Vendor' },
  { value: 'x', label: 'X posts' },
  { value: 'research', label: 'Research' },
  { value: 'reporting', label: 'Reporting' },
  { value: 'repo', label: 'Repos' },
  { value: 'firsthand', label: 'First-hand' },
  // Attribute facet: matches entries stamped data-has-shot, i.e. those whose
  // screenshot actually renders (staged and not withheld). JS-only, like the
  // group facets above.
  { label: 'With screenshots', attr: 'data-has-shot' },
];
const INITIAL = 24;
---

<Base
  title="Record feed"
  description="Every capture and detected change in the COLDCARD incident archive, newest first."
  kicker="The record"
>
  <div class="wrap feed-page">
    <h1>Record feed</h1>
    <p class="feed-lede">
      Everything that entered the record, newest first: captures as they were
      taken and differences as they were detected. This is the chronological
      view of the same evidence the
      <a href="/record/">register</a> lists by source. It shows what was
      captured; it does not endorse what a source said.
    </p>

    <RecordSearch
      target=".fev"
      placeholder="Search captures and changes"
      facets={FACETS}
    />

    <ol class="feed">
      {ordered.map((e, i) => (
        <li
          class:list={['fev', `fev--${e.kind}`]}
          data-group={e.group}
          data-has-shot={e.media ? '' : undefined}
          data-beyond={i >= INITIAL ? '' : undefined}
          hidden={i >= INITIAL}
        >
          <div class="fev__time">
            <time datetime={e.iso}>{isoToHuman(e.iso)}</time>
            <span class="fev__label">{e.label}</span>
          </div>
          <div class="fev__card">
            <a class="fev__title" href={e.href}>{e.title}</a>
            <p class="fev__by" hidden={!e.by}>{e.by}</p>
            <div class="fev__shot" hidden={!e.media}>
              <img src={e.media?.src} alt={`Captured screenshot: ${e.title}`} loading="lazy" />
            </div>
            <p class="fev__body" hidden={!e.body}>{e.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="feed__more">
      <button class="feed__btn" type="button">Show more</button>
      <p class="feed__status" role="status" aria-live="polite"></p>
    </div>
  </div>

  <script>
    // Progressive reveal. Everything is already in the DOM, so this only flips
    // `hidden`: with JavaScript off the whole feed is visible instead of empty,
    // which is the right failure for an archive.
    const STEP = 24;
    const items = [...document.querySelectorAll('.fev')];
    const btn = document.querySelector('.feed__btn');
    const status = document.querySelector('.feed__status');
    const wrap = document.querySelector('.feed__more');
    // Declared by the search component when present; harmless standalone.
    const show = window.applyVisibility || ((el) => {
      el.hidden = el.hasAttribute('data-nomatch') || el.hasAttribute('data-beyond');
    });

    function update() {
      const unrevealed = items.filter((el) => el.hasAttribute('data-beyond')).length;
      wrap.hidden = unrevealed === 0;
      status.textContent = unrevealed === 0
        ? `all ${items.length} events shown`
        : `${items.length - unrevealed} of ${items.length} shown`;
    }
    function more() {
      let n = 0;
      for (const el of items) {
        if (n >= STEP) break;
        if (el.hasAttribute('data-beyond')) {
          el.removeAttribute('data-beyond');
          show(el);
          n += 1;
        }
      }
      update();
    }
    btn.addEventListener('click', more);
    // While a filter is active every match is already shown, so the reveal
    // control would be meaningless; it returns when the filter is cleared.
    document.addEventListener('rs:filter', (e) => {
      if (e.detail && e.detail.filtering) wrap.hidden = true;
      else update();
    });
    // Infinite scroll: reveal as the end of the list comes into view, with the
    // button kept as the accessible and no-observer fallback.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) more();
      }, { rootMargin: '400px' }).observe(wrap);
    }
    update();
  </script>

  <style>
    .feed-page { padding-block: 2.2rem 3rem; }
    .feed-lede { max-width: 62ch; color: var(--ink-2); margin-top: .5rem; }
    .feed {
      list-style: none; margin: 0; padding: 0 0 0 1.15rem;
      border-left: 2px solid var(--rule);
    }
    .fev { position: relative; margin-bottom: 1.1rem; }
    .fev::before {
      content: ''; position: absolute; left: -1.55rem; top: .45rem;
      width: .5rem; height: .5rem; border-radius: 50%;
      background: var(--ink-3); border: 2px solid var(--bg);
    }
    .fev--change::before { background: var(--warn); }
    .fev--post::before { background: var(--accent); }
    .fev__time {
      display: flex; gap: .5rem; flex-wrap: wrap; align-items: baseline;
      font-family: var(--font-mono); font-size: .62rem; color: var(--ink-3);
      letter-spacing: .06em; text-transform: uppercase;
      margin-bottom: .3rem;
    }
    .fev__label { color: var(--ink-3); }
    .fev--change .fev__label { color: var(--warn); }
    .fev__card {
      border: 1px solid var(--rule); border-radius: var(--radius);
      background: var(--surface); padding: .8rem var(--inset-box);
    }
    .fev--change .fev__card { border-left: 3px solid var(--warn); }
    .fev__title { font-weight: 600; font-size: .98rem; }
    .fev__by { font-size: .76rem; color: var(--ink-3); margin: .15rem 0 0; }
    .fev__shot {
      margin-top: .6rem; border: 1px solid var(--rule); border-radius: var(--radius);
      overflow: hidden; max-height: 260px; background: var(--surface-2);
    }
    .fev__shot img { display: block; width: 100%; height: auto; }
    .fev__body {
      font-size: .85rem; color: var(--ink-2); margin: .5rem 0 0; line-height: 1.55;
    }
    .feed__more { text-align: center; margin-top: 1.5rem; }
    .feed__btn {
      font: inherit; font-size: .85rem;
      padding: .5rem 1.1rem;
      border: 1px solid var(--rule); border-radius: var(--radius);
      background: var(--surface); color: var(--ink); cursor: pointer;
    }
    .feed__btn:hover { border-color: var(--accent); color: var(--accent); }
    .feed__status {
      font-family: var(--font-mono); font-size: .62rem; color: var(--ink-3);
      letter-spacing: .06em; text-transform: uppercase; margin-top: .5rem;
    }
  </style>
</Base>
