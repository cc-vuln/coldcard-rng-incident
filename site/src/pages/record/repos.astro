---
import Article from '../../layouts/Article.astro';
import Answer from '../../components/Answer.astro';
import Claim from '../../components/Claim.astro';
import { sourceById, displayTitle, isoToHuman } from '../../lib/archive';

/*
 * Catalogue of code published around this incident, organised by safety rather
 * than by author or topic.
 *
 * The reason for that ordering: during a weak-key incident the dangerous
 * property of a repository is not whether its analysis is correct, it is what
 * the repository asks a reader to feed it. A tool that accepts a recovery
 * phrase is dangerous whether or not its author meant harm, because the reader
 * cannot audit the process that receives the words. So every entry states what
 * it takes as input before it states what it does, and the classification is
 * derived from the repository's own published description as held here.
 */

type Safety = 'no-material' | 'source-only';

const SAFETY_LABEL: Record<Safety, string> = {
  'no-material': 'Accepts no wallet material',
  'source-only': 'Reads source trees, not wallets',
};

interface Entry {
  id?: string;              // source-registry id, where one exists
  name: string;
  who: string;
  safety: Safety;
  input: string;            // what the code takes in
  what: string;             // what it does
  licence: string;
  caveat?: string;
}

/* Held here, and read before being described. */
const HELD: Entry[] = [
  {
    id: 'dk27ss-poc-readme',
    name: 'DK27ss/ColdCard-38M-PoC',
    who: 'anonymous author',
    safety: 'no-material',
    input: 'Nothing. It creates its own target.',
    what:
      'An end-to-end reproduction. It reimplements both generators, the ' +
      'MicroPython software fallback and the libngu mixer, fabricates its own ' +
      'synthetic victim wallet through the affected path, then recovers that ' +
      "wallet's mnemonic by searching the timer and skip space. Because the " +
      'target is generated by the repository itself, the demonstration is safe ' +
      'by construction: it runs offline, it never needs a real wallet, and ' +
      'there is no input field for recovery material because there is nothing ' +
      'for a reader to supply.',
    licence: 'No licence stated.',
    caveat:
      'The author is anonymous and the repository states no licence, so reuse ' +
      'terms are undefined. Its candidate-space and skip-model figures are the ' +
      "author's analysis and are not adopted here.",
  },
  {
    id: 'samsamskies-tracker-readme',
    name: 'SamSamskies/coldcard-hack-tracker',
    who: 'SamSamskies',
    safety: 'no-material',
    input: 'Public addresses it already holds, queried against public explorers.',
    what:
      'The published source behind the tracker dashboard this archive already ' +
      'tracks as a deployed page. Publishing it matters for a reason that is ' +
      'easy to miss: it converts an opaque third-party dashboard into ' +
      'something a reader can audit, so the watch set, the hop-following rules ' +
      'and the accounting can be checked rather than trusted. It reads public ' +
      'block-explorer APIs and takes no wallet material from the reader.',
    licence: 'MIT, with a test suite.',
    caveat:
      'Its watch set is hardcoded from public reports rather than derived ' +
      'independently, and querying any third-party tracker discloses that ' +
      'query to its operator and to network intermediaries.',
  },
  {
    id: 'nobuxpt-entropy-test-readme',
    name: 'nobuxpt/coldcard-entropy-test',
    who: 'nobuxpt',
    safety: 'source-only',
    input: 'A firmware source tree. Not a wallet, and not a seed.',
    what:
      'Two offline tools. A collision demonstration reproduces the reduced ' +
      'search space by generating seeds through a reimplementation of the ' +
      'affected chain and counting duplicates. A static scanner reads a ' +
      'firmware source directory and flags the defined-ness guard, reporting ' +
      'vulnerable, fixed or indeterminate. The distinction that matters is that ' +
      'the scanner examines source code, not a wallet: it answers a question ' +
      'about a build, not about your funds.',
    licence: 'ISC.',
    caveat:
      'Its README states that it does not contact the Bitcoin network, derive ' +
      'wallet balances or scan for funds. That is the ' +
      "repository's own description of itself, quoted rather than " +
      'independently audited here.',
  },
];

/* Already in the source registry before this catalogue existed. */
const TRACKED: { id: string; role: string }[] = [
  { id: 'libngu-random-c', role: 'The generator file at the centre of the defect, tracked for change.' },
  { id: 'libngu-pr-58', role: 'Incident-response proposal, open in every 1 August capture.' },
  { id: 'libngu-pr-59', role: 'Broad incident-response proposal; the maintainer called the diff too large and the author offered a split.' },
  { id: 'libngu-pr-60', role: 'Full-width reseeding proposal, closed by its author on 1 August. Was the companion to firmware PR #691, which now names libngu #61.' },
  { id: 'coldcard-firmware-pr-691', role: 'Removes the firmware-side four-byte truncation. A draft by the last 1 August capture; now depends on libngu PR #61.' },
  { id: 'coldcard-firmware-pr-689', role: 'Merged Mk3 hotfix behind release 4.2.0.' },
  { id: 'coldcard-firmware-pr-690', role: 'Merged Edge hotfix behind 6.6.0X and 6.6.0QX.' },
  { id: 'coldcard-firmware-mainline-hotfix', role: 'The mainline hotfix commit carried by the Mk4/Mk5 and Q releases.' },
  { id: 'threez-mk3-rng-disclosure', role: 'Binary reversal with a bounded synthetic proof; states it excludes enumeration and fund targeting.' },
  { id: 'kelbie-rng-postmortem', role: 'Chain-derived postmortem built from frozen chain data.' },
  { id: 'alvap-weak-rng-research', role: 'Re-derivation of fix commits and vulnerable versus patched symbols.' },
  { id: 'seedsigner-pr-962', role: 'Downstream hardening proposal, withdrawn by its author as unsound.' },
  { id: 'satsigner-pr-468', role: 'Downstream entropy audit of separate optional dice and coin paths.' },
  { id: 'bitcoinorg-pr-4905', role: "Merged removal of the COLDCARD listings under the site's published criterion." },
];

const tracked = TRACKED
  .map(({ id, role }) => {
    const src = sourceById(id);
    if (!src) return null;
    return {
      id,
      title: displayTitle(src),
      org: src.org ?? 'unattributed',
      role,
      when: src.published ? isoToHuman(src.published) : 'publication date not established',
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const held = HELD.map((e) => ({
  ...e,
  safetyLabel: SAFETY_LABEL[e.safety],
  href: e.id ? `/record/sources/${e.id}/` : null,
  when: e.id
    ? (sourceById(e.id)?.published ? isoToHuman(sourceById(e.id)!.published!) : 'publication date not established')
    : 'publication date not established',
}));
---

<Article
  title="Code published around this incident"
  description="A catalogue of repositories published around the July 2026 COLDCARD entropy incident, classified by what each one asks a reader to supply."
  standfirst="Every entry states what it takes as input before it states what it does, because during a weak-key incident that is the property that decides whether a repository is safe to run."
  depth="plain"
  kicker="Evidence"
  next={{ href: '/safety/scams/', label: 'Scams exploiting this incident', note: 'why a checker tool that asks for recovery material is hostile whatever its author intended' }}
>
  <Answer>
  <p>
    Three repositories are held here with their READMEs captured, and each is
    classified by what it asks the reader to supply rather than by who wrote it.
    Two accept no wallet material at all; the third reads a firmware source tree.
    Upstream files and the pull requests filed in response are listed separately,
    as source and patches rather than tools a reader runs. As of 2 August 2026 no
    malicious seed-checker was found in public code indexes, which is a dated
    observation and not an all-clear.
  </p>
  </Answer>

  <h2>Why the ordering is by safety</h2>

  <p>
    The question a reader arrives with is not who wrote something or whether its
    analysis is good. It is whether running the thing can cost them their coins,
    and that depends only on what the code asks for. A tool that asks for a
    recovery phrase is dangerous whether or not its author meant harm, because
    the reader cannot audit what happens to the words once they are typed, and
    because the same request is the single most reliable marker of the
    checker-tool scam described at
    <a href="/safety/scams/">risk 3 on the scams page</a>. So each entry leads
    with its input.
  </p>

  <h2>Held in this archive</h2>

  <p>
    Three repositories are held here with their READMEs captured. All three were
    read before being described, and each was checked against the same question:
    what does it require the reader to supply.
    <Claim
      basis="verified"
      scope="The stated inputs, licences and described behaviour of the three repositories held here"
      source="Each repository's own published README, as captured, read before being described; behaviour is quoted from the repository rather than independently audited"
      href="/record/"
      captured="2 Aug 2026"
    />
    <Claim
      basis="derived"
      scope="The safety classification given to each of the three repositories, under one rule: a repository is classified by what its own README says the reader must supply, and by nothing else"
      source="This project's judgement about third-party proof-of-concept code, applied to the captured READMEs. No artefact establishes it, and it is not an audit of what the code does when it is run"
      href="/record/"
      captured="2 Aug 2026"
    />
  </p>

  <div class="repos">
    {held.map((e) => (
      <article class="repo">
        <div class="repo__head">
          <h3 class="repo__name">{e.name}</h3>
          <a class="repo__link" href={e.href}>capture &rarr;</a>
        </div>
        <p class="repo__meta">{e.who} &middot; {e.when} &middot; {e.licence}</p>
        <p class:list={['repo__safety', `repo__safety--${e.safety}`]}>{e.safetyLabel}</p>
        <p class="repo__input"><strong>Input:</strong> {e.input}</p>
        <p class="repo__what">{e.what}</p>
        <p class="repo__caveat" hidden={!e.caveat}>{e.caveat}</p>
      </article>
    ))}
  </div>

  <h2>Already in the source register</h2>

  <p>
    Upstream code and the pull requests filed in response were tracked before
    this catalogue existed. They are listed here so that the code published
    around this incident can be seen in one place, with their individual capture
    records linked.
    <Claim
      basis="verified"
      scope="That the upstream files, pull requests and researcher repositories listed above are registered and captured"
      source="The source register, where each entry carries its own capture record and revision history"
      href="/record/"
    />
    Their inputs are not at issue: these are source files,
    patches and review threads rather than tools a reader runs.
  </p>

  <ul class="node-list">
    {tracked.map((t) => (
      <li>
        <a href={`/record/sources/${t.id}/`}>{t.title}</a>
        <span class="dim"> &middot; {t.org} &middot; {t.when}</span>
        <br /><span class="dim">{t.role}</span>
      </li>
    ))}
  </ul>

  <h2>Noted without recommendation</h2>

  <p>
    One repository has the shape this page is built to flag: its stated purpose
    is to accept dice input and produce wallet material, which is the input class
    that would make it worth examining closely. It is completely empty. There is
    no code, so there is nothing to examine and nothing to warn about beyond the
    fact that a stated purpose is not a published implementation. It is recorded
    so that its later appearance with content is a change rather than a
    discovery, and it is not linked, because linking an empty repository whose
    contents are unknown would be a recommendation this archive cannot support.
  </p>

  <p>
    Separately, forks of the proof-of-concept repositories were compared against
    their upstreams. As of 2 August 2026 none had diverged.
    <Claim
      basis="derived"
      scope="That the examined forks of the proof-of-concept repositories had not diverged from their upstreams as of 2 August 2026"
      source="Derived from comparing each fork against its upstream on that date. The comparison output is not published here, so this one cannot be rechecked from the archive, and forks created or modified afterwards are outside it"
      compact
    />
    A fork that adds an
    input field for recovery material to an otherwise safe reproduction is the
    realistic way this class of code turns hostile, so the comparison is
    recorded, along with its date, rather than left implicit.
  </p>

  <h2>The negative finding, and its limits</h2>

  <p>
    As of 3 August 2026, no malicious seed-checker was found in public code
    indexes.
    <Claim
      basis="unverified"
      scope="The absence of a malicious COLDCARD seed-checker in public code indexes as of 3 August 2026"
      source="A search of public code indexes on that date surfaced none; the search is not exhaustive, and a tool distributed outside code hosting would not appear in it"
    />
    That is a time-bounded observation and not an all-clear: it says
    nothing about tools hosted outside public code indexes, which is where a
    working phishing checker would rationally live, on a domain, behind an
    advertisement, in a message. The <a href="/safety/scams/">scams page</a>
    ranks that vector third for exactly that reason.
  </p>

  <div class="ve-card ve-card--red">
    <div class="ve-card__label lbl-red">The test that does not require trusting anyone</div>
    <p>
      Whether this incident affects you is answerable from the firmware version
      installed when the seed was generated and how that seed was created.
      Neither fact is secret. Any tool, repository or page that asks for a
      recovery phrase, a private key or an extended private key in order to
      answer that question is asking for material that cannot contribute to the
      answer, and is hostile by construction regardless of what its author
      intended. The reasoning is set out under
      <a href="/safety/scams/">risk 3 on the scams page</a>, and the safe path
      through seed handling is on
      <a href="/safety/seed-words/">seed-word safety</a>.
    </p>
  </div>
</Article>

<style>
  .repos { display: grid; gap: 1rem; margin-block: 1.8rem; }
  .repo {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--safe);
    border-radius: var(--radius);
    padding: 1.15rem var(--inset-box);
  }
  .repo__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .repo__name {
    font-size: 1rem; font-family: var(--font-mono); font-weight: 600;
    margin: 0; overflow-wrap: anywhere;
  }
  .repo__link {
    font-family: var(--font-mono); font-size: .66rem;
    letter-spacing: .1em; text-transform: uppercase; white-space: nowrap;
  }
  .repo__meta { font-size: .76rem; color: var(--ink-3); margin-top: .25rem; }
  .repo__safety {
    display: inline-block;
    font-family: var(--font-mono); font-size: .6rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase;
    border-radius: 999px; padding: .18rem .5rem; margin-top: .6rem;
  }
  .repo__safety--no-material { color: var(--safe); background: var(--safe-soft); }
  .repo__safety--source-only { color: var(--info); background: var(--info-soft); }
  .dim { color: var(--ink-3); font-size: .82rem; }
  .repo__input { font-size: .9rem; margin-top: .6rem; }
  .repo__what { font-size: .9rem; line-height: 1.65; margin-top: .5rem; }
  .repo__caveat {
    font-size: .82rem; line-height: 1.6; color: var(--ink-3);
    margin-top: .6rem; padding-top: .6rem; border-top: 1px solid var(--rule);
  }
</style>
