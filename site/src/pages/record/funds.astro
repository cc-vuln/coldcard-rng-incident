flowchart LR
  A["500 source addresses<br/>594.51379184 BTC gross"] --&gt; B["first collector<br/>594.47722484 BTC"]
  B --&gt; C["largest final holding<br/>plus retained remainder"]
  D["695 attributed source transactions<br/>488.13939738 BTC gross"] --&gt; E["three first collectors<br/>488.10957948 BTC"]
  D -. "same-operator attribution" .-&gt; A
  E --&gt; F["two batch consolidations"]
  C --&gt; G["four final holdings<br/>1,082.56919591 BTC theft-linked"]
  F --&gt; G
    </pre>
