---
import Article from '../../layouts/Article.astro';
import Claim from '../../components/Claim.astro';
import Disclosure from '../../components/Disclosure.astro';
import Answer from '../../components/Answer.astro';
import CorrectionNotice from '../../components/CorrectionNotice.astro';
import FigureFundsFlow from '../../components/figures/FigureFundsFlow.astro';
import { fig } from '../../lib/figures';
import {
  hackTrackerMovementAt,
  trackerReadings,
  trackerRange,
} from '../../lib/trackers';

/*
 * The three community trackers' headline totals are read out of this archive's
 * own captures rather than typed in, because they restate them continuously
 * and a typed figure is only right on the day it is typed. lib/trackers.ts
 * carries what each reading came from and whether the source is still
 * answering; this page states both beside every figure. See the note in that
 * file for what happens when a tracker rebuilds its page.
 */
const readings = trackerReadings();
const range = trackerRange(readings);
const byId = Object.fromEntries(readings.map((r) => [r.id, r]));
const watch = byId['coldcard-watch'];
const rip = byId['coldcard-rip-tracker'];
const hack = byId['coldcard-hack-tracker'];
const movementStart = hackTrackerMovementAt('20260804T030519Z');
const movementEnd = hackTrackerMovementAt('20260807T132028Z');

/*
 * The KPI cards show the bare number beside a <sup>BTC</sup>, while fig()
 * carries the unit for prose. Derived here so the cards and the prose share
 * the single figures.ts source rather than typing the number twice.
 */
const galaxyConfirmedNum = fig('galaxyConfirmedBtc').replace(/\s*BTC$/, '').trim();
const galaxyInclWave4Num = fig('galaxyInclWave4Btc').replace(/\s*BTC$/, '').trim();

/*
 * What each tracker counts, which is editorial and does not come from the
 * capture. Kept to one scannable clause: the dates, health and figure beside
 * it are fields, not prose, and the source page carries the full description.
 */
const SCOPE_NOTE: Record<string, string> = {
  'coldcard-watch': 'Self-described verified floor, drains of 30 and 31 Jul',
  'coldcard-rip-tracker': 'Ten block-indexed waves, AI-compiled',
  'coldcard-hack-tracker': 'Known waves only, includes a likely wave 4',
};

/*
 * Each card carries up to four fields under the figure. Rows are built here
 * rather than in the template because two of them are conditional, and a
 * conditional returning markup breaks the Astro expression parser.
 */
const cards = readings.map((reading, i) => {
  const rows: { term: string; value: string; flag: boolean }[] = [
    { term: 'Read', value: reading.readAtShort, flag: false },
  ];
  if (reading.hasHeld) {
    // "since" rides in the value: the term column is sized by its longest
    // entry, and a long term squeezes every value in the card against it.
    rows.push({ term: 'Unchanged', value: `since ${reading.heldSinceShort}`, flag: false });
  }
  if (reading.stateShort) {
    rows.push({ term: 'Reading', value: reading.stateShort, flag: true });
  }
  if (reading.healthShort) {
    rows.push({ term: 'Source', value: reading.healthShort, flag: true });
  }
  return {
    ...reading,
    style: `--i:${i}`,
    counts: reading.addresses
      ? `${SCOPE_NOTE[reading.id]}, ${reading.addresses} addresses`
      : SCOPE_NOTE[reading.id],
    rows,
  };
});
---

<Article
  title="Funds accounting"
  description="Current headline totals from Galaxy Research and the community trackers, when each figure last changed, and the published figures for the 30 July transaction sets attributed to the COLDCARD incident."
  standfirst="The headline totals have been revised repeatedly as the attributed set has widened, and different sources count different sets. This page keeps each source's current number, when it last moved, and what it measures."
  depth="plain"
  kicker="The record"
  next={{
    href: '/record/',
    label: 'Sources',
    note: 'Inspect the registered sources, held captures and revision histories.',
  }}
>
  <Answer>
  <p>
    Different sources now report different totals because they count different
    sets, and Galaxy's top line moved three times between 31 July and
    3 August. Galaxy
    Research puts confirmed losses at
    {fig('galaxyConfirmedBtc')} from {fig('galaxyConfirmedAddresses')} as of
    3 August, rising to {fig('galaxyInclWave4Btc')} if a suspected fourth wave
    is confirmed. The three community trackers stood at {range.low} to
    {range.high} BTC when this archive last read them, depending on what they
    count. Every figure below keeps its source, the set it counts and the date
    it was stated; superseded figures live in the register further down, not in
    the headline numbers.
  </p>
  </Answer>

  <CorrectionNotice page="/record/funds/" />

  <div class="kpi-row">
    <div class="kpi-card" style="--i:0">
      <div class="kpi-card__value" style="color:var(--red)"><span>{galaxyConfirmedNum}</span><sup>BTC</sup></div>
      <div class="kpi-card__label">Galaxy's confirmed total, 3 Aug</div>
      <div class="kpi-card__note">High confidence, from about 7,300 addresses across three confirmed waves plus 14 smaller incidents, stated as exceeding US$100M. Galaxy's third top-line figure in four days: {fig('galaxyGrossBtc')} on 31 Jul, {fig('galaxyRevisedTotalBtc')} on 1 Aug.</div>
    </div>
    <div class="kpi-card" style="--i:1">
      <div class="kpi-card__value" style="color:var(--amber)"><span>{galaxyInclWave4Num}</span><sup>BTC</sup></div>
      <div class="kpi-card__label">Galaxy including suspected wave 4</div>
      <div class="kpi-card__note">Stated as about US$130m. Not promoted into Galaxy's top line: no victim has confirmed a wave-4 loss, and Galaxy does not itemise the wave-4 component.</div>
    </div>
  </div>

  <div class="kpi-row">
    {cards.map((card) => (
      <div class="kpi-card" style={card.style} data-tracker={card.id} data-tracker-state={card.state}>
        <div class="kpi-card__value"><span>{card.btcRounded}</span><sup>BTC</sup></div>
        <div class="kpi-card__label">
          <a href={card.href}>{card.label}</a> · {card.by}
          <span class={`status status--${card.liveness.tone} kpi-live`}>{card.liveness.label}</span>
        </div>
        <dl class="kpi-meta">
          {card.rows.map((row) => (
            <div class="kpi-meta__row" data-flag={String(row.flag)}>
              <dt>{row.term}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
        <div class="kpi-card__note">{card.counts}</div>
      </div>
    ))}
  </div>

  <p class="cap">
    The cards measure different sets, not competing measurements of one set.
    Each tracker figure is read out of the copy this archive holds, and says
    which capture it came from, when the figure last moved, and whether the
    tracker is still answering. They are readings of a held copy rather than
    live balances: a tracker moves between captures, and this page moves only
    when it is rebuilt.
    <Claim
      basis="verified"
      scope="That each tracker figure above matches the capture named beside it, and the capture and health times stated"
      source="Read at build time from the held snapshots for coldcard-watch, coldcard.rip and coldcard-hack-tracker, and from this archive's own poll record"
      href="/record/changes/"
    />
  </p>

  <h2 id="headline-numbers">The headline numbers, and when they last moved</h2>

  <p>
    Each row is the figure a source currently stands behind, with the set it
    counts and the time it was stated or captured. The full register, including
    superseded figures and press restatements, is
    <a href="#estimate-register">further down</a>.
  </p>

  <div class="table-wrap">
    <div class="table-scroll">
      <table class="data-table sortable">
        <caption>Current headline totals by source, with scope and update time
          <Claim
            basis="reported"
            scope="The five headline figures in the table, their scopes, and the captures each tracker figure was read from"
            source="Galaxy Research's captured 3 August thread, and the tracker figures read at build time from the captures named in each row"
            href="/record/sources/glxy-losses-exceed-100m/"
          />
        </caption>
        <thead>
          <tr>
            <th scope="col" class="nw">Source</th>
            <th scope="col" class="nw">Figure</th>
            <th scope="col" class="wide">What it counts</th>
            <th scope="col" class="wide">Stated</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="nw"><strong><a href="/record/sources/glxy-losses-exceed-100m/">Galaxy Research</a></strong><small>confirmed</small></td>
            <td class="nw" data-sort="1596">{fig('galaxyConfirmedBtc')}<small>exceeds US$100M</small></td>
            <td class="wide">Three confirmed waves plus 14 smaller incidents, {fig('galaxyConfirmedAddresses')}; confirmed through victim reports</td>
            <td class="wide" data-sort="20260803225139">Published 3 Aug, 22:51 UTC. Third top line in four days: {fig('galaxyGrossBtc')} on 31 Jul, {fig('galaxyRevisedTotalBtc')} on 1 Aug.</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href="/record/sources/glxy-wave4-caveat/">Galaxy Research</a></strong><small>incl. suspected wave 4</small></td>
            <td class="nw" data-sort="2055">{fig('galaxyInclWave4Btc')}<small>~US$130m</small></td>
            <td class="wide">The confirmed set plus a pattern-matched fourth wave that no victim has confirmed; Galaxy has not promoted it into its top line</td>
            <td class="wide" data-sort="20260803225141">Published 3 Aug, 22:51 UTC, same thread.</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={hack.href}>coldcard-hack-tracker</a></strong><small>SamSamskies' tracker</small></td>
            <td class="nw" data-sort={hack.btcSort}>{hack.btc} BTC</td>
            <td class="wide">{hack.detail}, 30 Jul to 3 Aug, including a likely wave 4 carried at 443.34 BTC; self-described as a floor</td>
            <td class="wide" data-sort={hack.readAt}>{hack.provenance} History below.</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={rip.href}>coldcard.rip</a></strong><small>Kevin Kelbie's tracker</small></td>
            <td class="nw" data-sort={rip.btcSort}>{rip.btc} BTC<small>from {rip.addresses} addresses</small></td>
            <td class="wide">Ten block-indexed waves, 30 Jul to 3 Aug; {rip.detail}. The page self-describes as AI-compiled, not independently fact-checked</td>
            <td class="wide" data-sort={rip.readAt}>Successor to the railway deployment Kelbie announced on 2 Aug. {rip.provenance}</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={watch.href}>coldcard-watch</a></strong><small>anonymous tracker</small></td>
            <td class="nw" data-sort={watch.btcSort}>{watch.btc} BTC<small>{watch.addresses} addresses</small></td>
            <td class="wide">Self-described verified minimums over the drain window it gives as 30 and 31 Jul: a floor. Since 7 Aug the page splits its view into Verified, Attested and Suspected, and the figure here is the verified one</td>
            <td class="wide" data-sort={watch.readAt}>Anonymously operated. Moved from coldcard-watch.vercel.app to coldcardwatch.com on 3 to 4 Aug, and renamed itself from Coldcard Sweep Watch to Coldcard Watch on 7 Aug. {watch.provenance}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <p>
    The spread is explained by scope, not by one source being right and another
    wrong. The trackers count overlapping but different wave sets at different
    times, Galaxy states that its confirmed total rests on victim reports, and
    the trackers publish their own pattern criteria. The 45.9 BTC cluster
    first reported on 31 July is now carried as one wave of ten on Kelbie's
    own tracker.
  </p>

  <h2 id="principal-figures">What the 30 July figures measure</h2>

  <p>
    TFTC reproduced the visible chain event and publishes the net value
    received by one first collector: 594.47722484 BTC across the
    500-transaction set. It explicitly limits its statement to the visible
    chain event and does not claim that every transaction came from this
    firmware flaw.
    <Claim
      basis="reported"
      scope="TFTC's published 500-transaction set and first-collector receipt, and its stated limit on cause"
      source="TFTC's captured report, 31 Jul 2026"
      href="/record/sources/tftc-who-must-move/"
    />
  </p>

  <p>
    <a href="https://x.com/Rob1Ham/status/2082896614218203616" rel="noopener nofollow">Rob Hamilton's preliminary post</a>
    reported the same 1,324 UTXOs, 500 transactions and approximately 594.48 BTC,
    followed by a consolidation of about 562 BTC. It described a "3 block
    window", while the transactions are confirmed across four blocks. The block
    timestamps run from 01:36:08 to 01:51:26 UTC, a span of 15 minutes 18
    seconds, consistent with Hamilton's separate description of an approximately
    15-minute period. Hamilton also reported that all addresses in the
    500-transaction set used single-signature spending conditions, none used
    Taproot, and the spent UTXOs dated from 2021 to 2026: properties of the
    observed outputs and spending scripts, not proof of each owner's wallet
    configuration or seed creation date.
    <Claim
      basis="reported"
      scope="Hamilton's published preliminary figures and output-type observations"
      source="Rob Hamilton primary post, captured 1 Aug 2026"
      href="/record/sources/robhamilton-preliminary-sweep/"
    />
  </p>

  <p>
    In Galaxy's flow-of-funds mapping, the first collector consolidates into
    the largest final holding while retaining a remainder, and the
    695-transaction set Block reported passes through three first collectors
    and two batch consolidations before reaching the same four holdings. A
    single first collector and four final holdings are therefore successive
    stages of the flows, not competing descriptions of one stage.
    <Claim
      basis="reported"
      scope="The flow stages: one first collector into the largest holding with a retained remainder for the 500-transaction set, and three first collectors with two batch consolidations for the 695-transaction set"
      source="Galaxy Research's captured 31 July flow-of-funds post and Block's captured preliminary thread"
      href="/record/sources/glxyresearch-flow-map/"
    />
  </p>

  <Disclosure id="galaxy-attribution" title="Galaxy's 31 July attribution, the 30 July set" note="1,196 addresses, 1,082.65 BTC; superseded twice as Galaxy's top line">

  <p>
    <a href="https://x.com/glxyresearch/status/2083181683067506899" rel="noopener nofollow">Galaxy Research reported 1,196 addresses and {fig('galaxyGrossBtc')}</a>
    from 01:10:20 to 01:51:26 UTC on 30 July, across blocks 960,183 to 960,191.
    It attributed the wider set to one operator using the transaction pattern
    identified by Block. Galaxy also published a derivation-path count of 1,183
    BIP-84, 7 BIP-49 and 6 BIP-44 addresses.
    <Claim
      basis="reported"
      scope="Galaxy's published address count, gross BTC total, time window, derivation-path counts and transaction-pattern description"
      source="Galaxy Research primary post, captured 1 Aug 2026"
      href="/record/sources/glxyresearch-flow-map/"
    />
    This remains Galaxy's figure for the 30 July waves. Its top line has moved
    twice since, on 1 August and again on 3 August;
    <a href="#galaxy-revision">both revisions are recorded next</a>.
  </p>

  <blockquote>
    Galaxy described the repeated target as a "hardcoded 30.0 sat/vB" fee rate
    with no change output.
    <cite><a href="https://x.com/glxyresearch/status/2083181683067506899" rel="noopener nofollow">Galaxy Research, X, 31 Jul 2026</a></cite>
  </blockquote>

  <p>
    Galaxy does not publish the underlying transaction list or its
    address-counting method, so the 1,196-address set cannot be rechecked
    address by address from the post alone. On-chain output types do not
    independently reveal wallet derivation paths, so the BIP-84, BIP-49 and
    BIP-44 counts remain Galaxy's reported classification.
  </p>

  <FigureFundsFlow />

  </Disclosure>

  <h2 id="galaxy-revision">Galaxy's revisions: 1 August, then 3 August</h2>

  <p>
    At 18:38 UTC on 1 August 2026,
    <a href="/record/sources/glxyresearch-third-wave-revision/">Galaxy Research reported a third sweep wave</a>
    of {fig('thirdWaveBtc')} and revised its estimated observed size of the
    incident to {fig('galaxyRevisedTotalBtc')}, stated as approximately
    US$88.6m, across {fig('galaxyRevisedAddresses')}.
    <Claim
      basis="reported"
      scope="Galaxy's third wave, its revised total and address count, and the method limit it states for them"
      source="Galaxy Research's captured 1 August thread; the revised totals are Galaxy's attributed estimate and the underlying transaction and address lists are not published"
      href="/record/sources/glxyresearch-third-wave-revision/"
    />
    That superseded the
    1,082.65 BTC total Galaxy published on 31 July, which remains Galaxy's
    figure for the 30 July waves above. The two are different scopes rather than
    alternative measurements of one set: Galaxy's spans three waves, including a
    third wave for which Galaxy has not published a transaction list, so the totals should not
    be added or read against each other.
  </p>

  <p>
    At 22:51 UTC on 3 August,
    <a href="/record/sources/glxy-losses-exceed-100m/">Galaxy revised its top line again</a>:
    high-confidence {fig('galaxyConfirmedBtc')} stolen from
    {fig('galaxyConfirmedAddresses')} across three confirmed waves plus 14
    smaller incidents, stated as exceeding US$100M. The basis changed with the
    number. Wave 1, first observed by Block's engineers, is now fully confirmed
    through victim reports; waves 2 and 3 were discovered through victim
    reports, with confirmations continuing; and 73 individual victims have
    contacted Galaxy's @intangiblecoins for help tracing their coins.
    <Claim
      basis="reported"
      scope="Galaxy's 3 August confirmed total and address count, its wave-confirmation basis, and the 73-victim figure"
      source="Galaxy Research's captured 3 August thread; the underlying transaction and address lists are not published"
      href="/record/sources/glxy-wave-attribution/"
    />
    The 14 smaller footprints, identified with help from victim reports,
    <a href="/record/sources/glxy-victim-count/">"could be many different attackers individually exploiting the now-known vulnerability"</a>,
    so the confirmed total is no longer a one-operator claim.
  </p>

  <p>
    Including the suspected fourth wave would bring Galaxy's total to
    {fig('galaxyInclWave4Btc')}, stated as approximately US$130m. Galaxy
    believes with medium-high confidence that wave 4 is substantially comprised
    of an attacker, but has not promoted it into the top-line numbers because
    no victim has confirmed inclusion.
    <Claim
      basis="reported"
      scope="Galaxy's 2,055 BTC figure including the suspected fourth wave, its confidence statement and its reason for not promoting the wave"
      source="Galaxy Research's captured 3 August thread; Galaxy does not itemise the wave-4 component of the 2,055 BTC total"
      href="/record/sources/glxy-wave4-caveat/"
    />
    The wave-4 material itself, circulated and twice corrected by
    @intangiblecoins before Galaxy's statement, is
    <a href="#wave-4">recorded below</a>.
  </p>

  <p>
    The same thread states that 90 percent of stolen coins have not moved and
    100 percent of coins in waves 1 to 3 have not moved, and that Galaxy has
    been providing confirmed attacker and victim addresses to US federal law
    enforcement, exchanges, and compliance and cyber-investigation firms.
    <Claim
      basis="reported"
      scope="Galaxy's statements that 90 percent of stolen coins and 100 percent of waves 1 to 3 coins have not moved, and that addresses were provided to law enforcement, exchanges and compliance firms"
      source="Galaxy Research's captured 3 August thread; the endpoint address sets are not published, so the unmoved findings are not independently checked here"
      href="/record/sources/glxy-law-enforcement-handoff/"
    />
    This supersedes Galaxy's 1 August statement of {fig('attackerHoldingsBtc')}
    under attacker control with every endpoint address fully unspent, and the
    four holdings Galaxy published for the 30 July waves, listed below, fall
    inside the waves Galaxy describes as unmoved. Galaxy's statement is fixed
    to 3 August: a community tracker has since recorded a spend on 7 August
    from a wave 2 collector address inside that set, which is
    <a href="#holdings-check">recorded with the holdings below</a>. It also states
    that <a href="/record/sources/glxy-attack-ongoing/">the attack is ongoing</a>,
    which is outside this accounting page and remains preserved in the linked
    source record.
  </p>

  <p>
    Galaxy states its own method limit, first published with the 1 August
    revision. It bounds every Galaxy figure quoted on this page and is the
    first thing to read beside any of them, not a footnote.
  </p>

  <blockquote>
    The data "is derived solely from analyzing Bitcoin block data and the
    unspent-output set". Galaxy has "not utilized compute to test whether the
    addresses we have identified as possible victims were indeed generated with
    low entropy", and calls the work its best effort on short notice, which
    "should not be considered to be complete or definitive".
    <cite><a href="/record/sources/glxyresearch-methodology-disclaimer/">Galaxy Research, X, 1 Aug 2026</a></cite>
  </blockquote>

  <p>
    The 1 August thread also states that the vulnerable firmware shipped on 17
    March 2021 around block 674,951, and that no coin identified in waves 1 to
    3 was created before that block.
    <Claim
      basis="reported"
      scope="Galaxy's statement about the firmware ship date, block 674,951 and the creation dates of the coins it identified"
      source="Galaxy Research's captured 1 August thread; what the boundary means for published version ranges is set out on the firmware page"
      href="/record/sources/glxyresearch-firmware-block-boundary/"
    />
    That bears on the affected firmware range rather
    than on the accounting here, and is
    <a href="/record/firmware/">taken up on the firmware page</a>.
  </p>

  <Disclosure id="estimate-register" title="The estimate register" note="every published total, what it measures, when it moved">

  <p>
    This register preserves the estimate as each source stated it, newest
    first. "Copy held" means the archive has a captured version that can be
    checked for later changes. The press rows mostly restate the primary
    accountings rather than add independent analysis.
  </p>

  <div class="table-wrap">
    <div class="table-scroll">
      <table class="data-table sortable">
        <caption>Published BTC and USD estimate register
          <Claim
            basis="reported"
            scope="The BTC and USD estimates in the source register above"
            source="Estimates as published by each source; USD figures use each source's conversion at its publication time"
            href="/record/reference/#analysis"
          />
        </caption>
        <thead>
          <tr>
            <th scope="col" class="nw">Source</th>
            <th scope="col" class="nw">Estimate</th>
            <th scope="col" class="nw">What it counts</th>
            <th scope="col" class="nw">Tracked</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="nw"><strong><a href="/record/sources/glxy-losses-exceed-100m/">Galaxy Research</a></strong><small>X, 3 Aug 2026</small></td>
            <td class="nw" data-sort="1596">{fig('galaxyConfirmedBtc')} confirmed<small>exceeds US$100M; {fig('galaxyInclWave4Btc')} with suspected wave 4</small></td>
            <td class="nw">Three confirmed waves plus 14 smaller incidents across {fig('galaxyConfirmedAddresses')}; the {fig('galaxyInclWave4Btc')} form is not promoted for lack of victim confirmation</td>
            <td class="nw"><a href="/record/sources/glxy-losses-exceed-100m/">primary thread</a>, copy held; supersedes the 1 Aug row below</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href="/record/sources/lookonchain-galaxy-2055-btc/">Lookonchain</a></strong><small>X, 4 Aug 2026</small></td>
            <td class="nw" data-sort="2055">{fig('galaxyInclWave4Btc')}<small>$130M; over 7,700 victim addresses</small></td>
            <td class="nw">Relays Galaxy's unpromoted including-wave-4 figure as the headline total</td>
            <td class="nw"><a href="/record/sources/lookonchain-galaxy-2055-btc/">copy held</a>; a relay, not independent analysis</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={hack.href}>coldcard-hack-tracker</a></strong><small>SamSamskies · capture of {hack.readAtShort}</small></td>
            <td class="nw" data-sort={hack.btcSort}>{hack.btc} BTC</td>
            <td class="nw">{hack.detail}, 30 Jul to 3 Aug, including a likely wave 4 at 443.34 BTC; self-described floor</td>
            <td class="nw"><a href={hack.href}>copy held</a>; unchanged since {hack.heldSinceShort}, and the live page moves often</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={rip.href}>coldcard.rip</a></strong><small>Kevin Kelbie · capture of {rip.readAtShort}</small></td>
            <td class="nw" data-sort={rip.btcSort}>{rip.btc} BTC swept<small>{rip.detail}</small></td>
            <td class="nw">Ten block-indexed waves from {rip.addresses} swept addresses; self-described as AI-compiled, not independently fact-checked</td>
            <td class="nw"><a href={rip.href}>copy held</a>; supersedes Kelbie's 2 Aug post below</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href={watch.href}>coldcard-watch</a></strong><small>anonymous · capture of {watch.readAtShort}</small></td>
            <td class="nw" data-sort={watch.btcSort}>{watch.btc} BTC</td>
            <td class="nw">Self-described verified minimums across {watch.addresses} addresses drained on 30 and 31 Jul; the verified one of the three views the page split out on 7 Aug</td>
            <td class="nw"><a href={watch.href}>copy held</a>; moved to coldcardwatch.com, and first read at this figure in the capture of {watch.heldSinceShort}</td>
          </tr>
          <tr>
            <td class="nw"><strong><a href="/record/sources/intangiblecoins-wave4-announcement/">@intangiblecoins wave 4</a></strong><small>X and Pastebin, 3 Aug 2026</small></td>
            <td class="nw" data-sort="448.73">448.73 BTC stated surviving core<small>486.11 BTC as circulated</small></td>
            <td class="nw">A circulated fourth-wave set, stated at 709 addresses after two corrections; pattern-matched, with no direct victim confirmation reported</td>
