            <Timestamp iso={e.whenIso} hidden={!e.whenIso} />
            <span hidden={Boolean(e.whenIso)}>{e.when}</span>
            &middot; {e.licence}
          </p>
          <p class:list={['repo__safety', `repo__safety--${e.safety}`]}>{e.safetyLabel}</p>
