  { id: 'libngu-random-c', role: 'The generator file at the centre of the defect, tracked for change.' },
  { id: 'libngu-pr-58', role: 'Incident-response proposal, open in every 1 August capture.' },
  { id: 'libngu-pr-59', role: 'Broad incident-response proposal; the maintainer called the diff too large and the author offered a split.' },
  { id: 'libngu-pr-60', role: 'Full-width reseeding proposal, closed by its author on 1 August. Was the companion to firmware PR #691, which now names libngu #61.' },
  { id: 'coldcard-firmware-pr-691', role: 'Removes the firmware-side four-byte truncation. A draft by the last 1 August capture; now depends on libngu PR #61.' },
  { id: 'coldcard-firmware-pr-689', role: 'Merged Mk3 hotfix behind release 4.2.0.' },
  { id: 'coldcard-firmware-pr-690', role: 'Merged Edge hotfix behind 6.6.0X and 6.6.0QX.' },
  { id: 'coldcard-firmware-mainline-hotfix', role: 'The mainline hotfix commit carried by the Mk4/Mk5 and Q releases.' },
  { id: 'threez-mk3-rng-disclosure', role: 'Binary reversal with a bounded synthetic proof; states it excludes enumeration and fund targeting.' },
  { id: 'kelbie-rng-postmortem', role: 'Chain-derived postmortem built from frozen chain data.' },
  { id: 'alvap-weak-rng-research', role: 'Re-derivation of fix commits and vulnerable versus patched symbols.' },
  { id: 'seedsigner-pr-962', role: 'Downstream hardening proposal, withdrawn by its author as unsound.' },
  { id: 'satsigner-pr-468', role: 'Downstream entropy audit of separate optional dice and coin paths.' },
  { id: 'bitcoinorg-pr-4905', role: "Merged removal of the COLDCARD listings under the site's published criterion." },
];

const tracked = TRACKED
  .map(({ id, role }) => {
    const src = sourceById(id);
    if (!src) return null;
    return {
      id,
      title: displayTitle(src),
      org: src.org ?? 'unattributed',
      role,
      when: src.published ? isoToHuman(src.published) : 'publication date not established',
      whenIso: src.published ?? '',
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const held = HELD.map((e) => ({
  ...e,
  safetyLabel: SAFETY_LABEL[e.safety],
  href: e.id ? `/record/sources/${e.id}/` : null,
  whenIso: e.id ? (sourceById(e.id)?.published ?? '') : '',
  when: e.id
    ? (sourceById(e.id)?.published ? isoToHuman(sourceById(e.id)!.published!) : 'publication date not established')
    : 'publication date not established',
}));

---

<Article
  title="Reference"
  description="Who did the primary analysis of the COLDCARD incident, and what code was published around it."
  standfirst="The research behind this site's claims: who found what, grouped by the kind of finding they made, and the code published around the incident, classified by what it asks a reader to supply."
  depth="plain"
  kicker="The record / reference"
  next={{
    href: '/record/timeline/',
    label: 'Timeline',
    note: 'Return to the incident chronology and its dated evidence.',
  }}
>
  <section id="analysis">
    <h2>Primary analysis</h2>

    <Answer>
    <p>
      Original analysis and reporting that restates it are different things, and
      this register covers only the first: {primaryCount} contributions, grouped
      by the kind of finding they made. Each entry names who published it,
      what it added to the public record, what has been checked here, and what
      remains that source's assumption. The candidate-space estimates below
      differ because their authors assume different attacker knowledge; none is
      a measured population-wide search cost.
    </p>
    </Answer>

    <p>
      An entry is listed here when it introduced something no earlier source had,
      and the {primaryGroups.length} groups below are the kinds of thing it could
      introduce: a source or binary reading, a candidate-space model, a
      reproduction, a chain derivation or attribution, or a prior-warning
      account. Restatement belongs on the <a href="/record/">source list</a>
      instead. One contributor holds one entry per group, carrying every artefact
      behind that contribution, so a body of work that was revised reads as a
      revision rather than as several independent findings. Inclusion records
      provenance rather than endorsement; each date is the registered first
      publication, not the capture, and entries run oldest first within a group.
      <Claim
        basis="reported"
        scope="The attributed contributions, models and evidentiary limits in the primary-analysis register below"
        source="Original technical reports, researcher posts and captured publications linked from each entry"
        href="/record/"
        compact
      />
      <Claim
        basis="derived"
        scope="The grouping of the register entries below by kind of finding, and the merging of one contributor's artefacts into a single entry per kind"
        source="This project's editorial arrangement of the register. It sorts and consolidates the entries below; it does not alter what any source published, and every artefact remains separately linked and dated from its entry"
        href="/record/"
        compact
      />
    </p>

    <p>
      The candidate-space estimates grouped below apply different assumptions
      about what a remote attacker knows at the moment of generation. Each
      assumption is written out beside its number on the
      <a href="/how-it-broke/entropy/">attack-cost page</a>, and they should not be
      combined without carrying those assumptions with them.
      <Claim
        basis="reported"
        scope="The differing Mk4-class candidate-space figures attributed below to Coinkite, LLFOURN, Talip and Block"
        source="Each publisher's own stated estimate and assumptions, as captured; no independent measurement of a device is made here"
        href="/how-it-broke/entropy/"
      />
    </p>

    {primaryGroups.map((group) => (
      <div class="reg-group" id={`analysis-${group.id}`}>
        <h3 class="reg-group__title">{group.title}</h3>
        <p class="reg-group__blurb">{group.blurb}</p>

        <div class="reg">
          {group.entries.map((p) => (
            <article class="reg__item">
              <div class="reg__head">
                <h4 class="reg__who">{p.who}</h4>
                <a class="reg__link" href={p.links[0].href} rel={p.links[0].rel} hidden={p.multi}>evidence &rarr;</a>
              </div>
              <p class="reg__what">{p.what}</p>
              <p class="reg__when">
                <Timestamp iso={p.whenIso} hidden={!p.whenIso} />
                <span hidden={Boolean(p.whenIso)}>{p.when}</span>
              </p>
              <p class="reg__detail" set:html={p.detail} />
              <CaptureThumb id={p.thumbId} />
              <ul class="reg__ev" hidden={!p.multi}>
                {p.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.rel}>{l.label}</a>
                    <span class="reg__ev-when">
                      <Timestamp iso={l.iso} hidden={!l.iso} />
                      <span hidden={Boolean(l.iso)}>{l.label === '' ? '' : 'date not established'}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <p class="reg__status">{p.status}</p>
              <p class="reg__scope">{p.scope}</p>
            </article>
          ))}
        </div>
      </div>
    ))}

    <p>
      One further weak-key incident is kept beside this register as context
      rather than inside it. The
      <a href="https://milksad.info/disclosure.html" rel="noopener nofollow">Milk Sad disclosure</a>
      records a separate weak-key failure with a public disclosure and an attempt
      to account for affected funds. It is a different generator, a different
      affected population and a different disclosure process, so it is precedent
      for how such an incident is handled, not evidence about COLDCARD.
      <Claim
        basis="verified"
        scope="That the Milk Sad disclosure is a separate published weak-key incident with its own disclosure and funds accounting, retained here as context"
        source="The Milk Sad disclosure itself; no claim about COLDCARD is drawn from it"
        href="https://milksad.info/disclosure.html"
        compact
      />
    </p>

    {/*
      Three subsections stood here and none of them earned the space.

      "Community trackers" hand-listed four registry entries. Three are chain
      monitors whose headline totals /record/funds/ reads live out of the
      archive, with the capture they came from and whether the source still
      answers; the fourth is the honeypot experiment, which now has its own
      register card above. A typed list of the same four is a second, staler
      copy of both. What was worth keeping is the query-disclosure warning,
      which appears nowhere else, so it survives as the sentence below.

      "Who is, and is not, investigating" opened by restating Galaxy's sharing
      statement, which the merged Galaxy card now carries a few hundred pixels
      above it. Only the ZachXBT declination was unique, and it does not need
      a heading of its own.

      "Registered posts" and the corrections card were both pointers to other
      pages wearing the costume of content. They are one clause each now.
    */}
    <p>
      Beyond this register, {posts.length} social posts are registered with
      their own evidence records, on
      <a href="/record/#registered-posts">the registered-post wall</a>, and the
      chain monitors' current totals are read live out of the archive on
      <a href="/record/funds/">the funds page</a>. Those trackers are
      independent of this archive, their figures and methods can change, and
      entering an address into any third-party site discloses that query to its
      operator and to network intermediaries. Registry descriptions do not
      convert a reported claim into a verified one, and where this register has
      been wrong the <a href="/about/#editorial-standards">corrections
      process</a> records the change: one entry was corrected after timestamps
      showed private-submission advice attributed to the wrong person.
    </p>

    <p>
      One absence belongs beside the register. ZachXBT stated that he has no
      plans to monitor or trace the incident, citing where his donor support
      comes from. It is recorded as made and not adjudicated here.
      <Claim
        basis="reported"
        scope="ZachXBT's statement that he has no plans to monitor or trace the incident, and his stated reason"
        source="ZachXBT's captured post of 2 Aug 2026"
        href="/record/sources/zachxbt-declines-tracing/"
        compact
      />
    </p>
  </section>

  <section id="code">
    <h2>Published code</h2>

    <Answer>
    <p>
      {held.length} repositories are held here with their READMEs captured, and each is
      classified by what it asks the reader to supply rather than by who wrote it.
      Two accept no wallet material at all; the third reads a firmware source tree.
      Upstream files and the pull requests filed in response are listed separately,
      as source and patches rather than tools a reader runs. As of 5 August 2026 no
      malicious seed-checker was found in public code indexes, which is a dated
      observation and not an all-clear.
    </p>
    </Answer>

    <h3>Held in this archive</h3>

    <p>
      Each entry leads with the input its README asks for, which keeps a
      repository that accepts no wallet material distinct from one whose stated
      operation would require it, without treating authorship or technical
      quality as a substitute for examining the interface. All {held.length} were
      read before being described.
      <Claim
        basis="verified"
        scope="The stated inputs, licences and described behaviour of the three repositories held here"
        source="Each repository's own published README, as captured, read before being described; behaviour is quoted from the repository rather than independently audited"
        href="/record/"
        captured="2 Aug 2026"
      />
      <Claim
        basis="derived"
        scope="The safety classification given to each of the three repositories, under one rule: a repository is classified by what its own README says the reader must supply, and by nothing else"
        source="This project's judgement about third-party proof-of-concept code, applied to the captured READMEs. No artefact establishes it, and it is not an audit of what the code does when it is run"
        href="/record/"
        captured="2 Aug 2026"
      />
    </p>

    <div class="repos">
      {held.map((e) => (
        <article class="repo">
          <div class="repo__head">
            <h4 class="repo__name">{e.name}</h4>
            <a class="repo__link" href={e.href}>capture &rarr;</a>
          </div>
          <p class="repo__meta">
            {e.who} &middot;
            <Timestamp iso={e.whenIso} hidden={!e.whenIso} />
            <span hidden={Boolean(e.whenIso)}>{e.when}</span>
            &middot; {e.licence}
          </p>
          <p class:list={['repo__safety', `repo__safety--${e.safety}`]}>{e.safetyLabel}</p>
          <p class="repo__input"><strong>Input:</strong> {e.input}</p>
          <p class="repo__what">{e.what}</p>
          <p class="repo__caveat" hidden={!e.caveat}>{e.caveat}</p>
        </article>
      ))}
    </div>

    <h3>Already in the source register</h3>

    <p>
      Upstream code and the pull requests filed in response were tracked before
      this catalogue existed. They are listed here so that the code published
      around this incident can be seen in one place, with their individual capture
      records linked.
      <Claim
        basis="verified"
        scope="That the upstream files, pull requests and researcher repositories listed above are registered and captured"
        source="The source register, where each entry carries its own capture record and revision history"
        href="/record/"
      />
      Their inputs are not at issue: these are source files,
      patches and review threads rather than tools a reader runs.
    </p>

    <ul class="node-list">
      {tracked.map((t) => (
        <li>
          <a href={`/record/sources/${t.id}/`}>{t.title}</a>
          <span class="dim">
            &middot; {t.org} &middot;
            <Timestamp iso={t.whenIso} hidden={!t.whenIso} />
            <span hidden={Boolean(t.whenIso)}>{t.when}</span>
          </span>
          <br /><span class="dim">{t.role}</span>
        </li>
      ))}
    </ul>

    <h3>Noted without recommendation</h3>

    <p>
      One repository has the shape this catalogue is built to flag: its stated
      purpose is to accept dice input and produce wallet material, which is the
      input class that would make it worth examining closely. It is completely
      empty. There is
      no code, so there is nothing to examine and nothing to warn about beyond the
      fact that a stated purpose is not a published implementation. It is recorded
      so that its later appearance with content is a change rather than a
      discovery, and it is not linked, because linking an empty repository whose
      contents are unknown would be a recommendation this archive cannot support.
    </p>

    <p>
      Separately, forks of the proof-of-concept repositories were compared against
      their upstreams. As of 2 August 2026 none had diverged.
      <Claim
        basis="derived"
        scope="That the examined forks of the proof-of-concept repositories had not diverged from their upstreams as of 2 August 2026"
        source="Derived from comparing each fork against its upstream on that date. The comparison output is not published here, so this one cannot be rechecked from the archive, and forks created or modified afterwards are outside it"
        compact
      />
      A fork that adds an
      input field for recovery material to an otherwise safe reproduction is the
      realistic way this class of code turns hostile, so the comparison is
      recorded, along with its date, rather than left implicit.
    </p>

    <h3>The negative finding, and its limits</h3>

    <p>
      As of 5 August 2026, no malicious seed-checker was found in public code
      indexes.
      <Claim
        basis="unverified"
        scope="The absence of a malicious COLDCARD seed-checker in public code indexes as of 5 August 2026"
        source="A GitHub public-code search on that date surfaced none; the search is not exhaustive, and a tool distributed outside code hosting would not appear in it"
      />
      That is a time-bounded observation and not an all-clear: it says
      nothing about tools hosted outside public code indexes, which is where a
      working phishing checker could instead be distributed on a domain, behind
      an advertisement or in a message. The
      <a href="/response/scams/">scams and warnings page</a> records the vendor
      warnings about that vector.
    </p>

    <div class="ve-card ve-card--red">
      <div class="ve-card__label lbl-red">Why recovery material is outside this register</div>
      <p>
        Whether this incident affects you is answerable from the firmware version
        installed when the seed was generated and how that seed was created.
        Neither fact is secret. Any tool, repository or page that asks for a
        recovery phrase, a private key or an extended private key in order to
        answer that question is asking for material that cannot contribute to the
        answer. That is why this archive does not accept recovery material and
        why the input requested by each published tool is recorded explicitly.
        The corresponding vendor warnings are preserved on the
        <a href="/response/scams/">scams and warnings page</a>.
      </p>
    </div>
  </section>

</Article>

<style>
  /*
   * The three source pages rendered directly under .prose, so .prose > * + *
   * gave their paragraphs their rhythm and Article.astro's ported rules gave
   * the injected firmware markup its own. Sections break both direct-child
   * selectors, so the rhythm is restated one level deeper here. Heading
   * margins are repeated because these scoped rules would otherwise outrank
   * the global .prose h2/h3 spacing.
   */
  section > * + * { margin-top: 1.05em; }
  section + section {
    margin-top: 3.4rem; padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  section > h2:first-child { margin-top: 0; }
  section > h3 { margin-top: 1.9em; font-size: 1.1rem; }
  section > :global(.ported) > :global(* + *) { margin-top: 1.05em; }
  section > :global(.ported) > :global(h3) { margin-top: 1.9em; font-size: 1.1rem; }
  section > :global(.ported) > :global(h3 + *) { margin-top: .65em; }

  /* Primary analysis. */

  /*
   * Group headings sit between the section's h2 and the card h4s. They carry
   * the same weight as the other h3s on the page, so the rule that restates
   * .prose spacing one level deeper has to reach them too.
   */
  .reg-group { margin-top: 2.4rem; }
  .reg-group__title { margin: 0; font-size: 1.1rem; }
  .reg-group__blurb {
    margin-top: .5rem; font-size: .88rem; line-height: 1.6; color: var(--ink-3);
    max-width: 44em;
  }
  .reg { display: grid; gap: 1rem; margin-block: 1.8rem; }
  .reg__item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
  }
  .reg__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .reg__who { font-size: 1.05rem; font-family: var(--font-display); font-weight: 400; margin: 0; }
  .reg__link {
    font-family: var(--font-mono); font-size: .68rem; color: var(--accent);
    text-decoration: none; white-space: nowrap;
  }
  .reg__link:hover { text-decoration: underline; }
  .reg__what {
    font-family: var(--font-mono); font-size: .64rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-3); margin-top: .35rem;
  }
  .reg__when {
    font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .04em; color: var(--ink-3); margin-top: .3rem;
  }
  .reg__detail { font-size: .89rem; line-height: 1.65; color: var(--ink-2); margin-top: .7rem; }

  /*
   * The artefact list for a contributor whose work spans several publications.
   * A single-artefact entry keeps the "evidence ->" link in its head instead,
   * so this list never renders with one item in it.
   */
  .reg__ev { list-style: none; margin: .8rem 0 0; padding: 0; display: grid; gap: .3rem; }
  .reg__ev li {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem;
    font-size: .82rem;
  }
  .reg__ev li::before {
    content: "\2192"; color: var(--accent);
    font-family: var(--font-mono); font-size: .74rem;
  }
