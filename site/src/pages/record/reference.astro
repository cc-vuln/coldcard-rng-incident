/*
 * Dates come from the source registry rather than being typed here, so a
 * register entry cannot drift away from the record it points at. `published` is
 * used for documents and `posted` for social threads; for a mutable repository
 * README it is when the work was first published, not when the held state was
 * captured. Where neither is established the entry says so rather than guessing.
 */
function evidenceMetadata(href: string): { id: string; label: string; iso: string } {
  const id = /^\/record\/sources\/([^/]+)\//.exec(href)?.[1] ?? '';
  if (!id) return { id: '', label: 'publication date not established here', iso: '' };
  const iso = sourceById(id)?.published ?? xPostById(id)?.posted;
  return {
    id,
    label: iso ? isoToHuman(iso) : 'publication date not established',
    iso: iso ?? '',
  };
}

/*
 * An entry's own date is the earliest of its artefacts, so a contributor sorts
 * by when they first published rather than by when they last revised. Entries
 * whose evidence carries no established date sort last rather than being
 * silently treated as ancient.
 */
const primaryGroups = PRIMARY_GROUPS.map((group) => ({
  ...group,
  entries: group.entries
    .map((entry) => {
      const links = entry.evidence.map((e) => ({
        ...e,
        ...evidenceMetadata(e.href),
        rel: e.href.startsWith('http') ? 'noopener nofollow' : undefined,
      }));
      const dated = links.filter((l) => l.iso).sort((a, b) => a.iso.localeCompare(b.iso));
      return {
        ...entry,
        links,
        /* One artefact needs no list; its date and link already sit in the head. */
        multi: links.length > 1,
        whenIso: dated[0]?.iso ?? '',
        when: dated[0]?.label ?? 'publication date not established',
        /*
         * Registry id behind the earliest local evidence link, handed to
         * CaptureThumb below. The component applies both publication gates
         * (staged via the x-media manifest, and not withheld) and renders
         * nothing for entries whose evidence is a web page rather than a
         * captured post, so this page keeps exactly its text-only rendering
         * when nothing is staged.
         */
        thumbId: (dated[0] ?? links[0])?.id ?? '',
      };
    })
    .sort((a, b) => (a.whenIso || '9999').localeCompare(b.whenIso || '9999')),
}));

const primaryCount = primaryGroups.reduce((n, g) => n + g.entries.length, 0);

const posts = xPosts();

/* --- Published code ------------------------------------------------------ */

/*
 * Catalogue of code published around this incident, organised by safety rather
 * than by author or topic.
 *
 * The reason for that ordering: during a weak-key incident the dangerous
 * property of a repository is not whether its analysis is correct, it is what
 * the repository asks a reader to feed it. A tool that accepts a recovery
 * phrase is dangerous whether or not its author meant harm, because the reader
 * cannot audit the process that receives the words. So every entry states what
 * it takes as input before it states what it does, and the classification is
 * derived from the repository's own published description as held here.
 */

type Safety = 'no-material' | 'source-only';

const SAFETY_LABEL: Record<Safety, string> = {
  'no-material': 'Accepts no wallet material',
  'source-only': 'Reads source trees, not wallets',
};

interface Entry {
  id?: string;              // source-registry id, where one exists
  name: string;
  who: string;
  safety: Safety;
  input: string;            // what the code takes in
  what: string;             // what it does
  licence: string;
  caveat?: string;
}

