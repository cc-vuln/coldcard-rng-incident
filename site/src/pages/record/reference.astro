/* --- Primary analysis ---------------------------------------------------- */

/*
 * Register original analyses separately from reporting that restates them.
 *
 * Two structural rules, both of which the flat list this replaced could not
 * express:
 *
 *   1. Entries are grouped by the kind of finding, using the same five-way
 *      split the section intro already names. A reader comparing two
 *      candidate-space models should not have to find them among two dozen
 *      cards that look identical, and the grouping puts the comparison the
 *      page keeps asking for side by side.
 *   2. One contributor gets one card per kind of finding, carrying every piece
 *      of evidence for it. Galaxy revised its top line three times and Kelbie
 *      published a postmortem and then a tracker built on it; as separate
 *      cards those read as independent contributions rather than as one body
 *      of work that moved. Where the same person did genuinely different work,
 *      the groups keep it apart, which is why Rob Hamilton appears under both
 *      chain analysis and demonstrations.
 *
 * Evidence links are dated from the registry, never typed here, and an entry's
 * displayed date is its earliest. Within a group, entries sort by that date, so
 * the ordering is chronological by first contribution rather than arbitrary.
 */

interface Evidence {
  /** Local source-record path, or an external URL for contextual material. */
  href: string;
  /** What this particular artefact is, when an entry carries more than one. */
  label: string;
}

interface PrimaryEntry {
  who: string;
  what: string;
  detail: string;
  status: string;
  scope: string;
  evidence: Evidence[];
}

interface PrimaryGroup {
  id: string;
  title: string;
  blurb: string;
  entries: PrimaryEntry[];
}

