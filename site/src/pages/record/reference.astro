/*
 * Dates come from the source registry rather than being typed here, so a
 * register entry cannot drift away from the record it points at. `published` is
 * used for documents and `posted` for social threads; for a mutable repository
 * README it is when the work was first published, not when the held state was
 * captured. Where neither is established the entry says so rather than guessing.
 */
function publishedMetadata(url: string): { label: string; iso: string } {
  const id = /^\/record\/sources\/([^/]+)\//.exec(url)?.[1];
  if (!id) return { label: 'publication date not established here', iso: '' };
  const iso = sourceById(id)?.published ?? xPostById(id)?.posted;
  return {
    label: iso ? isoToHuman(iso) : 'publication date not established',
    iso: iso ?? '',
  };
}

const primaryWithLinkMetadata = PRIMARY.map((entry) => {
  const published = publishedMetadata(entry.url);
  return {
    ...entry,
    when: published.label,
    whenIso: published.iso,
    evidenceRel: entry.url.startsWith('http') ? 'noopener nofollow' : undefined,
  /*
   * Registry id behind a local evidence link, handed to CaptureThumb below.
   * The component applies both publication gates (staged via the x-media
   * manifest, and not withheld) and renders nothing for entries whose evidence
   * is a web page rather than a captured post, so this page keeps exactly its
   * text-only rendering when nothing is staged.
   */
    thumbId: /^\/record\/sources\/([^/]+)\//.exec(entry.url)?.[1] ?? '',
  };
});

const posts = xPosts();

/* --- Published code ------------------------------------------------------ */

/*
 * Catalogue of code published around this incident, organised by safety rather
 * than by author or topic.
 *
 * The reason for that ordering: during a weak-key incident the dangerous
 * property of a repository is not whether its analysis is correct, it is what
 * the repository asks a reader to feed it. A tool that accepts a recovery
 * phrase is dangerous whether or not its author meant harm, because the reader
 * cannot audit the process that receives the words. So every entry states what
 * it takes as input before it states what it does, and the classification is
 * derived from the repository's own published description as held here.
 */

type Safety = 'no-material' | 'source-only';

const SAFETY_LABEL: Record<Safety, string> = {
  'no-material': 'Accepts no wallet material',
  'source-only': 'Reads source trees, not wallets',
};

interface Entry {
  id?: string;              // source-registry id, where one exists
  name: string;
  who: string;
  safety: Safety;
  input: string;            // what the code takes in
  what: string;             // what it does
  licence: string;
  caveat?: string;
}

