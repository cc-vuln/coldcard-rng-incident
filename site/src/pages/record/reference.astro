    border-radius: 999px; padding: .18rem .5rem; margin-top: .6rem;
  }
  .repo__safety--no-material { color: var(--safe); background: var(--safe-soft); }
  .repo__safety--source-only { color: var(--info); background: var(--info-soft); }
