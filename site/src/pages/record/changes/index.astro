---
import Article from '../../../layouts/Article.astro';
import RecordSearch from '../../../components/RecordSearch.astro';
import Timestamp from '../../../components/Timestamp.astro';
import {
  changeLog, sourceById, diffText, parseDiff,
  displayTitle, revisions, withholdsCapturedText, sources, snapshots, xPosts,
  nostrPosts, nostrCaptures, shortNpub,
  groupOf, xArtifacts, summary, withholdsCapturedMedia,
} from '../../../lib/archive';
import { xMedia } from '../../../lib/xmedia';

/*
 * The whole capture record as one chronological stream.
 *
 * This page absorbed the old /record/feed/: detected differences, first
 * captures, registered X posts and the operational log interleave because to
 * a reader they are the same kind of event, something entered the record on a
 * date. The filter defaults to reviewed source changes, which is the view
 * this page has always led with; everything else is one click away and stays
 * in the DOM.
 *
 * Known trade-off: the merged page ships roughly 2.3 MB of HTML by design
 * (every entry in the DOM, revealed progressively), consistent with the feed
 * approach and the no-JS rule that everything stays visible.
 *
 * Everything the template needs is precomputed here. No conditionals or
 * string escapes in the markup: .astro expression parsing is fussier than
 * plain JSX, so the three entry shapes (full revision card, compact entry,
 * operational row) share one structure and differ by which parts are hidden
 * and by CSS classes computed below.
 */

const LABEL: Record<string, string> = {
  first: 'baseline',
  error: 'fetch error',
  blocked: 'blocked',
  skipped: 'skipped',
};

const REVIEW_LABEL: Record<string, string> = {
  'source-content': 'source content',
  'capture-noise': 'capture noise',
  'capture-correction': 'capture correction',
  'unreviewed': 'unreviewed',
};

function publicErrorSummary(error: unknown): string {
  const detail = typeof error === 'string' ? error : '';
  const http = detail.match(/\bHTTP(?: Error)?\s+(\d{3})\b/i);
  if (http) return `Source check returned HTTP ${http[1]}.`;
  if (/timed? out|timeout/i.test(detail)) return 'Source check timed out.';
  return detail ? 'Source check did not complete. Detailed diagnostics are retained privately.' : '';
}

type Entry = {
  iso: string;
  kind: string;
  group: string;
  search: string;
  cls: string;
  href: string | null;
  title: string;
  label: string;
  inherited: boolean;
  baselineInherited: boolean;
  showDelta: boolean;
  added: number;
  removed: number;
  orgLine: string;
  note: string;
  imgSrc: string | undefined;
  imgCapturedIso: string;
  hasShot: boolean;
  lines: { cls: string; text: string }[];
  hasLines: boolean;
};

const revList = revisions();

// Detected differences: the archive's reason for existing, rendered as the
// full card with review status, provenance marks and a bounded diff excerpt.
const revisionEntries: Entry[] = revList.map((revision) => {
  const src = sourceById(revision.sourceId)!;
  const withholdDiff = withholdsCapturedText(src);
  const raw = withholdDiff ? null : diffText(revision.sourceId, revision.ts);
  const parsed = raw
    ? parseDiff(raw).filter((l) => l.kind === 'add' || l.kind === 'del').slice(0, 14)
    : [];
  const status = revision.review.status;
  return {
    iso: revision.iso,
    kind: status === 'source-content' || status === 'unreviewed' ? 'change' : 'collection',
    group: groupOf(src),
    search: `${revision.sourceId} ${src.org ?? ''}`,
    cls: 'chev ch ch--' + status,
    href: '/record/sources/' + revision.sourceId + '/',
    title: displayTitle(src),
    label: REVIEW_LABEL[status],
    // Provenance is published in the JSON feeds and must stay visible here:
    // on the later state when that state was inherited, and as a baseline
    // note when the text being revised was the inherited one.
    inherited: revision.inherited,
    baselineInherited: revision.baselineInherited,
    showDelta: true,
    added: revision.added,
    removed: revision.removed,
    orgLine: `${revision.sourceId} · ${[src.org, src.kind].filter(Boolean).join(' / ')}`,
    note: revision.review.summary,
    imgSrc: undefined,
    imgCapturedIso: '',
    hasShot: false,
    lines: parsed.map((l) => ({
      cls: 'dl dl--' + l.kind,
      text: (l.kind === 'add' ? '+' : '-') + l.text + '\n',
    })),
    hasLines: parsed.length > 0,
  };
});

// First capture of each source: when it entered the record.
const firstEntries: Entry[] = sources().flatMap((src) => {
  const snaps = snapshots(src.id);
  if (!snaps.length) return [];
  const first = snaps[0];
  return [{
    iso: first.iso,
    kind: 'first',
    group: groupOf(src),
    search: `${src.id} ${src.org ?? ''}`,
    cls: 'chev ch ch--first',
    href: '/record/sources/' + src.id + '/',
    title: displayTitle(src),
    label: 'entered the record',
    inherited: false,
    baselineInherited: false,
    showDelta: false,
    added: 0,
    removed: 0,
    orgLine: src.org ?? '',
    note: summary(src.note?.trim().split('\n').join(' '), 25),
    imgSrc: undefined,
    imgCapturedIso: '',
    hasShot: false,
    lines: [],
    hasLines: false,
  }];
});

// Registered X posts, shown with the held screenshot where there is one.
// Staging is a provenance check; withholding is the publication decision, and
// both must pass before an image renders. No source withholds today.
const postEntries: Entry[] = xPosts().map((post) => {
  const shots = withholdsCapturedMedia(post) ? [] : xMedia(post.id);
  const held = xArtifacts(post).length;
  const shot = shots[0];
  return {
    iso: post.posted ?? '',
    kind: 'post',
    group: 'x',
    search: `${post.id} @${post.author} ${post.org ?? ''}`,
    cls: 'chev ch ch--post',
    href: `/record/sources/${post.id}/`,
    title: displayTitle(post),
    label: held ? 'post captured' : 'post registered, capture pending',
    inherited: false,
    baselineInherited: false,
    showDelta: false,
    added: 0,
    removed: 0,
    orgLine: `@${post.author}${post.org ? ` · ${post.org}` : ''}`,
    note: summary(post.why, 25),
    imgSrc: shot?.src,
    imgCapturedIso: shot?.captured ?? '',
    hasShot: Boolean(shot),
    lines: [],
    hasLines: false,
  };
});

// Operational events: baselines, fetch errors, blocked and skipped polls.
// `changed` log events are excluded because revisions() above already derives
// every difference from the snapshots on disk, including Wayback recoveries
// the poller logged as `first`.
const opEntries: Entry[] = changeLog()
  .filter((e) => e.event !== 'changed')
  .map((e) => {
    const src = sourceById(e.id);
    return {
      iso: e.iso,
      kind: 'operational',
      // An unregistered id has no group and no page: the index is
      // append-only, so events outlive registry entries.
      group: src ? groupOf(src) : '',
      search: src ? `${e.id} ${src.org ?? ''}` : e.id,
      cls: 'chev ch chev--op ch--' + e.event,
      href: src ? '/record/sources/' + e.id + '/' : null,
      title: src ? displayTitle(src) : e.id,
      label: LABEL[e.event] || e.event,
      inherited: false,
      baselineInherited: false,
      showDelta: false,
      added: 0,
      removed: 0,
      orgLine: '',
      note: publicErrorSummary(e.error),
      imgSrc: undefined,
      imgCapturedIso: '',
      hasShot: false,
      lines: [],
      hasLines: false,
    };
  });

// Registered nostr posts. Same shape as the X entries, minus the screenshot:
// this lane captures signed events, not images. The kind is deliberately not
// 'post', so the "X posts" filter below never sweeps them up.
const nostrEntries: Entry[] = nostrPosts().map((post) => {
  const held = nostrCaptures(post).length;
  return {
    iso: post.posted ?? '',
    kind: 'nostr-post',
    group: 'nostr',
    search: `${post.id} ${post.author} ${post.org ?? ''}`,
    cls: 'chev ch ch--post',
    href: `/record/sources/${post.id}/`,
    title: displayTitle(post),
    label: held ? 'nostr post captured' : 'nostr post registered, capture pending',
    inherited: false,
    baselineInherited: false,
    showDelta: false,
    added: 0,
    removed: 0,
    orgLine: `${shortNpub(post.author)}${post.org ? ` · ${post.org}` : ''}`,
    note: summary(post.why, 25),
    imgSrc: undefined,
    imgCapturedIso: '',
    hasShot: false,
    lines: [],
    hasLines: false,
  };
});

const ordered = [...revisionEntries, ...firstEntries, ...postEntries, ...nostrEntries, ...opEntries]
  .filter((e) => e.iso)
  .sort((a, b) => (a.iso < b.iso ? 1 : a.iso > b.iso ? -1 : 0));

// Month grouping over the newest-first list, with the progressive-reveal flag
// assigned by position in the whole stream rather than per month.
const INITIAL = 24;
type Month = { key: string; label: string; entries: (Entry & { beyond: boolean })[] };
const months: Month[] = [];
let pos = 0;
for (const e of ordered) {
  const key = e.iso.slice(0, 7);
  let m = months[months.length - 1];
  if (!m || m.key !== key) {
    m = {
      key,
      label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-GB', {
        month: 'long', year: 'numeric', timeZone: 'UTC',
      }),
      entries: [],
    };
    months.push(m);
  }
  m.entries.push({ ...e, beyond: pos >= INITIAL });
  pos += 1;
}

const reviewedCount = revList.filter((r) => r.review.status === 'source-content').length;
const unreviewed = revList.filter((r) => r.review.status === 'unreviewed').length;
const collectionCount = revList.filter((r) =>
  r.review.status === 'capture-noise' || r.review.status === 'capture-correction'
).length;
const inheritedCount = revList.filter((r) => r.inherited || r.baselineInherited).length;
const isEmpty = reviewedCount + unreviewed === 0;

const FACET_SETS = [
  {
    label: 'Show',
    facets: [
      { value: 'change', label: 'Source changes', matchAttr: 'data-kind', default: true },
      { value: 'collection', label: 'Collection differences', matchAttr: 'data-kind' },
      { value: 'first', label: 'First captures', matchAttr: 'data-kind' },
      { value: 'post', label: 'X posts', matchAttr: 'data-kind' },
      // Present only while nostr posts exist, so an empty lane changes
      // nothing about this page.
      ...(nostrEntries.length
        ? [{ value: 'nostr-post', label: 'Nostr posts', matchAttr: 'data-kind' }]
        : []),
      { value: 'operational', label: 'Operational log', matchAttr: 'data-kind' },
    ],
  },
  {
    label: 'Source',
    facets: [
      { value: 'community', label: 'Community' },
      { value: 'vendor', label: 'Vendor' },
      { value: 'reporting', label: 'Reporting' },
      { value: 'research', label: 'Research' },
      { value: 'analysis', label: 'Analysis' },
      { value: 'repo', label: 'Repos' },
      { value: 'monitor', label: 'Monitors' },
      { value: 'firsthand', label: 'First-hand' },
      { value: 'x', label: 'X posts' },
      ...(nostrEntries.length ? [{ value: 'nostr', label: 'Nostr posts' }] : []),
    ],
  },
];
---

<Article
  title="Source change record"
  description="Every capture, detected difference, registered post and operational event in the archive, in one chronological stream defaulting to the reviewed source changes."
  standfirst="Everything that entered the record, in order: each difference the archive holds between two states of a tracked page, each first capture, each registered post, classified and dated."
  depth="plain"
  kicker="The record / changes"
  next={{
    href: '/record/firmware/',
    label: 'Firmware releases',
    note: 'Affected ranges by model, and the releases that mark each boundary.',
  }}
>
    <p>
      Newest first, one stream. The filter below defaults to the reviewed
      <em>source-content</em> changes: a reviewed source-content difference
      means the relevant text served by the publisher changed between two
      captures. It does not verify the new claim. Collection differences
      (dynamic page chrome and collection-method corrections), first captures,
      registered posts and the operational log (baselines, fetch errors,
      blocked and skipped checks) remain part of the record one click away.
      Chain-monitor diff bodies remain local because they can contain victim
      addresses.
    </p>

    <p>
      Some states here were not collected by this project. Where a difference
      involves a page state recovered from the Internet Archive, the entry
      carries an <strong>Internet Archive</strong> mark: on the later state when
      that state was inherited, and as a baseline note when the text being
      revised was the inherited one. As of 1 August 2026, {inheritedCount} of the
      {revList.length} recorded differences carry one of those marks. This
      keeps a recovered state from reading as a change this project caught live.
    </p>

    <p>
      This record is part of the <a href="/record/">evidence section</a>, which
      lists every tracked source and what is held for it. To follow it without
      revisiting the page, the same entries are published as a JSON feed at
      <a href="/record/changes.json">/record/changes.json</a>, carrying the
      bounded revision window and provenance flags per item.
    </p>

    <div class="ch__stats">
      <div><strong>{reviewedCount}</strong><span>reviewed source changes</span></div>
      <div><strong>{unreviewed}</strong><span>awaiting review</span></div>
      <div><strong>{collectionCount}</strong><span>collection differences</span></div>
      <div><strong>{opEntries.length}</strong><span>baselines and errors</span></div>
    </div>

    <div class="ch__search">
      <RecordSearch
        target=".chev"
        section=".ch__month"
        placeholder="Search the change record"
        facetSets={FACET_SETS}
      />
    </div>

    <p class="ch__empty" hidden={!isEmpty}>No source-content changes recorded yet.</p>

    {months.map((m) => (
      <section class="ch__month">
        <h2>{m.label}</h2>
        <ol class="ch__list">
          {m.entries.map((e) => (
            <li
              class={e.cls}
              data-kind={e.kind}
              data-group={e.group}
              data-search={e.search}
              data-beyond={e.beyond ? '' : undefined}
              hidden={e.beyond}
            >
              <div class="ch__bar">
                <Timestamp class="ch__ts" iso={e.iso} />
                {e.href
                  ? <a class="ch__id" href={e.href}>{e.title}</a>
                  : <span class="ch__id">{e.title}</span>}
                <span class="pill">{e.label}</span>
                <span class="pill pill--wayback" hidden={!e.inherited}>Internet Archive</span>
                <span class="ch__delta" hidden={!e.showDelta}>
                  <span class="add">+{e.added}</span>
                  <span class="del">-{e.removed}</span>
                </span>
              </div>
              <div class="ch__shot" hidden={!e.hasShot}>
                <img src={e.imgSrc} alt={`Captured screenshot: ${e.title}`} loading="lazy" />
                <span class="ch__captured">captured <Timestamp iso={e.imgCapturedIso} /></span>
              </div>
              <p class="ch__org" hidden={!e.orgLine}>{e.orgLine}</p>
              <p class="ch__prov" hidden={!e.baselineInherited}>compared against an Internet Archive baseline</p>
              <p class="ch__summary" hidden={!e.note}>{e.note}</p>
              <pre class="ch__diff" hidden={!e.hasLines}><code>{e.lines.map((l) => (
                <span class={l.cls}>{l.text}</span>
              ))}</code></pre>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <div class="ch__more">
      <button class="ch__btn" type="button">Show more</button>
      <p class="ch__status" role="status" aria-live="polite"></p>
    </div>

    <noscript>
      <style is:inline>
        /* Progressive reveal is the enhancement, not the content: with no
           script the whole stream stays visible and the reveal control goes. */
        .chev[hidden] { display: block; }
        .ch__more { display: none; }
      </style>
    </noscript>

    <p class="ch__foot">
      Back to <a href="/record/">the evidence index</a>, or read the same
      differences as structured data in
      <a href="/record/changes.json">the JSON change feed</a>.
    </p>

  <script>
    // Progressive reveal. Everything is already in the DOM, so this only flips
    // `hidden`: with JavaScript off the whole stream is visible instead of
    // empty, which is the right failure for an archive.
    const STEP = 24;
    const items = [...document.querySelectorAll('.chev')];
    const btn = document.querySelector('.ch__btn');
    const status = document.querySelector('.ch__status');
    const wrap = document.querySelector('.ch__more');
    // Declared by the search component when present; harmless standalone.
    const show = window.applyVisibility || ((el) => {
      el.hidden = el.hasAttribute('data-nomatch') || el.hasAttribute('data-beyond');
    });

    function update() {
      // Check the flag as well as the event: the default facet means the page
      // can load already filtered, before this listener was registered.
      const filtering = document.documentElement.hasAttribute('data-filtering');
      const unrevealed = items.filter((el) => el.hasAttribute('data-beyond')).length;
      wrap.hidden = filtering || unrevealed === 0;
      status.textContent = unrevealed === 0
        ? `all ${items.length} entries shown`
        : `${items.length - unrevealed} of ${items.length} shown`;
    }
    function more() {
      let n = 0;
      for (const el of items) {
        if (n >= STEP) break;
        if (el.hasAttribute('data-beyond')) {
          el.removeAttribute('data-beyond');
          show(el);
          n += 1;
        }
      }
      update();
    }
    btn.addEventListener('click', more);
    // While a filter is active every match is already shown, so the reveal
    // control would be meaningless; it returns when the filter is cleared.
    document.addEventListener('rs:filter', (e) => {
      if (e.detail && e.detail.filtering) wrap.hidden = true;
      else update();
    });
    // Infinite scroll: reveal as the end of the list comes into view, with the
    // button kept as the accessible and no-observer fallback.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) more();
      }, { rootMargin: '400px' }).observe(wrap);
    }
    update();
  </script>
</Article>

<style>
  /* These blocks are wider than the reading measure by design: a change entry
     carries a timestamp, a title, pills and a diff on one line. The Article
     layout already grants that escape to tables and figures. */
  .ch__stats, .ch__search, .ch__month, .ch__more {
    width: 100cqi;
    max-width: none;
  }
  .ch__stats { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap: .8rem; margin-top: 1.6rem; }
  .ch__stats div { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: .8rem 1rem; }
  .ch__stats strong { display: block; font-family: var(--font-mono); font-size: 1.4rem; }
  .ch__stats span { display: block; color: var(--ink-3); font-family: var(--font-mono); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; margin-top: .15rem; }
  .ch__empty { color: var(--ink-3); margin-top: 2rem; }
  .ch__empty[hidden] { display: none; }

  .ch__month { margin-top: 2.4rem; }
  .ch__month h2 { font-family: var(--font-display); font-weight: 400; font-size: 1.4rem; }
  .ch__month .ch__list { margin-top: 1rem; }

  .ch__list { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: .9rem; }
  .ch {
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--rule-2);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: .95rem var(--inset-box);
  }
  .ch--source-content { border-left-color: var(--accent); }
  .ch--unreviewed { border-left-color: var(--warn); }
  .ch--capture-noise, .ch--capture-correction { border-left-color: var(--rule-2); }
  .ch--first { border-left-color: var(--safe); }
  .ch--post { border-left-color: var(--accent); }
  .ch--error, .ch--blocked { border-left-color: var(--danger); }
  .ch--skipped { border-left-color: var(--rule-2); }

  .ch__bar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .ch__ts { font-family: var(--font-mono); font-size: .78rem; color: var(--ink-3); }
  .ch__id { font-family: var(--font-mono); font-size: .86rem; font-weight: 600; text-decoration: none; }
  .ch__id:hover { color: var(--accent); }
  .ch__delta { font-family: var(--font-mono); font-size: .74rem; margin-left: auto; display: flex; gap: .45rem; }
  .ch__delta[hidden] { display: none; }
  .ch__delta .add { color: var(--add); }
  .ch__delta .del { color: var(--del); }

  .pill--wayback {
    border-color: var(--rule-2);
    color: var(--ink-3);
  }
  .pill--wayback[hidden] { display: none; }

  .ch__shot {
    margin-top: .6rem; border: 1px solid var(--rule); border-radius: var(--radius);
    overflow: hidden; max-height: 260px; background: var(--surface-2);
  }
  .ch__shot img { display: block; width: 100%; height: auto; }
  .ch__captured {
    display: block;
    padding: .35rem var(--inset-box);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: .56rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }

  .ch__org { font-size: .76rem; color: var(--ink-3); margin-top: .3rem; }
  .ch__org[hidden] { display: none; }
  .ch__prov {
    font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .04em; color: var(--ink-3); margin-top: .3rem;
  }
  .ch__prov[hidden] { display: none; }
  .ch__foot { margin-top: 2.4rem; font-size: .86rem; color: var(--ink-3); }
  .ch__summary { font-size: .88rem; line-height: 1.55; color: var(--ink-2); margin-top: .45rem; max-width: 76ch; }
  .ch__summary[hidden] { display: none; }

  .ch__diff {
    background: var(--sunken);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: .7rem .9rem;
    margin-top: .7rem;
    overflow-x: auto;
    font-size: .72rem;
    line-height: 1.6;
  }
  /* The layout widens bare <pre> past the measure, which would push a diff out
     of the card that contains it. Inside a change entry the card owns the
     width. */
  .ch .ch__diff { width: 100%; max-width: 100%; }
  .ch__diff[hidden] { display: none; }
  .dl { display: block; white-space: pre-wrap; word-break: break-word; }
  .dl--add { background: var(--add-bg); color: var(--add); }
  .dl--del { background: var(--del-bg); color: var(--del); }

  /* Operational entries are compact rows, not cards. The bar's children join
     the row grid directly (display: contents), and the note takes the last
     column. */
  .chev--op {
    background: none;
    border: none;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    padding: .65rem .2rem;
    display: grid;
    grid-template-columns: 20ch minmax(16ch,1fr) 11ch minmax(0,1.6fr);
    gap: .8rem;
    align-items: baseline;
  }
  .chev--op[hidden] { display: none; }
  .chev--op .ch__bar { display: contents; }
  .chev--op .ch__summary {
    margin-top: 0; font-size: .76rem; color: var(--danger); max-width: none;
  }
  @media (max-width: 720px) {
    .chev--op { grid-template-columns: 1fr; gap: .25rem; }
  }

  .ch__more { text-align: center; margin-top: 1.5rem; }
  .ch__btn {
    font: inherit; font-size: .85rem;
    padding: .5rem 1.1rem;
    border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .ch__btn:hover { border-color: var(--accent); color: var(--accent); }
  .ch__status {
    font-family: var(--font-mono); font-size: .62rem; color: var(--ink-3);
    letter-spacing: .06em; text-transform: uppercase; margin-top: .5rem;
  }
</style>
