import Timestamp from '../../components/Timestamp.astro';
import TimestampRange from '../../components/TimestampRange.astro';
import Claim from '../../components/Claim.astro';
import Disclosure from '../../components/Disclosure.astro';
import RecordSearch from '../../components/RecordSearch.astro';
import { fig } from '../../lib/figures';
import {
  revisions, sources, xPosts, nostrPosts, sourceById, displayTitle, summary,
  tsToIso, withholdsCapturedMedia, shortNpub,
} from '../../lib/archive';
import { xMedia } from '../../lib/xmedia';

/*
 * One continuous chronology, from the earliest dated precedent material to
 * the latest development the record holds.
 *
 * Two weights of entry share the same rail. Landmarks are hand-written: the
 * 2021 to 2026 archaeology, the incident week reconstructed in detail, and
 * the later developments that change what the incident means, each with its
 * own evidence markers. Each landmark group is followed by an "Also on ..."
 * section holding the rest of that day's or month's record: every registered
 * post at its publication time, every dated publication, and every reviewed
 * source-content change plotted as the window it was detected in. First
 * captures are deliberately not entries: when this project fetched something
 * is collector time, not discourse time.
 *
 * Landmark markup is literal in the template on purpose. The claim gate
 * (site/tools/check-claims.mjs) audits Claim props in page source, so a Claim
 * rendered from a data loop with expression props fails the gate; every
 * landmark Claim below is a literal tag. This frontmatter therefore carries
 * only the landmark ORDER and the registry ids each landmark cites (so cited
 * posts and publications stay out of the data-driven sections), plus the
 * moment entries and the section structure.
 */

// sort: UTC instant the landmark is plotted at. cites: registry ids the
// landmark covers, excluded from the data-driven sections so nothing appears
// twice. The template writes each landmark under the group its sort implies,
// in this order.
const LANDMARKS: { sort: string; cites: string[] }[] = [
