const citedIds = new Set(LANDMARKS.flatMap((l) => l.cites));

type Moment = {
  sort: string;
  kind: 'post' | 'publication' | 'change';
  dateIso: string;
  windowStartIso: string;
  windowEndIso: string;
  title: string;
  href: string;
  label: string;
  orgLine: string;
  note: string;
  inherited: boolean;
  baselineInherited: boolean;
  imgSrc: string | undefined;
  imgCapturedIso: string;
  hasShot: boolean;
  search: string;
};

// Registered posts at their publication time, except those a landmark cites.
// The held screenshot rides along where there is one, under the same pair of
// gates every staged-media renderer applies: staged in the x-media manifest
// (OWN_HOST_FROM provenance) and not withheld (the publication decision).
const postMoments: Moment[] = xPosts()
  .filter((p) => p.posted && !citedIds.has(p.id))
  .map((p) => {
    const shot = withholdsCapturedMedia(p) ? undefined : xMedia(p.id)[0];
    return {
      sort: p.posted!,
      kind: 'post',
      dateIso: p.posted!,
      windowStartIso: '',
      windowEndIso: '',
      title: displayTitle(p),
      href: `/record/sources/${p.id}/`,
      label: 'post',
      orgLine: `@${p.author}${p.org ? ` · ${p.org}` : ''}`,
      note: summary(p.why?.trim().split('\n').join(' '), 30),
      inherited: false,
      baselineInherited: false,
      imgSrc: shot?.src,
      imgCapturedIso: shot?.captured ?? '',
      hasShot: Boolean(shot),
      search: `${p.id} @${p.author} ${p.org ?? ''}`,
    };
  });

// Registered nostr posts at their publication time, plotted like X posts.
// This lane holds signed events rather than screenshots, so no thumbnail
// gates apply.
const nostrPostMoments: Moment[] = nostrPosts()
  .filter((p) => p.posted && !citedIds.has(p.id))
  .map((p) => ({
    sort: p.posted!,
    kind: 'post',
    dateIso: p.posted!,
    windowStartIso: '',
    windowEndIso: '',
    title: displayTitle(p),
    href: `/record/sources/${p.id}/`,
    label: 'nostr post',
    orgLine: `${shortNpub(p.author)}${p.org ? ` · ${p.org}` : ''}`,
    note: summary(p.why?.trim().split('\n').join(' '), 30),
    inherited: false,
    baselineInherited: false,
    imgSrc: undefined,
    imgCapturedIso: '',
    hasShot: false,
    search: `${p.id} ${p.author} ${p.org ?? ''}`,
  }));

// Sources with a publisher-displayed date, at that date (day precision).
const publicationMoments: Moment[] = sources()
  .filter((s) => s.published && !citedIds.has(s.id))
  .map((s) => ({
    sort: `${s.published}T00:00:00Z`,
    kind: 'publication',
    dateIso: s.published!,
    windowStartIso: '',
    windowEndIso: '',
    title: displayTitle(s),
    href: `/record/sources/${s.id}/`,
    label: 'published',
    orgLine: s.org ?? '',
    note: summary(s.note?.trim().split('\n').join(' '), 30),
    inherited: false,
    baselineInherited: false,
    imgSrc: undefined,
    imgCapturedIso: '',
    hasShot: false,
    search: `${s.id} ${s.org ?? ''}`,
  }));

// Reviewed source-content changes, plotted as detection windows rather than
// points: the edit landed somewhere between the two held states, and the
// entry says so. Chain monitors are excluded, as on the latest-events band:
// their numbers change every poll by nature, and their churn belongs on
// /record/changes/.
const changeMoments: Moment[] = revisions()
  .filter((r) => r.review.status === 'source-content')
  .filter((r) => sourceById(r.sourceId)?.kind !== 'chain-monitor')
  .map((r) => {
    const src = sourceById(r.sourceId)!;
    return {
      sort: tsToIso(r.windowEnd),
      kind: 'change',
      dateIso: '',
      windowStartIso: tsToIso(r.windowStart),
      windowEndIso: tsToIso(r.windowEnd),
      title: displayTitle(src),
      href: `/record/sources/${r.sourceId}/`,
      label: 'source content',
      orgLine: `${src.org ?? ''}${src.org ? ' · ' : ''}${r.sourceId}`,
      note: r.review.summary,
      inherited: r.inherited,
      baselineInherited: r.baselineInherited,
      imgSrc: undefined,
      imgCapturedIso: '',
      hasShot: false,
      search: `${r.sourceId} ${src.org ?? ''}`,
    };
  });

const KIND_RANK: Record<Moment['kind'], number> = { post: 1, publication: 2, change: 3 };
const moments = [...postMoments, ...nostrPostMoments, ...publicationMoments, ...changeMoments]
  .sort((a, b) => (a.sort < b.sort ? -1 : a.sort > b.sort ? 1 : KIND_RANK[a.kind] - KIND_RANK[b.kind]));

// UTC day headers across the incident window, month headers otherwise.
function groupKeyOf(iso: string): string {
  const day = iso.slice(0, 10);
  if (day >= '2026-07-30' && day <= '2026-08-09') return day;
  return iso.slice(0, 7);
}
function groupLabelOf(key: string): string {
  const day = key.length === 10;
  return new Date(`${key}${day ? '' : '-01'}T00:00:00Z`).toLocaleDateString('en-GB', {
    ...(day ? { day: 'numeric' } : {}),
    month: 'long', year: 'numeric', timeZone: 'UTC',
  });
}

const landmarkSortsByGroup = new Map<string, string[]>();
for (const l of LANDMARKS) {
  const key = groupKeyOf(l.sort);
  const list = landmarkSortsByGroup.get(key) ?? [];
  list.push(l.sort);
  landmarkSortsByGroup.set(key, list);
}
const momentsByGroup = new Map<string, Moment[]>();
for (const m of moments) {
  const key = groupKeyOf(m.sort);
  const list = momentsByGroup.get(key) ?? [];
  list.push(m);
  momentsByGroup.set(key, list);
}

// One section per landmark group (literal markup below) and one per run of
// moments. A group holding both splits in two: the landmark section, then an
// "Also on ..." sibling with the rest of that day's record. Sections sort by
// an anchor rather than by key, because a month key ('2026-08') sorts before
// its own day keys ('2026-08-04') lexicographically: a landmark section
// anchors on its group key, a plain section on its earliest entry, and a
// sibling just after its landmark section. gord is the document-order index
// the direction toggle sorts by.
const INITIAL = 24;
type SectionEntry = Moment & { eord: number; beyond: boolean };
type Section = {
  key: string; label: string; anchor: string; lm: boolean;
  gord: number; entries: SectionEntry[];
};
const unsorted: Section[] = [];
const groupKeys = [...new Set([...landmarkSortsByGroup.keys(), ...momentsByGroup.keys()])];
for (const key of groupKeys) {
  const lmSorts = landmarkSortsByGroup.get(key) ?? [];
  const moms = momentsByGroup.get(key) ?? [];
  if (lmSorts.length) {
    unsorted.push({ key, label: groupLabelOf(key), anchor: key, lm: true, gord: 0, entries: [] });
  }
  if (moms.length) {
    const sibling = lmSorts.length > 0;
    const label = sibling
      ? `${key.length === 10 ? 'Also on' : 'Also in'} ${groupLabelOf(key)}`
      : groupLabelOf(key);
    const entries = moms.map((m, i) => ({ ...m, eord: i, beyond: false }));
    unsorted.push({
      key: sibling ? `${key}~` : key,
      label,
      anchor: sibling ? `${key}~` : moms[0].sort,
      lm: false, gord: 0, entries,
    });
  }
}
const sections = unsorted.sort((a, b) => (a.anchor < b.anchor ? -1 : a.anchor > b.anchor ? 1 : 0));
const beyondBySort = new Map<string, boolean>();
let pos = 0;
for (const s of sections) {
  s.gord = sections.indexOf(s);
  if (s.lm) {
    for (const sort of landmarkSortsByGroup.get(s.key) ?? []) {
      beyondBySort.set(sort, pos >= INITIAL);
      pos += 1;
    }
  } else {
    for (const e of s.entries) {
      e.beyond = pos >= INITIAL;
      pos += 1;
    }
  }
}

const gordByKey = new Map(sections.map((s) => [s.key, s.gord]));
const gordOf = (key: string): number => gordByKey.get(key) ?? 0;
const lmBeyond = (sort: string): boolean => beyondBySort.get(sort) ?? false;

const FACET_SETS = [
  {
    label: 'Show',
    multiple: true,
    allLast: true,
    facets: [
      { value: 'landmark', label: 'Landmarks', matchAttr: 'data-kind', default: true },
      { value: 'post', label: 'Posts', matchAttr: 'data-kind' },
      { value: 'publication', label: 'Publications', matchAttr: 'data-kind' },
      { value: 'change', label: 'Source changes', matchAttr: 'data-kind' },
    ],
  },
];
---

<Article
  title="Timeline"
  description="A dated record of the software changes, thefts, disclosures, corrections and public responses in the July 2026 COLDCARD incident."
  standfirst="How a software flaw reached COLDCARD wallets, when funds were stolen, and what happened afterward."
  depth="plain"
  kicker="The record"
  next={{
    href: '/record/funds/',
    label: 'Funds accounting',
    note: 'The competing totals, methods and current tracker readings.',
  }}
>
  <div class="tl-controls">
    <RecordSearch
      target=".tle"
      section=".tlgroup"
      placeholder="Search the timeline"
      facetSets={FACET_SETS}
    />
    <div class="tl-dir" hidden>
      <span class="tl-dir__label">Order</span>
      <button class="tl-dir__btn is-on" type="button" data-dir="latest">Latest first</button>
      <button class="tl-dir__btn" type="button" data-dir="oldest">Oldest first</button>
    </div>
  </div>

  <div id="tl-stream">
    {sections.map((s) => {
      if (s.key === '2021-01') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">January 2021</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2021-01-28T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2021-01-28T00:00:00Z')}>
              <div class="tl-date">28 Jan 2021</div>
              <div class="tl__title">The build-time guard exists in libngu</div>
              <div class="tl-body">
                The <code>#ifndef MICROPY_HW_ENABLE_RNG</code> guard exists in <code>libngu</code>. Its defined-zero defect is already present, but COLDCARD seed generation does not yet use this path.
                <Claim basis="reported" scope="The presence and defined-zero defect of the MICROPY_HW_ENABLE_RNG guard in libngu at this date, as published" source="Block's engineering disclosure, which documents the guard's defined-ness error and the deterministic fallback it selects, held capture of 31 Jul 2026" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2021-03') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">March 2021</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-bad" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2021-03-01T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2021-03-01T00:00:00Z')}>
              <div class="tl-date">1 Mar 2021</div>
              <div class="tl__title">Seed generation migrates to ngu.random.bytes()</div>
              <div class="tl-body">
                Commit <code>b18723dddb6d751c39978e4364b56b2414f68b47</code> migrates wallet generation from <code>ckcc.rng_bytes()</code> to <code>ngu.random.bytes()</code>. Combined with the existing defined-zero guard defect, the migration activates the affected path.
                <Claim basis="reported" scope="The 1 March 2021 migration commit and its activation of the affected seed-generation path, as published" source="Block's engineering disclosure, which dates migration commit b18723dd to 1 March 2021 and traces its first appearance to released firmware v4.0.0, held capture of 31 Jul 2026" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-bad" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2021-03-17T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2021-03-17T00:00:00Z')}>
              <div class="tl-date">17 Mar 2021</div>
              <div class="tl__title">Firmware v4.0.0 opens the first exposure window</div>
              <div class="tl-body">
                Firmware v4.0.0 ships for Mk2 and Mk3, opening the first exposure window. Its normal seed-generation path XORs output from the MicroPython and libngu Yasmarang generators before hashing. The vendor's later disclosure history states that v4.0.0 was built, signed and tested internally but never released publicly as a binary, making v4.0.1 the first public 4.x release; the published accounts behind the v4.0.0 boundary are set out on <a href="/record/firmware/">the firmware page</a>.
                <Claim basis="reported" contested scope="The v4.0.0 source and release record and its seed-generation path; the vendor states the v4.0.0 binary was never publicly released" source="Block's engineering disclosure, which dates the affected path to released firmware v4.0.0 on 17 March 2021; Galaxy Research's captured statement that the vulnerable firmware shipped 17 March 2021 around block 674,951; Coinkite security disclosure history, held capture of 5 Aug 2026" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2022-03') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">March 2022</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2022-03-11T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2022-03-11T00:00:00Z')}>
              <div class="tl-date">11 and 14 Mar 2022</div>
              <div class="tl__title">The reseed API, a paid pre-release review, and Mk4 v5.0.0</div>
              <div class="tl-body">
                The <code>reseed()</code> API is added to <code>libngu</code>, and Mk4 v5.0.0 ships as the first production firmware calling <code>rng_seeding()</code> on the normal boot path. A secure-element-derived value overwrites one libngu state word, contributing at most 32 bits; other UID and timing terms remain in published models. The vendor's disclosure history records a paid private review in the same window (1 to 14 March 2022) that examined PIN derivation, rate limiting and random-number generation, and under which the runtime generator was seeded with authenticated entropy from both secure elements; it cites private correspondence this archive cannot inspect.
                <Claim basis="reported" scope="The addition of the reseed() API and the Mk4 v5.0.0 release record, as published" source="Block's engineering disclosure, which documents the Mk4 secure-element reseed and tabulates Mk4 production firmware from v5.0.0 onward, held capture of 31 Jul 2026; Coinkite's disclosure history records the same first-shipped version" href="/record/sources/block-disclosure/" compact />
                <Claim basis="reported" scope="The March 2022 paid private review and its RNG work, as recorded by the vendor; the underlying correspondence is not inspectable here" source="Coinkite security disclosure history, held capture of 5 Aug 2026" href="/record/sources/coinkite-historical-disclosures/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2023-06') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">June 2023</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-bad" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2023-06-26T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2023-06-26T00:00:00Z')}>
              <div class="tl-date">26 Jun 2023</div>
              <div class="tl__title">v4.1.9, the last Mk3 release for three years</div>
              <div class="tl-body">
                Firmware v4.1.9 ships. For the next three years it remains the latest published Mk3 release, and it contains the affected path.
                <Claim basis="reported" scope="The v4.1.9 release record and its status as the latest published Mk3 release until 2026, as published" source="Coinkite's security disclosure history, which cites the Mk3 release history and gives the affected Mk2 and Mk3 range as 4.0.1 to 4.1.9 with the fix in 4.2.0, held capture of 5 Aug 2026" href="/record/sources/coinkite-historical-disclosures/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2024-01') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">January 2024</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2024-01-10T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2024-01-10T00:00:00Z')}>
              <div class="tl-date">10 Jan 2024</div>
              <div class="tl__title">A cleanup touches the call site, not the source</div>
              <div class="tl-body">
                Commit <code>024655be6bbfc0fd2e142f2e3b4ba39eb95e96a4</code> replaces the <code>random.bytes()</code> wrapper with a direct <code>ngu.random.bytes()</code> call and switches to <code>sha256d()</code>. The cleanup changed the call site but not the linked RNG source, so affected builds span every release from v4.0.0 until the 2026 hotfix. <a href="/how-it-broke/">How it broke</a> sets out the published accounts of both versions.
                <Claim basis="reported" scope="The 10 January 2024 cleanup commit and the unchanged linked RNG source across both versions, as published" source="Block's engineering disclosure, which reconstructs the generation path including the sha256d hashing step over the unchanged deterministic fallback, held capture of 31 Jul 2026" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2024-02') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">February 2024</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2024-02-08T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2024-02-08T00:00:00Z')}>
              <div class="tl-date">8 Feb 2024</div>
              <div class="tl__title">First public Q firmware</div>
              <div class="tl-body">
                First public Q firmware, v0.0.3Q, with production v1.0.0Q on 10 March 2024. Every Q build in the published release history before v1.5.0Q contains the affected path.
                <Claim basis="reported" scope="The Q release history from v0.0.3Q onward and the affected path in every published Q build before v1.5.0Q, as published" source="Block's engineering disclosure, which tabulates all production Q firmware as carrying the same fallback and reseed construction, held capture of 31 Jul 2026; Coinkite's disclosure history cites the public Q release history" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-03') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">March 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-03-10T00:00:00Z') ? '' : undefined} hidden={lmBeyond('2026-03-10T00:00:00Z')}>
              <div class="tl-date">10 Mar 2026</div>
              <div class="tl__title">COLDCARD Mk5 launches</div>
              <div class="tl-body">
                COLDCARD Mk5 launches on firmware v5.5.0 and uses the Mk4-class generation path. Its pre-hotfix releases are affected under the same published candidate-space models.
                <Claim basis="reported" scope="The Mk5 launch release and its place in the Mk4-class generation path, as published" source="Block's engineering disclosure, which tabulates all production Mk5 firmware under the same construction, held capture of 31 Jul 2026; Coinkite's disclosure history scopes Mk4/Mk5 releases before 5.6.0 as affected" href="/record/sources/block-disclosure/" compact />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-07-30') return (
        <section class="tlgroup" id="sweeps-30-july" data-gord={s.gord}>
          <h2 class="tlgroup__h">30 July 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-bad" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-07-30T01:10:20Z') ? '' : undefined} hidden={lmBeyond('2026-07-30T01:10:20Z')}>
              <div class="tl-date"><TimestampRange start="2026-07-30T01:10:20Z" end="2026-07-30T01:51:26Z" seconds /></div>
              <div class="tl__title">The sweeps, before anything was published</div>
              <div class="tl-body">
                Galaxy later reported a 41-minute window covering 1,196 counted addresses and {fig('galaxyGrossBtc')}, beginning in block 960,183.
                <Claim basis="reported" captured="1 Aug 2026" contested scope="Galaxy's 41-minute wider window, address count and BTC estimate" source="Galaxy Research primary X post, preserved in the archive" href="/record/sources/glxyresearch-flow-map/" />
                Within it, the 500-transaction set reported by TFTC and Rob Hamilton spans about 15 minutes: a reported 1,324 UTXOs spent from 500 source addresses, with TFTC publishing <strong>{fig('sweptBtc')}</strong> received by one first collector and Hamilton reporting approximately 594.48 BTC moved and about 562 BTC consolidated.
                <Claim basis="reported" scope="The 500-transaction set's reported UTXO count, duration, collector receipt and consolidation figure" source="Captured TFTC report and Rob Hamilton primary post" href="/record/sources/tftc-who-must-move/" />
                Bitcoin Optech states 29 July without a timezone; a US-local date is possible but not established in the newsletter. See <a href="/record/funds/">funds accounting</a> for the difference between the published totals and the sets they count.
                <CaptureThumb id="glxyresearch-flow-map" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} id="day-one-scope" data-beyond={lmBeyond('2026-07-30T18:00:00Z') ? '' : undefined} hidden={lmBeyond('2026-07-30T18:00:00Z')}>
              <div class="tl-date">30 Jul 2026, Coinkite</div>
              <div class="tl__title">The vendor scopes the issue to Mk3</div>
              <div class="tl-body">
                <a href="/record/sources/coinkite-mk3-advisory/">Coinkite's Mk3 Security Advisory</a> (<a href="https://blog.coinkite.com/coldcard-mk3-seed-generation-warning/" rel="noopener nofollow">original</a>) scoped the issue to Mk3 and said Mk4, Q and Mk5 were "not affected based on our early analysis". That earlier state is recovered from the Internet Archive; this project's own capture of the page began on 1 August. The publication time within the day is not established, so this entry is placed beside the other day-one publication rather than in time order.
                <Claim basis="verified" contested scope="The affected-model statement in Coinkite's first advisory" source="Coinkite Mk3 Security Advisory; original state recovered through the Internet Archive" href="/record/sources/coinkite-mk3-advisory/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-07-30T18:05:00Z') ? '' : undefined} hidden={lmBeyond('2026-07-30T18:05:00Z')}>
              <div class="tl-date">30 Jul 2026, Block</div>
              <div class="tl__title">Block publishes a wider affected range</div>
              <div class="tl-body">
                <a href="/record/sources/block-disclosure/">Block's engineering report</a> (<a href="https://engineering.block.xyz/blog/predictable-rng-fallback-and-32-bit-reseed-in-coldcard-firmware" rel="noopener nofollow">original</a>) published a wider affected-firmware range and described active exploitation. Block states that it published before the vendor's analysis was complete because it believed exploitation was active. The two day-one publications therefore gave different answers about Mk4-class devices.
                <Claim basis="reported" contested scope="Block's published affected-firmware range and exploitation account" source="Block engineering report, published 30 Jul 2026; the firmware range is separately checked against source" href="/record/sources/block-disclosure/" />
              </div>
              <div class="ve-card ve-card--amber">
                <div class="ve-card__label lbl-amber">Interpretation limit</div>
                <p>
                  The record establishes the disagreement and the wording of each statement.
                  It does not establish why the analyses differed or what any individual
                  owner read before acting.
                </p>
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-07-31') return (
        <section class="tlgroup" id="july-31" data-gord={s.gord}>
          <h2 class="tlgroup__h">31 July 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-07-31T00:03:31Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T00:03:31Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T00:03:31Z" seconds /></div>
              <div class="tl__title">Block's preliminary earlier-wave scan</div>
              <div class="tl-body">
                <a href="/record/sources/clay-earlier-waves-thread/">Clay Garrett published Block's preliminary earlier-wave scan</a>, reporting <strong>{fig('earlierTxs')} additional transactions</strong> with the same stated fingerprint as the known wave: 204 sweeps in block 960,183 and 491 in block 960,185, netting <strong>{fig('earlierBtc')}</strong> to three first collectors. The thread describes a scan of 888,661 transactions. This site's own privacy-safe recheck of the published sets places those blocks inside Galaxy's 41-minute window and before the 500-transaction subset. Block explicitly said it had not confirmed a relationship between those transactions and the drain, so the common-operator attribution remains unverified.
                <Claim basis="reported" scope="Block's preliminary 695-transaction fingerprint match, counts and net first-collector amount, including its unconfirmed relationship to the drain" source="Clay Garrett and Block engineering, captured primary X thread, 31 Jul 2026" href="/record/sources/clay-earlier-waves-thread/" />
                <CaptureThumb id="clay-earlier-waves-thread" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-07-31T03:44:44Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T03:44:44Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T03:44:44Z" seconds /></div>
              <div class="tl__title">Unchained recommends rotating COLDCARD-generated keys</div>
              <div class="tl-body">
                <a href="https://x.com/unchained/status/2083036112449163618" rel="noopener nofollow">Unchained recommended rotating any COLDCARD-generated key</a> to one generated on a different device. It identified two affected keys in a 2-of-3 vault as the most severe case and said one affected key is normally below threshold, while still recommending replacement.
                <Claim basis="reported" captured="1 Aug 2026" scope="Unchained's public client guidance" source="Unchained, preserved X capture" href="/record/sources/unchained-guidance/" />
                <CaptureThumb id="unchained-guidance" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-07-31T05:17:00Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T05:17:00Z')}>
              <div class="tl-date"><TimestampRange start="2026-07-31T05:17:00Z" end="2026-07-31T05:19:00Z" /></div>
              <div class="tl__title">Hotfix releases signed for Q, Mk4 and Mk5</div>
              <div class="tl-body">
                The signed-release record timestamps Q hotfix v1.5.0Q at 05:17 UTC and Mk4/Mk5 hotfix v5.6.0 at 05:18 UTC. Source release commit <code>3238f6fd9977eed786012d0034a04d888c3263bb</code> followed at 05:19:10 UTC with the note: "No new features but will generate entropy correctly." The wording is about what the device will generate next; it does not repair already generated seeds. The held record covers the vendor's published releases, not the contents of the distributed binaries.
                <Claim basis="reported" scope="The vendor-published Mk4/Mk5/Q hotfix release record and source-commit note, not binary contents" source="The vendor's signed-release record and release commit as published; the held downloads-page capture of 1 Aug 2026 lists 5.6.0 and 1.5.0Q as current, and the vendor's disclosure history records the same fixed versions" href="/record/sources/coldcard-downloads/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-07-31T05:20:00Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T05:20:00Z')}>
              <div class="tl-date">30 Jul 2026, publisher date; expanded-scope time unresolved</div>
              <div class="tl__title">The entropy backgrounder shows an expanded scope</div>
              <div class="tl-body">
                Coinkite's <a href="/record/sources/coinkite-backgrounder/">entropy technical backgrounder</a> (<a href="https://blog.coinkite.com/entropy-technical-backgrounder/" rel="noopener nofollow">original</a>) displays a 30 July publication date. In the state held on 1 August it includes Mk4, Mk5 and Q and presents scenarios near 72 bits for those models and 40 bits for Mk3. The first appearance of that expanded scope has not been established, so its ordering relative to the 31 July 05:19 UTC firmware commit remains unresolved. The entry is placed beside that commit rather than in date order, because there is no established time to sort it by.
                <Claim basis="reported" captured="1 Aug 2026" contested scope="Coinkite's expanded affected scope and published candidate-space models; not the first-publication time" source="Coinkite entropy technical backgrounder; source-level affected ranges are checked separately" href="/record/sources/coinkite-backgrounder/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={4} data-beyond={lmBeyond('2026-07-31T11:37:00Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T11:37:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T11:37:00Z" /></div>
              <div class="tl__title">The vendor directs affected users to model-specific migration</div>
              <div class="tl-body">
                An <a href="/record/sources/coldcard-expanded-scope/">official COLDCARD update</a> publicly directs users of affected Mk3, Mk4, Mk5 and Q firmware toward model-specific migration: Mk3 users on v4.0.1 or later without at least 50 private independent dice rolls should migrate, and affected Mk4, Mk5 and Q users should update before generating a new seed. Its Mk3 wording starts at v4.0.1, while Block's published analysis dates the affected path to released firmware v4.0.0.
                <Claim basis="reported" captured="1 Aug 2026" contested scope="The vendor's expanded public scope and migration direction, including its v4.0.1 Mk3 boundary" source="Official COLDCARD X update; the disagreement with Block's published v4.0.0 boundary is presented on the firmware page" href="/record/sources/coldcard-expanded-scope/" />
                <CaptureThumb id="coldcard-expanded-scope" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={5} data-beyond={lmBeyond('2026-07-31T13:23:11Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T13:23:11Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T13:23:11Z" seconds /></div>
              <div class="tl__title">Galaxy publishes the wider attribution</div>
              <div class="tl-body">
                <a href="https://x.com/glxyresearch/status/2083181683067506899" rel="noopener nofollow">Galaxy Research published the wider {fig('galaxyGrossBtc')} estimate</a> and attributed 1,196 counted addresses in blocks 960,183 to 960,191 to the same operator. The exact Galaxy address-counting method and the underlying transaction list are not published.
                <Claim basis="reported" captured="1 Aug 2026" scope="Galaxy's wider-set attribution and estimate" source="Galaxy Research primary X post, preserved X capture" href="/record/sources/glxyresearch-flow-map/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={6} data-beyond={lmBeyond('2026-07-31T13:43:05Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T13:43:05Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T13:43:05Z" seconds /></div>
              <div class="tl__title">Mk3 firmware 4.2.0 announced</div>
              <div class="tl-body">
                The <a href="/record/sources/coldcard-mk3-hotfix-update/">official Mk3 update</a> announces firmware <strong>4.2.0</strong> as available. The 07:30 UTC advisory state had described a final Mk3 release as under evaluation rather than committed, contingent on validating a sufficiently safe upgrade path, and told users not to wait for it. The vendor downloads page checked on 5 August lists 4.2.0 as current for "COLDCARD Mk3 and Mk2". This archive has not installed the release on either model or independently checked the binary.
                <Claim basis="reported" scope="The vendor's availability announcement for Mk3 4.2.0 and downloads-page listing for Mk2 and Mk3" source="Captured official COLDCARD X update and vendor downloads page; source-level fix and binary limitations are documented separately" href="/record/firmware/" />
                <CaptureThumb id="coldcard-mk3-hotfix-update" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={7} data-beyond={lmBeyond('2026-07-31T15:42:23Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T15:42:23Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T15:42:23Z" seconds /></div>
              <div class="tl__title">NVK apologises on behalf of Coinkite</div>
              <div class="tl-body">
                <a href="https://x.com/nvk/status/2083216713693151552" rel="noopener nofollow">NVK published an apology on behalf of Coinkite</a>, accepted responsibility for the firmware bug, committed to a technical postmortem covering why their own review missed it, and offered written incident summaries and available transaction data to affected users for police reports and insurance claims.
                <Claim basis="reported" captured="1 Aug 2026" scope="NVK's apology and stated commitments" source="NVK, preserved X capture" href="/record/sources/nvk-apology/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={8} data-beyond={lmBeyond('2026-07-31T16:54:38Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T16:54:38Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T16:54:38Z" seconds /></div>
              <div class="tl__title">Edge hotfixes announced</div>
              <div class="tl-body">
                The <a href="/record/sources/coldcard-edge-hotfix-update/">official Edge update</a> announces 6.6.0X for Mk4/Mk5 and 6.6.0QX for Q. Mk3, Mk4, Mk5 and Q then have named vendor fix releases. The binaries have not been independently checked here.
                <Claim basis="reported" scope="The official availability announcement for Edge 6.6.0X and 6.6.0QX" source="Captured official COLDCARD X update; binary limitations are documented separately" href="/record/firmware/" />
                <CaptureThumb id="coldcard-edge-hotfix-update" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={9} data-beyond={lmBeyond('2026-07-31T17:42:45Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T17:42:45Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T17:42:45Z" seconds /></div>
              <div class="tl__title">Block reports a service-provider trail</div>
              <div class="tl-body">
                <a href="https://x.com/clay_garrett/status/2083247006139503065" rel="noopener nofollow">Block's Clay Garrett reported</a> that the operator used <strong>a paid account at a well-known blockchain-services provider</strong> to query the source addresses during the sweeps, and that the provider's internal logs matched the suspected workflow "with extraordinary specificity, including the number, timing and sequence of requests". Shared with authorities. He said Block had seen no evidence the provider knowingly participated in or facilitated the suspected theft.
                <Claim basis="reported" captured="1 Aug 2026" scope="Block's account of the service-provider queries and its non-participation qualification" source="Clay Garrett, complete three-post X thread preserved in the archive" href="/record/sources/clay-attribution/" />
                <Claim basis="reported" scope="The later operator attribution and public accounts of how the bug may have been discovered" source="Captured statements from Block, Coinkite and named researchers" href="#july-31" compact />
                <CaptureThumb id="clay-attribution" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={10} data-beyond={lmBeyond('2026-07-31T21:18:10Z') ? '' : undefined} hidden={lmBeyond('2026-07-31T21:18:10Z')}>
              <div class="tl-date"><Timestamp iso="2026-07-31T21:18:10Z" seconds /></div>
              <div class="tl__title">Configuration-specific multisig guidance</div>
              <div class="tl-body">
                <a href="https://x.com/KLoaec/status/2083301216050700780" rel="noopener nofollow">Kevin Loaec published configuration-specific guidance</a> for multisig and miniscript, including the condition where affected COLDCARD keys meet the spending threshold. The post described Taproot and private transaction submission as potentially relevant in some cases, not as universal guarantees.
                <Claim basis="reported" captured="1 Aug 2026" scope="Loaec's dated multisig and miniscript guidance" source="Kevin Loaec, preserved X capture" href="/record/sources/kloaec-multisig/" />
                <CaptureThumb id="kloaec-multisig" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-01') return (
        <section class="tlgroup" id="august-1" data-gord={s.gord}>
          <h2 class="tlgroup__h">1 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-01T05:28:59Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T05:28:59Z')}>
              <div class="tl-date">captured <Timestamp iso="2026-08-01T05:28:59Z" seconds /></div>
              <div class="tl__title">A community tracker widens its headline</div>
              <div class="tl-body">
                The community <a href="/record/sources/coldcard-watch/">coldcard-watch tracker</a> expands its headline from the first 1,195-address episode to two episodes totalling 2,321 addresses and 1,128.4717 BTC. This records the tracker's changed attribution, placed at its capture time because the tracker's own edit time is not published. The relationship of the later 45.9 BTC cluster to the principal incident set remains unverified.
                <Claim basis="reported" captured="1 Aug 2026" scope="The coldcard-watch tracker's expanded two-episode headline and its stated totals" source="coldcard-watch community tracker, held capture state of 1 Aug 2026" href="/record/sources/coldcard-watch/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-01T11:21:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T11:21:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T11:21:00Z" /></div>
              <div class="tl__title">The vendor asks owners to treat migration as urgent</div>
              <div class="tl-body">
                Coinkite <a href="/record/sources/coldcard-urgent-migration-appeal/">ask owners to treat migration as urgent</a>: follow the advisory for the model, upgrade the device, generate a new seed, move funds carefully, and pass the message to owners who are less online. The post quotes the vendor's 31 July urgent update, which states the Mk3 boundary as 4.0.1 and later and carves out seeds created with at least 50 private, independent dice rolls.
                <Claim basis="reported" scope="The vendor's urgent-migration appeal and the boundary conditions in the update it quotes" source="Coinkite, captured official X post, 1 Aug 2026" href="/record/sources/coldcard-urgent-migration-appeal/" />
                <CaptureThumb id="coldcard-urgent-migration-appeal" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-08-01T12:29:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T12:29:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T12:29:00Z" /></div>
              <div class="tl__title">A reported Mk4-class drain</div>
              <div class="tl-body">
                Kevin Loaec of Wizardsardine <a href="/record/sources/kloaec-mk4-class-drain-report/">reports</a> that Mk4, Mk5 and Q wallets are "now actively drained", quoting Tomer Strolight's account of a duress wallet, deliberately left funded on a COLDCARD Mk4 seed and swept overnight to <code>bc1qzm5pauxyv7t7vqstzpumqcn066wfjsmev34mf3</code>. The same post argues that breaking an Mk4 is harder than breaking a weak passphrase, so Mk3 seeds behind a passphrase at or under roughly 32 bits are at immediate risk. This is a reported third-party account of a single wallet, and no held source corroborates the sweep. The named destination does appear in held captures of a community tracker as a 1 August vault holding 0.33203236 BTC from 16 sweeps, and a later capture of that tracker records its Mk4 attribution as withdrawn in favour of an Mk3-origin seed. The device model behind a sweep is not visible on chain.
                <Claim basis="reported" contested scope="The 1 August account that Mk4, Mk5 and Q wallets were being actively drained, and the honeypot sweep quoted with it" source="Kevin Loaec's captured post quoting Tomer Strolight; a community tracker's later held capture records the Mk4 attribution as withdrawn in favour of an Mk3-origin seed" href="/record/sources/kloaec-mk4-class-drain-report/" compact />
                <CaptureThumb id="kloaec-mk4-class-drain-report" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-08-01T13:35:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T13:35:00Z')}>
              <div class="tl-date">
                published <Timestamp iso="2026-08-01T13:35:00Z" />; captured <Timestamp iso="2026-08-01T14:02:34Z" seconds />
              </div>
              <div class="tl__title">The advisory replaces its blanket warning with two conditions</div>
              <div class="tl-body">
                <a href="/record/sources/coinkite-mk3-advisory/">Coinkite's Mk3 Security Advisory</a> carries a third dated update. It replaces the earlier blanket warning that Mk3 4.0.1 to 4.1.9 users' funds "may be at risk" with a conditional statement: funds are at risk "if the seed was created without at least 50 fair, independent, private dice rolls and the funded wallet is not protected by a strong, unique BIP-39 passphrase". The passphrase section moved in both directions in the same edit. It now says the reduced seed entropy alone is not enough to reach funds in a passphrase wallet and that "an attacker must also discover the passphrase", and it also says a strong passphrase "does not repair the affected seed", that passphrase users "should also migrate as soon as practical", and that an uncertain passphrase means treating the funds as at risk and migrating immediately. The <a href="/record/sources/coinkite-backgrounder/">entropy backgrounder</a> carries the same dated update, a paragraph setting out what counts as a qualifying passphrase, and a new sentence that for funded wallets with neither the dice entropy nor such a passphrase "the reduced search space is a direct security risk, not a theoretical possibility". In the same period the site-wide banner on the <a href="/record/sources/coldcard-downloads/">downloads</a> and <a href="/record/sources/coinkite-terms/">terms</a> pages changed from "Seeds generated on firmware 4.0.1 or later may be at risk" to "Seeds generated on firmware 4.0.1 (2021 or later) are at risk".
                <Claim basis="verified" scope="The wording of the 1 August advisory and backgrounder update and of the changed site-wide banner" source="Held captures of the Coinkite Mk3 advisory, entropy backgrounder, downloads page and terms page, with diffs against the preceding held states" href="/record/sources/coinkite-mk3-advisory/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={4} data-beyond={lmBeyond('2026-08-01T15:45:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T15:45:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T15:45:00Z" /></div>
              <div class="tl__title">Wizardsardine publish a long-form post-mortem</div>
              <div class="tl-body">
                Wizardsardine publish a <a href="/record/sources/wizardsardine-postmortem/">long-form post-mortem</a>, announced by <a href="/record/sources/kloaec-wizardsardine-postmortem/">Kevin Loaec</a>. It addresses Liana and multisig configurations first, then reconstructs the flaw, and argues the incident is worse than commonly understood because owners with dice-generated seeds still have device features that depend on the same generator. Wizardsardine sells Liana, a competing wallet product, and the authors describe the post as written quickly and invite corrections.
                <Claim basis="reported" scope="The publication and argument of Wizardsardine's post-mortem, including the authors' stated conflict and speed caveats" source="Wizardsardine post-mortem and captured announcement post, 1 Aug 2026" href="/record/sources/wizardsardine-postmortem/" />
                <CaptureThumb id="kloaec-wizardsardine-postmortem" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={5} data-beyond={lmBeyond('2026-08-01T15:47:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T15:47:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T15:47:00Z" /></div>
              <div class="tl__title">Exposure beyond seed generation is claimed</div>
              <div class="tl-body">
                Loaec separately <a href="/record/sources/kloaec-derived-feature-exposure/">states</a> that owners who imported a seed or generated one with dice are also exposed if they used certain COLDCARD features. The features are enumerated in an attached graphic that did not render in the held capture, so the list itself is not established from what is held here. The claim extends the incident beyond seed generation into derived material; <a href="/how-it-broke/blast-radius/">what else the generator touched</a> collects the published feature-path findings.
                <Claim basis="reported" scope="Loaec's statement that imported or dice-generated seeds are also exposed through certain COLDCARD features; the attached feature list did not render in the held capture" source="Kevin Loaec, captured X post, 1 Aug 2026" href="/record/sources/kloaec-derived-feature-exposure/" />
                <CaptureThumb id="kloaec-derived-feature-exposure" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={6} data-beyond={lmBeyond('2026-08-01T16:09:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T16:09:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T16:09:00Z" /></div>
              <div class="tl__title">A separate matter involving the same party</div>
              <div class="tl-body">
                Block's Clay Garrett <a href="/record/sources/claygarrett-bitkey-initial-findings/">publishes initial findings</a> on a reported vulnerability in Block's own Bitkey product, disclosed to Block by 1440000bytes. This is not the COLDCARD RNG defect and does not bear on it. Block states that exploitation would require exceptional circumstances during a narrow window in inheritance setup, that an attacker would not obtain enough cryptographic material to reach funds, that it sees no risk of remote drains, and that a mobile-app patch would be submitted the same day.
                <Claim basis="reported" scope="Clay Garrett's initial findings on the separately disclosed Bitkey vulnerability and Block's stated risk limits" source="Clay Garrett, captured X post, 1 Aug 2026" href="/record/sources/claygarrett-bitkey-initial-findings/" />
                <CaptureThumb id="claygarrett-bitkey-initial-findings" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={7} data-beyond={lmBeyond('2026-08-01T16:25:37Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T16:25:37Z')}>
              <div class="tl-date">31 Jul to 1 Aug 2026</div>
              <div class="tl__title">Legal claims begin organising</div>
              <div class="tl-body">
                A <a href="/record/sources/stoltmann-claimant-page/">Stoltmann Law claimant-intake page</a>, published 31 July and self-labelled as legal advertising, solicits COLDCARD incident victims as potential claimants; client solicitation after a mass loss event is ordinary legal marketing, and the page is held for provenance, not endorsed. On 1 August, Thomas Braziel of 117 Partners <a href="/record/sources/bkclaims-victim-intake/">asks affected users to make contact</a> to assess potential legal options, including product liability and class or group litigation, plus asset recovery efforts, requesting country, purchase channel, model, loss size and contact details. This is a solicitation by a recovery professional with a direct business interest in sign-ups.
                <Claim basis="reported" scope="The existence, publication date and self-described purpose of the Stoltmann Law claimant-intake page" source="Stoltmann Law claimant page, held browser capture of 4 Aug 2026; surfaced through an Internet Archive snapshot of 3 Aug 2026" href="/record/sources/stoltmann-claimant-page/" />
                <Claim basis="reported" captured="4 Aug 2026" scope="Braziel's 1 August victim-intake solicitation and the information it requests" source="Thomas Braziel (117 Partners), captured X post, 1 Aug 2026" href="/record/sources/bkclaims-victim-intake/" />
                <CaptureThumb id="bkclaims-victim-intake" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={8} data-beyond={lmBeyond('2026-08-01T16:35:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T16:35:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T16:35:00Z" /></div>
              <div class="tl__title">bitcoin++ announces a commit-history walkthrough</div>
              <div class="tl-body">
                bitcoin++ Insider Edition <a href="/record/sources/btcpp-dettmer-analysis-announcement/">announce</a> Dustin Dettmer's <a href="/record/sources/btcpp-dettmer-commit-history/">commit-history walkthrough</a>, "When random.bytes() runs but doesn't work". It reads the firmware history around the disabled hardware-RNG guard and the call chain that left seed generation on the software generator.
                <Claim basis="reported" scope="The announcement and subject of Dettmer's commit-history walkthrough" source="bitcoin++ Insider Edition, captured announcement, 1 Aug 2026" href="/record/sources/btcpp-dettmer-analysis-announcement/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={9} data-beyond={lmBeyond('2026-08-01T18:35:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T18:35:00Z')}>
              <div class="tl-date">
                published <Timestamp iso="2026-08-01T18:35:00Z" />; captured <Timestamp iso="2026-08-01T18:44:33Z" seconds />
              </div>
              <div class="tl__title">A fourth revision brings the Mk2 inside the advisory</div>
              <div class="tl-body">
                A fourth dated update brings the Mk2 inside the advisory's own text. Every Mk3-only statement about the defect and about its fix is rewritten to name both models. The affected range becomes "The issue is present on Mk2 and Mk3 firmware versions 4.0.1 through 4.1.9 inclusive"; the at-risk sentence becomes "a seed generated on Mk2 or Mk3 version 4.0.1 (March 2021) through 4.1.9"; the fixed-firmware list gives "Mk2/Mk3: version 4.2.0 or later"; and the release is described as "Fixed Mk2/Mk3 firmware version 4.2.0", to be installed from the "official Mk2/Mk3 download page". The one-device migration section, the optional dice-only section and the closing migration steps are rewritten the same way, so the procedures the advisory sets out now address an Mk2 owner directly. The <a href="/record/sources/coinkite-backgrounder/">entropy backgrounder</a> carries the same dated update and the same substitution, including that the active PRNG on "Mk2 and Mk3" was seeded primarily from device and timing state, and "Version 4.2.0 for Mk2 and Mk3" among the released hotfixes. Until this revision the vendor downloads-page listing was the only vendor evidence placing the Mk2 in either the affected range or the hotfix. The published lower bound is unchanged at 4.0.1 for both models, so the <a href="/record/firmware/">v4.0.0 boundary difference</a> stands.
                <Claim basis="verified" scope="The fourth revision's substitution of Mk2 and Mk3 for Mk3 throughout the affected range, the fixed release and the migration sections of both the advisory and the backgrounder" source="Held captures of the Coinkite Mk3 advisory and entropy technical backgrounder taken at 18:44 UTC on 1 August 2026, with diffs against the states held at 14:02 UTC the same day" href="/record/sources/coinkite-mk3-advisory/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={10} data-beyond={lmBeyond('2026-08-01T18:38:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-01T18:38:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-01T18:38:00Z" /></div>
              <div class="tl__title">Galaxy identifies a third wave and revises its total</div>
              <div class="tl-body">
                Galaxy Research <a href="/record/sources/glxyresearch-third-wave-revision/">identify a third sweep wave</a> of <strong>{fig('thirdWaveBtc')}</strong> and revise their estimated observed size of the incident to <strong>{fig('galaxyRevisedTotalBtc')}</strong> across {fig('galaxyRevisedAddresses')}, superseding the roughly 1,083 BTC total they published on 31 July. The same thread reports <strong>{fig('attackerHoldingsBtc')}</strong> under attacker control with all endpoint attacker addresses fully unspent on chain, and carries Galaxy's <a href="/record/sources/glxyresearch-methodology-disclaimer/">own method limit</a>: the work derives solely from block data and the unspent-output set, and Galaxy has not tested whether the addresses it identifies as possible victims were in fact generated with low entropy. Galaxy also <a href="/record/sources/glxyresearch-firmware-block-boundary/">states</a> that the vulnerable firmware shipped on 17 March 2021 around block 674,951 and that no coin identified in waves 1 to 3 was created before that block; what that means for the published version ranges is on <a href="/record/firmware/">the firmware page</a>. Galaxy's scope is wider than the 30 July set its 31 July figure covered; <a href="/record/funds/">the funds-accounting page</a> keeps both as dated figures.
                <Claim basis="reported" scope="Galaxy's 1 August third wave, revised total, attacker-holdings figure and stated method limit, and its statement about the firmware ship block" source="Galaxy Research's captured 1 August thread; its scope is wider than the 30 July set and the underlying transaction and address lists are not published" href="/record/sources/glxyresearch-third-wave-revision/" compact />
                <CaptureThumb id="glxyresearch-third-wave-revision" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-02') return (
        <section class="tlgroup" id="august-2-3" data-gord={s.gord}>
          <h2 class="tlgroup__h">2 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-02T17:24:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T17:24:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T17:24:00Z" /></div>
              <div class="tl__title">Galaxy asks victims to come forward</div>
              <div class="tl-body">
                Galaxy Research <a href="/record/sources/glxyresearch-victim-outreach-update/">publish an investigation status update</a>: the wave-1 pattern came from Block engineers, while waves 2 and 3 were identified through victims coming forward. The update asks victims to share affected addresses and transaction IDs with @intangiblecoins, with no personal identifying information needed, says findings are being shared with US authorities, SEAL, exchanges and cyber investigators, and promises a substantive update.
                <Claim basis="reported" scope="Galaxy's account of how each wave was identified, its victim-outreach request and its statement about sharing findings with investigators" source="Galaxy Research, captured X update, 2 Aug 2026" href="/record/sources/glxyresearch-victim-outreach-update/" />
                <CaptureThumb id="glxyresearch-victim-outreach-update" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-02T18:04:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T18:04:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T18:04:00Z" /></div>
              <div class="tl__title">Coinkite says shipments were halted and stock destroyed</div>
              <div class="tl-body">
                Coinkite <a href="/record/sources/coldcard-shipments-halted/">state that shipments were halted</a> as soon as the vulnerability was confirmed, and that remaining units carrying affected firmware were destroyed. Customers whose devices had already shipped were emailed the advisory and migration steps. The same post states that SATSCARD, OPENDIME and TAPSIGNER use different codebases and are not affected. <a href="/record/sources/tftc-shipments-halted/">TFTC repeated the same facts</a> just under two and a half hours later; the vendor post is the primary statement.
                <Claim basis="reported" scope="The vendor's shipments-halted and inventory-destruction statement, its customer-email account and its not-affected statement for SATSCARD, OPENDIME and TAPSIGNER" source="Coinkite, captured official X post, 2 Aug 2026; TFTC's later secondary report is held separately" href="/record/sources/coldcard-shipments-halted/" />
                <CaptureThumb id="coldcard-shipments-halted" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-08-02T19:51:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T19:51:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T19:51:00Z" /></div>
              <div class="tl__title">The store disclaimer is clarified</div>
              <div class="tl-body">
                Replying to a question about the disclaimer added to its store, Coinkite <a href="/record/sources/coldcard-disclaimer-clarification/">say the notice exists</a> so previous buyers are aware of the incident. An earlier <a href="/record/sources/pledditor-remaining-stock/">community claim</a> that remaining stock stayed on sale with an added disclosure, rather than sales being halted, is held separately.
                <Claim basis="reported" scope="The vendor's stated purpose of the store disclaimer" source="Coinkite, captured official X reply, 2 Aug 2026" href="/record/sources/coldcard-disclaimer-clarification/" />
                <CaptureThumb id="coldcard-disclaimer-clarification" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-08-02T20:44:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T20:44:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T20:44:00Z" /></div>
              <div class="tl__title">NVK steps down from the OpenSats board</div>
              <div class="tl-body">
                OpenSats <a href="/record/sources/opensats-nvk-board-departure/">announce that NVK is stepping down</a> from its board, effective immediately, with the board continuing at eight members until a replacement is made. The post gives no reason for the departure; its timing places it inside the incident weekend, and the post itself does not connect the two.
                <Claim basis="reported" scope="The OpenSats board departure and its stated interim board size; the post states no reason" source="OpenSats, captured X statement, 2 Aug 2026" href="/record/sources/opensats-nvk-board-departure/" />
                <CaptureThumb id="opensats-nvk-board-departure" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={4} data-beyond={lmBeyond('2026-08-02T21:13:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T21:13:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T21:13:00Z" /></div>
              <div class="tl__title">A reported passphrase-wallet loss</div>
              <div class="tl-body">
                BTC Sessions <a href="/record/sources/btcsessions-passphrase-loss-report/">reports what he describes as the first confirmed loss</a> from a Mk3 protected by a passphrase: a two-word passphrase, with the wallet drained at around 2pm on 2 August in Australian eastern time (AEST, UTC+10), which is about 04:00 UTC the same day. The post cites no transaction or address, so nothing held here can corroborate or refute it. If accurate, it would extend the observed drains to weak-passphrase wallets; the incident-specific passphrase conditions are set out in <a href="/how-it-broke/conditions/#passphrase">the technical record</a>.
                <Claim basis="reported" scope="BTC Sessions' account of a drained Mk3 two-word-passphrase wallet and its claimed timing; the post cites no transaction or address and the loss is not corroborated here" source="BTC Sessions, captured X post, 2 Aug 2026" href="/record/sources/btcsessions-passphrase-loss-report/" />
                <CaptureThumb id="btcsessions-passphrase-loss-report" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={5} data-beyond={lmBeyond('2026-08-02T23:00:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-02T23:00:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-02T23:00:00Z" /></div>
              <div class="tl__title">The vendor's Sunday statement</div>
              <div class="tl-body">
                Coinkite publish an <a href="/record/sources/coldcard-update-sunday/">"Update, Sunday" statement</a> acknowledging that the damage done is permanent and that there are hard questions about the company, describing direct customer outreach and migration help since Friday, thanking community members who helped unpaid through the weekend, and committing to continued work with the wider self-custody community.
                <Claim basis="reported" scope="The vendor's Sunday statement: its damage acknowledgement, outreach description, community thanks and forward commitment" source="Coinkite, captured official X post, 2 Aug 2026" href="/record/sources/coldcard-update-sunday/" />
                <CaptureThumb id="coldcard-update-sunday" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-03') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">3 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-03T00:51:36Z') ? '' : undefined} hidden={lmBeyond('2026-08-03T00:51:36Z')}>
              <div class="tl-date">
                <Timestamp iso="2026-08-03T00:51:36Z" /> to <Timestamp iso="2026-08-03T03:22:16Z" />
              </div>
              <div class="tl__title">A claimed fourth wave is published, then corrected twice</div>
              <div class="tl-body">
                Galaxy's intangiblecoins <a href="/record/sources/intangiblecoins-wave4-announcement/">publishes a pattern-matched fourth-wave claim</a>, followed by a <a href="/record/sources/intangiblecoins-wave4-confirmed-pastebin/">confirmed-transaction address list</a> and a second <a href="/record/sources/intangiblecoins-wave4-pending-pastebin/">pending-transaction list</a>. The opening post states 218 transactions, 462 victim addresses, 216 fresh destinations and 388.92748828 BTC across blocks 960,778 to 960,792. The pending list states another 104 sweeps, 199 victim addresses and 70.16757699 BTC, all signalling replace-by-fee. These are the author's classifications and figures, not this project's findings.
                <Claim basis="reported" scope="The original wave-4 post's transaction, address, amount and block-range figures, and the pending Pastebin's stated replace-by-fee set" source="intangiblecoins, captured original thread posts and linked Pastebin pages, 3 Aug 2026" href="/record/sources/intangiblecoins-wave4-announcement/" />
                The claim is then corrected twice in public. The <a href="/record/sources/intangiblecoins-wave4-address-correction/">first correction</a> removes six of 216 destination addresses whose years of history before block 960,183 made them unlikely attacker addresses, leaving 206 of the remainder freshly created to receive the sweeps.
                <Claim basis="reported" scope="The removal of six historical destination addresses from the circulated wave-4 list and the 206 freshly created remainder" source="intangiblecoins, captured correction post, 3 Aug 2026" href="/record/sources/intangiblecoins-wave4-address-correction/" />
                The <a href="/record/sources/intangiblecoins-wave4-multisig-correction/">second correction</a>, credited to Nunchuk, removes multisig addresses included in error: the post states wave 4 as circulated at 857 addresses and 486.11 BTC, an 89-address, 20.58 BTC multisig discount, and a surviving core of 709 addresses and 448.73 BTC, all as the author's own figures. It also states that waves 1 to 3 contain no multisig addresses, and stresses that wave 4 rests on pattern matching with no direct victim confirmation yet.
                <Claim basis="reported" scope="The multisig correction, the stated wave-4 figures as circulated and as corrected, and the author's statement that wave 4 has no direct victim confirmation" source="intangiblecoins, captured correction post credited to Nunchuk, 3 Aug 2026" href="/record/sources/intangiblecoins-wave4-multisig-correction/" />
                The wave-4 set remains unconfirmed and is not adopted by <a href="/record/funds/">the funds-accounting page</a>.
                <CaptureThumb id="intangiblecoins-wave4-multisig-correction" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-03T08:02:32Z') ? '' : undefined} hidden={lmBeyond('2026-08-03T08:02:32Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-03T08:02:32Z" /></div>
              <div class="tl__title">The community tracker moves to coldcard.rip</div>
              <div class="tl-body">
                Kevin Kelbie <a href="/record/sources/kevinkelbie-tracker-move/">announces the on-chain tracker is moving</a> from its railway deployment to the dedicated domain <a href="/record/sources/coldcard-rip-tracker/">coldcard.rip</a>. The rebuilt tracker reorganises the incident into ten waves: the three first-night waves matching Block's published totals, the 31 July 45.9 BTC cluster integrated as its own wave, and six further waves through block 960,737, each anchored with named claimant, Chainabuse and Galaxy evidence. Its 3 August snapshot states 1,433.13 BTC swept from 5,477 addresses. The tracker describes itself as AI-compiled and not independently fact-checked, and its totals are not adopted by <a href="/record/funds/">the funds-accounting page</a>.
                <Claim basis="reported" captured="3 Aug 2026" scope="Kelbie's announcement of the tracker's move to coldcard.rip" source="Kevin Kelbie, captured X post, 3 Aug 2026" href="/record/sources/kevinkelbie-tracker-move/" />
                <Claim basis="reported" captured="3 Aug 2026" scope="The rebuilt tracker's ten-wave organisation and its stated swept totals, which the operator describes as AI-compiled and not independently fact-checked" source="coldcard.rip incident tracker, held capture state of 3 Aug 2026" href="/record/sources/coldcard-rip-tracker/" />
                <CaptureThumb id="kevinkelbie-tracker-move" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-08-03T15:57:46Z') ? '' : undefined} hidden={lmBeyond('2026-08-03T15:57:46Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-03T15:57:46Z" /></div>
              <div class="tl__title">The legal strategy narrows, and a public warning follows</div>
              <div class="tl-body">
                Thomas Braziel <a href="/record/sources/bkclaims-legal-strategy-update/">publishes a strategy update</a> after a call with Canadian counsel: leaning away from a traditional class action toward a private Canadian lawsuit brought by roughly 10 to 30 larger claimants, with product liability and negligence theories under review and collectability named as the larger question. The update describes litigation-funding expectations, with affected victims given the first opportunity to participate, and points readers to the same Telegram group. That evening, L0la L33tz <a href="/record/sources/l0lal33tz-braziel-court-record/">warns victims away from Braziel</a>, quoting a Delaware court's findings in an earlier receivership (falsified records, manufactured account statements, $1.9M restitution ordered, no criminal indictment) and linking the opinion, and <a href="/record/sources/l0lal33tz-braziel-lying-claim/">then claims</a> Braziel is misleading victims when he describes that matter as settled, citing filings showing him removed from the receivership with the court reserving further proceedings. Braziel's own posts describe the same matter as settled with an exceptional outcome; the dispute is attributed here, not adjudicated.
                <Claim basis="reported" captured="4 Aug 2026" scope="Braziel's 3 August strategy update: the private-suit direction, claimant count, legal theories, collectability framing and funding expectations" source="Thomas Braziel (117 Partners), captured X post, 3 Aug 2026" href="/record/sources/bkclaims-legal-strategy-update/" />
                <Claim basis="reported" contested captured="4 Aug 2026" scope="L0la L33tz's warnings about Braziel and the Delaware court findings quoted in them, against Braziel's own description of the matter as settled" source="L0la L33tz, captured X posts, 3 Aug 2026; the underlying dispute is documented in the two bkclaims entries" href="/record/sources/l0lal33tz-braziel-court-record/" />
                <CaptureThumb id="bkclaims-legal-strategy-update" />
                <CaptureThumb id="l0lal33tz-braziel-court-record" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-08-03T22:51:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-03T22:51:00Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-03T22:51:00Z" /></div>
              <div class="tl__title">Galaxy revises its top line past US$100M</div>
              <div class="tl-body">
                Galaxy Research <a href="/record/sources/glxy-losses-exceed-100m/">revise their top line again</a>: high-confidence <strong>{fig('galaxyConfirmedBtc')}</strong> stolen from {fig('galaxyConfirmedAddresses')} across three confirmed waves plus 14 smaller incidents, stated as exceeding US$100M and superseding the 1 August {fig('galaxyRevisedTotalBtc')} figure. Wave 1 is now fully confirmed through victim reports, 73 individual victims have contacted @intangiblecoins, and the 14 smaller footprints <a href="/record/sources/glxy-victim-count/">could be many different attackers</a> individually exploiting the now-known vulnerability. Including a suspected fourth wave would take the total to <strong>{fig('galaxyInclWave4Btc')}</strong>, but Galaxy <a href="/record/sources/glxy-wave4-caveat/">does not promote it</a> without victim confirmation. Galaxy states that 90 percent of stolen coins have not moved and 100 percent of waves 1 to 3 coins are unmoved, that confirmed attacker and victim addresses have been <a href="/record/sources/glxy-law-enforcement-handoff/">provided to US federal law enforcement, exchanges and compliance firms</a>, and that <a href="/record/sources/glxy-attack-ongoing/">the attack is ongoing</a>.
                <Claim basis="reported" scope="Galaxy's 3 August confirmed and wave-4-inclusive totals, confirmation basis, victim count, unmoved-coins statements, law-enforcement handoff and ongoing-attack warning" source="Galaxy Research's captured 3 August thread; the underlying transaction and address lists are not published" href="/record/sources/glxy-losses-exceed-100m/" />
                <CaptureThumb id="glxy-losses-exceed-100m" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={4} data-beyond={lmBeyond('2026-08-03T23:00:00Z') ? '' : undefined} hidden={lmBeyond('2026-08-03T23:00:00Z')}>
              <div class="tl-date">3 Aug 2026</div>
              <div class="tl__title">A Canadian industry body comments</div>
              <div class="tl-body">
                The National Crowdfunding and Fintech Association of Canada publishes <a href="/record/sources/ncfacanada-self-custody-commentary/">a commentary on what the flaw reveals about self custody</a>, the first Canadian industry-body view held here; Coinkite is Toronto based, and the incident's legal dimension runs through Ontario statutes and a proposed Canadian suit. The piece is secondary throughout: its loss figures are attributed to Galaxy Research, separately held here, and it carries its own caveat that not every wallet in those totals is confirmed to have been created with the affected firmware. Its argument, that self custody removes the custodian but not the vendor layer beneath it, is the author's position and is not adopted by this archive.
                <Claim basis="reported" scope="The NCFA commentary's publication, its attributed loss figures and its stated argument, which remains the author's position" source="NCFA Canada, held browser capture of 5 Aug 2026; published 3 Aug 2026" href="/record/sources/ncfacanada-self-custody-commentary/" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-04') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">4 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-04T06:14:34Z') ? '' : undefined} hidden={lmBeyond('2026-08-04T06:14:34Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-04T06:14:34Z" /></div>
              <div class="tl__title">A "Bitcoin Red Team" scanning effort gets going</div>
              <div class="tl-body">
                Rob Hamilton <a href="/record/sources/rob1ham-2084523368783438198/">posts a first status update</a> for what becomes known as the Bitcoin Red Team: about US$20,000 spent so far across different services, with funding secured and donations described as unnecessary, 150 repositories scanned, more than a dozen private disclosures made and critical issues found, plus a first pass on an agent harness he says the team intends to open source. Two and a half hours later calle <a href="/record/sources/callebtc-2084561246305542617/">posts his own update</a>: multiple harnesses written and a large wave of reviews launching against core Bitcoin projects, critical vulnerabilities reported to several projects in the previous 12 hours at what he describes as roughly one critical exploit per person per hour, and about US$10,000 per day in compute, with thanks to OpenSats for covering the bill. None of the findings is itemised publicly, so the counts stand as the participants' own figures. That afternoon Hamilton <a href="/record/sources/rob1ham-2084642112482496515/">adds a reassurance</a>: nothing in four days of vulnerability scanning around hardware wallets specifically, whether reviewed by him or shared with him, indicated those wallets are unsafe, a time-bounded statement about reviewed reports rather than a comprehensive security finding.
                <Claim basis="reported" captured="5 Aug 2026" scope="Hamilton's and calle's 4 August Red Team status figures: spend, repositories scanned, disclosure counts and finding rates, all self-reported with no findings itemised publicly" source="Rob Hamilton and calle, captured X posts, 4 Aug 2026" href="/record/sources/rob1ham-2084523368783438198/" />
                <Claim basis="reported" captured="5 Aug 2026" scope="Hamilton's statement that four days of hardware-wallet scanning had shown no vulnerability, a time-bounded account of reviewed reports rather than a comprehensive finding" source="Rob Hamilton, captured X post, 4 Aug 2026" href="/record/sources/rob1ham-2084642112482496515/" />
                <CaptureThumb id="rob1ham-2084523368783438198" />
                <CaptureThumb id="callebtc-2084561246305542617" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-04T12:56:51Z') ? '' : undefined} hidden={lmBeyond('2026-08-04T12:56:51Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-04T12:56:51Z" /></div>
              <div class="tl__title">James O'Beirne describes a May 2025 audit</div>
              <div class="tl-body">
                James O'Beirne <a href="/record/sources/jamesob-2084624605969350915/">gives a first-person account</a> of beginning an audit of <code>coldcard/firmware</code> in May 2025. He writes that he traced where the COLDCARD RNG was sourced from to the libngu library, doubted whether the true hardware RNG was actually in use, and judged the hardcoded yasmarang constants sloppy, advising the team to remove the library and link against libsecp256k1 directly. He says he sent a report to the COLDCARD team and was told that if something was wrong "we'd already know about it by now" and that everything was properly configured for the real boards, and that he did not follow up rigorously, which he calls a horrible mistake. No contemporaneous report artefact is attached, so the account stands as his own dated statement; nothing held here corroborates or contradicts it.
                <Claim basis="reported" captured="5 Aug 2026" scope="James O'Beirne's first-person account of his May 2025 audit, the report he describes sending and the response he describes receiving; no contemporaneous artefact is attached" source="James O'Beirne, captured X post, 4 Aug 2026" href="/record/sources/jamesob-2084624605969350915/" />
                <CaptureThumb id="jamesob-2084624605969350915" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-08-04T20:02:40Z') ? '' : undefined} hidden={lmBeyond('2026-08-04T20:02:40Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-04T20:02:40Z" /></div>
              <div class="tl__title">Coinkite publishes a security disclosure history</div>
              <div class="tl-body">
                An <a href="/record/sources/coldcardwallet-2084731768632991801/">official investigation statement</a> acknowledges that users have suffered real losses, repeats the migration conditions, describes the bug as having lived at a boundary between two unrelated submodules rather than in the parent code, and says the vendor's own AI-assisted review in the weeks before the exploit, and several frontier models tested since, did not catch it. The statement announces <a href="/record/sources/coinkite-historical-disclosures/">a security disclosure history page</a>: a vendor-written chronology self-reporting 23 security-relevant events from 2019 onward, 12 of them with public evidence of coordinated disclosure, with coverage stated through 4 August 2026. The page includes the March 2022 paid pre-release review noted in the 2022 entry above, and states its own limits: it is a chronology rather than a count of independent vulnerabilities, its "no public evidence" label means none was found in the cited record, and several entries cite private correspondence or paid review this archive cannot inspect. The page shows a 4 August 2026 last-updated date and was first captured here on 5 August.
                <Claim basis="reported" captured="5 Aug 2026" scope="The vendor's 4 August investigation statement: its loss acknowledgement, submodule-boundary account, AI-review statements and announcement of the disclosure history" source="COLDCARD, captured official X post, 4 Aug 2026" href="/record/sources/coldcardwallet-2084731768632991801/" />
                <Claim basis="verified" captured="5 Aug 2026" scope="The disclosure-history page's stated counts, coverage window, self-described limits and wording as held; the underlying private correspondence is not inspectable" source="Held capture of coinkite.com/historical-disclosures, 5 Aug 2026" href="/record/sources/coinkite-historical-disclosures/" />
                <CaptureThumb id="coldcardwallet-2084731768632991801" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-08-04T20:11:46Z') ? '' : undefined} hidden={lmBeyond('2026-08-04T20:11:46Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-04T20:11:46Z" /></div>
              <div class="tl__title">Chainalysis attributes losses geographically</div>
              <div class="tl-body">
                <a href="/record/sources/chainalysis-2084734055858282986/">Chainalysis reports</a> that bitcoin holders in Canada account for 25 percent of the losses it could geographically attribute, with Australia, the United States and Thailand also seeing major losses, citing Galaxy Research's dataset for estimates ranging as high as US$110M. The post does not publish its dataset or method, so the attribution cannot be rechecked from what is held here.
                <Claim basis="reported" captured="5 Aug 2026" scope="Chainalysis's geographic attribution of losses and its stated national shares; the underlying dataset and method are not published" source="Chainalysis, captured X post, 4 Aug 2026" href="/record/sources/chainalysis-2084734055858282986/" />
                <CaptureThumb id="chainalysis-2084734055858282986" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-05') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">5 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-05T08:58:34Z') ? '' : undefined} hidden={lmBeyond('2026-08-05T08:58:34Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-05T08:58:34Z" /></div>
              <div class="tl__title">Stolen funds are seen entering a CoinJoin, and a dispute over coordinator responsibility opens</div>
              <div class="tl-body">
                Marius OffChain <a href="/record/sources/mariusoffchain-2084892387445244196/">traces one attacker beginning to mix 64 BTC</a>: a 64 BTC input against a roughly 54 BTC output, so about 10 BTC mixed at the first hop, with the change then split into roughly 7 BTC pieces that are themselves mixed again. He names the receiving address and asks other on-chain analysts whether they have seen the pattern before; the transactions are checkable on chain but are not reproduced here. Just over two hours later tanuki42_ <a href="/record/sources/tanuki42_-2084927029430870179/">identifies the round</a> as a Wasabi Wallet CoinJoin coordinated by Kruw's centralised coordinator server, and argues that the coordinator could at any time choose to exclude the stolen coins but consistently chooses not to. That afternoon International Cyber Digest <a href="/record/sources/intcyberdigest-2085013507913687508/">reports the dispute</a>, quoting Kruw's answer, "you can't prove you've been robbed. The attacker and the legitimate owner share the same entropy", alongside ZachXBT's quoted reply to Kruw. Both positions are attributed here; the archive does not adjudicate between them.
                <Claim basis="reported" captured="6 Aug 2026" scope="Marius OffChain's 64 BTC mixing trace: the stated amounts, hops and named address; the transactions are checkable on chain but not reproduced here" source="Marius OffChain, captured X post, 5 Aug 2026" href="/record/sources/mariusoffchain-2084892387445244196/" />
                <Claim basis="reported" contested captured="6 Aug 2026" scope="The coordinator-responsibility dispute: tanuki42_'s argument that Kruw's centralised coordinator could exclude the stolen coins, against Kruw's quoted reply that the theft cannot be proved because attacker and owner share the same entropy" source="tanuki42_, captured X post, 5 Aug 2026; Kruw's reply as quoted by International Cyber Digest, 5 Aug 2026" href="/record/sources/tanuki42_-2084927029430870179/" />
                <CaptureThumb id="mariusoffchain-2084892387445244196" />
                <CaptureThumb id="tanuki42_-2084927029430870179" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-05T15:25:43Z') ? '' : undefined} hidden={lmBeyond('2026-08-05T15:25:43Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-05T15:25:43Z" /></div>
              <div class="tl__title">The Red Team reports 4,962 findings across 390 projects</div>
              <div class="tl-body">
                calle <a href="/record/sources/callebtc-2085024458012586286/">reports the effort has grown</a> to 16 globally distributed people working around the clock: 27.5 hours in, 4,962 findings filed across 390 projects, of which 85 critical and 635 high severity, at a stated rate of 2.31 findings per person per hour. The findings themselves are not public and are described as held for disclosure, so none of the counts can be rechecked here. That evening calle <a href="/record/sources/callebtc-2085101769500377193/">directs would-be donors to OpenSats</a>, which he says paid the team's AI bill, describing donations there as converting directly into AI tokens for bug hunting; that characterisation of how donations are applied is his. A <a href="/record/sources/bitcoinmag-red-team-390-repos/">Bitcoin Magazine report</a> dated 5 August carries the same figures and adds more than US$40,000 of compute funded by OpenSats and a harness stated at 171,599 lines, all attributed to the participants' own posts.
                <Claim basis="reported" captured="6 Aug 2026" scope="calle's 5 August Red Team figures: 16 people, 27.5 hours, 4,962 findings across 390 projects, 85 critical and 635 high severity; self-reported, with the findings not public and held for disclosure" source="calle, captured X post, 5 Aug 2026" href="/record/sources/callebtc-2085024458012586286/" />
                <Claim basis="reported" captured="6 Aug 2026" scope="The stated funding route: OpenSats paying the team's AI bill and donations converting into inference, in the participant's own characterisation" source="calle, captured X post, 5 Aug 2026" href="/record/sources/callebtc-2085101769500377193/" />
                <Claim basis="reported" captured="6 Aug 2026" scope="Bitcoin Magazine's secondary report of the same figures plus the stated US$40,000 compute spend and 171,599-line harness" source="Bitcoin Magazine, held capture of 6 Aug 2026; article dated 5 Aug 2026" href="/record/sources/bitcoinmag-red-team-390-repos/" />
                <CaptureThumb id="callebtc-2085024458012586286" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.key === '2026-08-06') return (
        <section class="tlgroup" data-gord={s.gord}>
          <h2 class="tlgroup__h">6 August 2026</h2>
          <div class="tl">
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={0} data-beyond={lmBeyond('2026-08-06T13:53:46Z') ? '' : undefined} hidden={lmBeyond('2026-08-06T13:53:46Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-06T13:53:46Z" /></div>
              <div class="tl__title">OpenSats launches Code RED</div>
              <div class="tl-body">
                OpenSats <a href="/record/sources/opensats-2085363706255573313/">announces Code RED</a>: priority support for people red teaming Bitcoin software, including reimbursement of past LLM token costs. The linked blog post, <a href="/record/sources/opensats-code-red/">Code RED: Supporting First Responders</a>, displays a 6 August 2026 publication date and frames the programme as support for the people who have been fire fighting, triaging and red teaming as the industry digests what the exploit revealed, naming opensats.org/red as a priority path to funding and committing to prioritise red team applications for the foreseeable future. The launch formalises the funding route the Red Team's participants had pointed donors to the previous day.
                <Claim basis="reported" captured="7 Aug 2026" scope="The Code RED announcement and its stated terms: priority support for people red teaming Bitcoin software, including reimbursement of past LLM token costs" source="OpenSats, captured official X post, 6 Aug 2026" href="/record/sources/opensats-2085363706255573313/" />
                <Claim basis="verified" captured="7 Aug 2026" scope="The Code RED blog post's displayed 6 August 2026 publication date, its stated terms and its wording as held" source="Held capture of opensats.org/blog/code-red-supporting-first-responders, 7 Aug 2026" href="/record/sources/opensats-code-red/" />
                <CaptureThumb id="opensats-2085363706255573313" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-key" data-kind="landmark" data-eord={1} data-beyond={lmBeyond('2026-08-06T14:25:55Z') ? '' : undefined} hidden={lmBeyond('2026-08-06T14:25:55Z')}>
              <div class="tl-date">detected <Timestamp iso="2026-08-06T14:25:55Z" /></div>
              <div class="tl__title">A honeypot monitor cuts its estimate of what extra entropy buys</div>
              <div class="tl-body">
                The <a href="/record/sources/cktripwire-honeypot-monitor/">CKTRIPWIRE honeypot scoreboard</a>, which funds deliberately vulnerable Mk3 v4 wallets on mainnet with different amounts of added dice-roll or passphrase entropy and records whether and how fast each is swept, revises its published GPU crack-time estimates sharply downward across every difficulty band between the states held at 02:55 and 14:25 UTC. A honeypot with 5 added bits of dice entropy moves from about 2 days to about 66 minutes, 11 added bits of passphrase entropy from about 125 days to about 3 days, 13 added bits of dice entropy from about 476 days to about 10 days, 22 bits from about 703 years to about 15, and 90 bits from about 1e23 years to about 1e21. No honeypot's live-or-swept state changes with the estimates. The scoreboard stood at 17 honeypots, 15 of them live and 2 swept, after the operator added and funded HP-8DA1, described as a low-dice-entropy Mk3 v4 honeypot, at 01:54 UTC that morning. The anonymised handles were re-randomised in the same revision, so rows cannot be followed from one capture to the next. That evening the journalist Laura Shin <a href="/record/sources/laurashin-2085473420742176994/">relays the security researcher Taylor Monahan's claim</a> that the dice rolling being recommended to COLDCARD owners "is the same thing that got the earliest hack victims drained", and that the device warns the user but never stops them. Coinkite's own advisory carves out seeds made with at least 50 fair, independent, private dice rolls; the incident-specific conditions are set out in <a href="/how-it-broke/conditions/#dice">the technical record</a>. The estimates and the claim are their authors', not this project's.
                <Claim basis="verified" captured="6 Aug 2026" scope="The CKTRIPWIRE scoreboard's revised GPU crack-time estimates across every difficulty band, its 17-honeypot state and the addition of HP-8DA1, as held in the captures of 6 August 2026; the experiment's setup and entropy model have not been reproduced here" source="Held captures of cktripwire.com, 6 Aug 2026" href="/record/sources/cktripwire-honeypot-monitor/" />
                <Claim basis="reported" contested captured="7 Aug 2026" scope="Taylor Monahan's claim, as relayed by Laura Shin, that the dice rolling recommended to owners is what drained the earliest victims, against the dice carve-out published in Coinkite's own advisory" source="Laura Shin, captured X post, 6 Aug 2026, relaying Taylor Monahan" href="/record/sources/laurashin-2085473420742176994/" />
                <CaptureThumb id="laurashin-2085473420742176994" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={2} data-beyond={lmBeyond('2026-08-06T16:14:52Z') ? '' : undefined} hidden={lmBeyond('2026-08-06T16:14:52Z')}>
              <div class="tl-date"><Timestamp iso="2026-08-06T16:14:52Z" /></div>
              <div class="tl__title">Wallet software is asked to warn its own users</div>
              <div class="tl-body">
                Posting as Yan at Swan, @skwp <a href="/record/sources/skwp-2085399213563593083/">says his group is opening pull requests</a> against several popular wallets so that users see a warning about the COLDCARD disclosure, on the reasoning that many owners are not on X and will not otherwise know. The post links four: Sparrow 2047, Liana 2242, Electrum 10805 and Wasabi's documentation 2113. Only the first is held here. <a href="/record/sources/sparrow-pr-2047/">Sparrow pull request 2047</a>, opened by nrobi144 on 6 August and approved by @skwp the same day, adds a warning row and a link to Coinkite's advisory wherever a COLDCARD is selected as a device, covering import, airgapped keystore, USB and multisig-export flows through one shared pane, and is careful to trigger on the COLDCARD wallet model rather than on the importer classes that other vendors subclass. In the state held on 7 August the pull request is still open, its author notes he could not run a full local build, and the description records that it was drafted with an AI coding tool. Nothing held here establishes what any of the four wallets shipped.
                <Claim basis="reported" captured="7 Aug 2026" scope="The stated wallet-warning pull-request effort and the four pull requests named in the post; three of the four are not held here" source="Yan at Swan (@skwp), captured X post, 6 Aug 2026" href="/record/sources/skwp-2085399213563593083/" />
                <Claim basis="verified" captured="7 Aug 2026" scope="Sparrow pull request 2047 as held: its opening comment and approval both dated 6 August 2026, its stated detection rule and covered flows, its open status and its author's build caveat" source="Held capture of github.com/sparrowwallet/sparrow/pull/2047, 7 Aug 2026" href="/record/sources/sparrow-pr-2047/" />
                <CaptureThumb id="skwp-2085399213563593083" />
              </div>
            </div>
            <div class="tl-item tle tle--lm is-good" data-kind="landmark" data-eord={3} data-beyond={lmBeyond('2026-08-06T16:26:26Z') ? '' : undefined} hidden={lmBeyond('2026-08-06T16:26:26Z')}>
              <div class="tl-date">6 Aug 2026, merged; detected <Timestamp iso="2026-08-06T16:26:26Z" /></div>
              <div class="tl__title">The guard at the centre of the incident is changed upstream</div>
              <div class="tl-body">
                The <code>#ifndef MICROPY_HW_ENABLE_RNG</code> guard recorded in the January 2021 entry above is replaced on <a href="/record/sources/libngu-random-c/">libngu's master branch</a> with <code>#if MICROPY_HW_ENABLE_RNG == 0</code>, so a build configured without a hardware TRNG now fails at compile time instead of falling through. The change arrives as <a href="/record/sources/libngu-pr-58/">pull request #58, "Enforce HW TRNG"</a>, opened by an outside contributor on 31 July with a link to Block's disclosure and the note "You don't know me but this should be easy enough to validate :)", and merged by switck as commit <code>e9d5e80</code> on 6 August. The same master state moves the Linux build off glibc <code>random()</code> to <code>getrandom()</code> through a checked helper, carrying the comment "glibc random() is not a TRNG and is typically unseeded here — never use for keys", and makes <code>random_bytes()</code> reject negative counts. This is the upstream library rather than a COLDCARD firmware release: nothing held here establishes which shipped firmware, if any, carries it. <a href="/how-it-broke/">How it broke</a> sets out the guard's earlier form from the published accounts.
                <Claim basis="verified" captured="6 Aug 2026" scope="The replacement of the ifndef guard on libngu master, the Linux getrandom() helper and the negative-count rejection, and the merge of pull request #58 as commit e9d5e80 on 6 August 2026" source="Held captures of libngu ngu/random.c on master and of pull request #58, 6 Aug 2026" href="/record/sources/libngu-random-c/" />
              </div>
            </div>
            <div class="tl-item tle tle--lm" data-kind="landmark" data-eord={4} data-beyond={lmBeyond('2026-08-06T22:57:51Z') ? '' : undefined} hidden={lmBeyond('2026-08-06T22:57:51Z')}>
              <div class="tl-date">detected <Timestamp iso="2026-08-06T22:57:51Z" /></div>
              <div class="tl__title">Casa adds a replacement recommendation to its COLDCARD support page</div>
              <div class="tl-body">
                Casa, which sells multisig collaborative custody and so has a commercial interest in the alternative, adds a security advisory banner to <a href="/record/sources/casa-support-coldcard-troubleshooting/">its COLDCARD troubleshooting support page</a>: Coinkite has identified a seed-generation flaw affecting certain COLDCARD firmware versions, funds may be at risk if the seed was generated on affected firmware, and "We do recommend replacing this device as soon as you are able." The page's displayed date moves from 4 March 2026 to 6 August 2026 in the same edit, while the banner carries its own date of "Updated August 1, 2026". No banner is present in the state this archive held on 3 August, so the date the banner states for itself and the dates the captures bound do not agree. The rest of the page still describes Mk3 and later devices as compatible with Casa vaults.
