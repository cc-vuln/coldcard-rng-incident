---
import Base from '../layouts/Base.astro';
import Claim from '../components/Claim.astro';
import EvidenceRegister from '../components/EvidenceRegister.astro';
import Timestamp from '../components/Timestamp.astro';
import CorrectionNotice from '../components/CorrectionNotice.astro';
import { stats, goneSources, displayTitle, tsToIso } from '../lib/archive';
import { latestEvents } from '../lib/latest-events';
import { fig } from '../lib/figures';
import { humanDate } from '../lib/updated';

const s = stats();

/*
 * The record band (below): the archive shown rather than described. Display
 * strings are precomputed here because conditionals returning markup break
 * the template parser (see the pitfalls note in AGENTS.md).
 */
const EVENT_LABELS = {
  'first-capture': 'entered the record',
  'source-change': 'source content changed',
  'post': 'X post',
} as const;
const latest = latestEvents(3).map((e) => ({
  ...e,
  label: EVENT_LABELS[e.kind],
}));

// Freshness, computed at build time. The site rebuilds after captures, so
// build-time is the honest resolution: the line dates the record, not the page.
let freshness = '';
if (s.lastCapture) {
  const hours = (Date.now() - Date.parse(tsToIso(s.lastCapture))) / 3600000;
  freshness = hours < 1.5
    ? 'Last capture about an hour ago.'
    : hours < 48
      ? `Last capture about ${Math.round(hours)} hours ago.`
      : `Last capture ${Math.round(hours / 24)} days ago.`;
}

// The hero's own freshness line, as a plain date: the record band below
// speaks in relative hours, but the top of the page is where a reader asks
// "when was this last updated", and a date answers it without arithmetic.
const recordUpdated = s.lastCapture ? humanDate(tsToIso(s.lastCapture)) : '';

/*
 * Sources whose originals no longer exist are the strongest single argument
 * for holding captures, so the line names them and links to the copies rather
 * than asserting a count. A few are listed inline; beyond that the register's
 * own gone list (and its filter) takes over, because a landing line is not a
 * place to grow an unbounded list.
 */
const GONE_NAMED = 3;
const gone = goneSources();
const goneCount = gone.length;
const goneLine = goneCount === 1
  ? '1 source has since disappeared from the web; the copy held here is the only public one left:'
  : `${goneCount} sources have since disappeared from the web; the copies held here are the only public ones left:`;
const goneLinks = gone.slice(0, GONE_NAMED).map((s) => ({
  href: `/record/sources/${s.id}/`,
  title: displayTitle(s),
}));
const goneRest = goneCount - goneLinks.length;

---

<Base
  title="COLDCARD predictable-RNG incident: public record"
  description="A primary-source archive and technical explainer for the July 2026 COLDCARD predictable-RNG incident, preserving published statements and their revisions."
  bare
>
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="mono-label hero__kicker">Incident record &middot; disclosed 30 July 2026</p>
      <p class="mono-label hero__updated" hidden={!recordUpdated}>Record updated {recordUpdated} &middot; sources re-captured on a schedule</p>
      <h1 class="hero__title">
        The public record of the COLDCARD entropy incident.
      </h1>
      <p class="hero__lede">
        A <strong>COLDCARD</strong> is a small device that keeps the keys to
        your bitcoin off the internet. Setting one up creates
        <strong>seed words</strong>. They can rebuild the wallet, anyone who
        learns them can take the money, and they are supposed to be
        impossible to guess. On firmware released from March 2021 until the
        fixes on 31 July 2026, <a href="/how-it-broke/">they did not come from
        the randomness the device was designed to use</a>, so
        <strong>seed words made on that firmware can be worked out by somebody
        with a computer and time</strong>. On the older models that has been
        done; on the newer ones the researchers who have looked disagree about
        how hard it would be.
        <Claim
          basis="reported"
          contested
          scope="The statement on this page that seed words made on affected firmware can be worked out, and that published estimates of the difficulty disagree for the Mk4-class devices"
          source="Published candidate-space models from Block, LLFOURN, otaliptus and Coinkite. They broadly agree on the Mk2 and Mk3 spaces, which have also been reproduced on-device, and differ by orders of magnitude on Mk4, Mk5 and Q, where no drain has been confirmed in this incident's July 2026 waves"
          href="/how-it-broke/entropy/"
          compact
        />
        <Claim
          basis="reported"
          scope="The claim on this page that affected seed generation did not use the hardware randomness the device was designed to use, on firmware released from March 2021 until the 31 July 2026 fixes"
          source="Coinkite's published entropy technical backgrounder, which states that a series of bugs kept seed generation on a software fallback instead of the hardware RNG while the hardware generator stayed in the firmware for other callers; held capture of 1 Aug 2026"
          href="/record/sources/coinkite-backgrounder/"
          compact
        />
      </p>
      <p class="hero__lede">
        On 30 July 2026 somebody did exactly that:
        <a href="/record/funds/">{fig('sweptBtcApprox')}</a>
        was emptied out of {fig('sweptAddresses')} in a matter of minutes,
        and researchers have since attributed more than 1,000 BTC of wider
        movements to the incident.
        <Claim
          basis="reported"
          scope="The about 594 BTC 30 July sweep total quoted on this page"
          source="TFTC's published first-collector receipt for the 500-transaction set, captured 31 Jul 2026"
          href="/record/sources/tftc-who-must-move/"
          compact
        />
        <Claim
          basis="reported"
          scope="The statement on this page that researchers have attributed more than 1,000 BTC of wider movements to the incident, resting on Galaxy Research's 3 August confirmed total of 1,596 BTC across about 7,300 addresses"
          source="Galaxy's captured 3 August thread; the underlying transaction and address lists are not published"
          href="/record/sources/glxy-losses-exceed-100m/"
          compact
        />
      </p>
      <p class="hero__lede">
        That changing understanding is part of the incident record. Advisories
        have been revised, scope statements have changed, the people studying
        the theft <a href="/record/funds/">publish different totals</a>, and
        public discussion has included speculation and conspiracy theories.
        Preserving those successive states for posterity is a core purpose of
        this project. The <a href="/record/timeline/">chronology dates and
        attributes those views</a> rather than treating them as evidence. The
        archive keeps every earlier version,
        <a href="/record/changes/">publishes every change</a>, and grades each
        material claim against evidence you can re-check, rather than
        reconciling them into one answer.
      </p>
    </div>
  </section>

  {/*
    The record is shown rather than merely described. The collation is the
    site's contribution, so it appears before the section map.
  */}
  <section class="wrap recordband">
    <h2 class="recordband__h">Inside the record</h2>
    <p class="recordband__lede">
      An independent archive of what has been published about this incident,
      preserved as it was published. Every figure here is a capture taken at a
      stated moment, not a live number.
    </p>
    <p class="recordband__fresh" hidden={!freshness}>
      Sources are re-captured on a schedule. {freshness}
    </p>

    <div class="recordband__stats">
      <a class="rb-stat" href="/record/">
        <strong>{s.sources}</strong>
        <span>web sources tracked</span>
      </a>
      <a class="rb-stat" href="/record/changes/">
        <strong>{s.sourceChanges}</strong>
        <span>reviewed source changes</span>
      </a>
      <a class="rb-stat" href="/record/">
        <strong>{s.xPosts}</strong>
        <span>X posts registered</span>
      </a>
      <a class="rb-stat" href="/record/" hidden={s.nostrPosts === 0}>
        <strong>{s.nostrPosts}</strong>
        <span>nostr posts registered</span>
      </a>
    </div>

    <CorrectionNotice page="/" />

    <p class="recordband__gone" hidden={goneCount === 0}>
      {goneLine}
      {goneLinks.map((g) => (
        <a href={g.href}>{g.title}</a>
      ))}
      <a href="/record/#gone" hidden={goneRest <= 0}>and {goneRest} more</a>
    </p>

    <h3 class="recordband__sub">Latest in the record</h3>
    <ol class="recordband__latest">
      {latest.map((e) => (
        <li class="rb-ev">
          <a class="rb-ev__link" href={e.href}>
            <span class="rb-ev__shot" hidden={!e.thumb}>
              <img src={e.thumb ?? undefined} alt={`Captured screenshot: ${e.title}`} loading="lazy" />
              <span class="rb-ev__captured">captured <Timestamp iso={e.thumbCaptured ?? ''} /></span>
            </span>
            <span class="rb-ev__meta"><Timestamp iso={e.iso} /> &middot; {e.label}</span>
            <span class="rb-ev__title">{e.title}</span>
            <span class="rb-ev__by" hidden={!e.by}>{e.by}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="recordband__feedlink">
      <a href="/record/changes/">Everything captured, newest first &rarr;</a>
    </p>

  </section>

  <section class="wrap paths">
    <div class="paths__grid">
      <a class="path" href="/record/reference/">
        <h2>Reference index</h2>
        <p>
          Primary analysis and published code, organised by what each item
          establishes and what it asks a reader to supply.
        </p>
        <span class="path__meta">Analysis &middot; code</span>
      </a>

      <a class="path" href="/how-it-broke/">
        <h2>How it broke</h2>
        <p>
          The guard, the two generators, the truncated reseed, and how the fix
          works. Code claims cite checks against the source repositories.
        </p>
        <span class="path__meta">Firmware detail</span>
      </a>

      <a class="path" href="/response/">
        <h2>Published responses</h2>
        <p>
          What Coinkite, Block, independent developers and researchers said and
          shipped, the legal posture, and the evidence around claimed
          AI-assisted discovery.
        </p>
        <span class="path__meta">Vendor &middot; community &middot; legal</span>
      </a>
    </div>
  </section>

  {/*
    The markers themselves sit beside the claims they grade, up in the hero.
    This page uses Base rather than Article, so it must render the register
    the references anchor to; the register carries its own heading.
  */}
  <section class="wrap whatthisis">
    <EvidenceRegister />
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3.2rem); }
  .hero__kicker { margin-bottom: 0.4rem; }
  .hero__updated { margin-bottom: 1.1rem; opacity: 0.75; }
  .hero__title {
    font-size: clamp(2.1rem, 5.6vw, 3.8rem);
    line-height: 1.08;
    /* Long enough to name the incident in full without wrapping into a
       third line at desktop widths. */
    max-width: 26ch;
    margin-bottom: 1.4rem;
  }
  .hero__lede {
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.68;
    max-width: 62ch;
    color: var(--ink-2);
  }
  .hero__lede + .hero__lede { margin-top: 1rem; }


  .paths { margin-top: 4.5rem; }
  .paths__grid {
    display: grid; gap: 1rem; margin-top: 1.7rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* Below this, three tracks would fall under the 258px the cards want. */
  @media (max-width: 880px) {
    .paths__grid { grid-template-columns: 1fr; }
  }
  .path {
    display: flex; flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.4rem 1.45rem;
    text-decoration: none;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .path:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  /* Peers of "Inside the record" in the outline now that the section's own
     heading is gone; sized as cards, not as section headings. */
  .path h2 { font-size: 1.12rem; margin-top: .55rem; }
  .path p { font-size: .89rem; color: var(--ink-2); margin-top: .5rem; line-height: 1.6; flex: 1; }
  .path__meta {
    font-family: var(--font-mono); font-size: .64rem; color: var(--ink-3);
    letter-spacing: .07em; text-transform: uppercase; margin-top: .95rem;
  }
  .recordband { margin-top: 3.2rem; }
  .recordband__h { font-family: var(--font-display); font-weight: 400; font-size: 1.5rem; }
  .recordband__lede {
    color: var(--ink-2); font-size: .95rem; line-height: 1.65;
    margin-top: .7rem; max-width: var(--w-note);
  }
  .recordband__fresh {
    color: var(--ink-3); font-size: .92rem; margin-top: .5rem; max-width: 62ch;
  }
  .recordband__stats {
    display: grid; gap: .8rem; margin-top: 1.3rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 720px) {
    .recordband__stats { grid-template-columns: 1fr; }
  }
  .rb-stat {
    display: flex; flex-direction: column; gap: .2rem;
    padding: .95rem 1rem;
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: var(--radius-lg); text-decoration: none;
    transition: border-color .15s;
  }
  .rb-stat:hover { border-color: var(--accent); }
  /* display:flex above would otherwise beat the hidden attribute. */
  .rb-stat[hidden] { display: none; }
  .rb-stat strong {
    font-family: var(--font-display); font-weight: 400;
    font-size: 1.7rem; color: var(--ink); line-height: 1.1;
  }
  .rb-stat span {
    font-family: var(--font-mono); font-size: .62rem; color: var(--ink-3);
    letter-spacing: .07em; text-transform: uppercase;
  }
  .recordband__gone {
    font-size: .92rem; color: var(--ink-2); margin-top: 1rem; max-width: 62ch;
    border-left: 2px solid var(--rule); padding-left: .9rem;
  }
  /* Separators are drawn rather than written, so the list reads correctly at
     any count without the template branching on it. */
  .recordband__gone a { color: var(--ink); }
  .recordband__gone a:hover { text-decoration: underline; }
  .recordband__gone a + a::before { content: ", "; color: var(--ink-3); }
  .recordband__sub {
    font-family: var(--font-mono); font-size: .68rem; font-weight: 600;
    color: var(--ink-3); letter-spacing: .1em; text-transform: uppercase;
    margin-top: 1.8rem;
  }
  .recordband__latest {
    list-style: none; margin: .8rem 0 0; padding: 0;
    display: grid; gap: .8rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 720px) {
    .recordband__latest { grid-template-columns: 1fr; }
  }
  .rb-ev__link {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: var(--radius-lg); padding: .9rem 1rem;
    text-decoration: none; transition: border-color .15s;
  }
  .rb-ev__link:hover { border-color: var(--accent); }
  .rb-ev__shot {
    display: block; margin: 0 0 .7rem;
    border: 1px solid var(--rule); border-radius: var(--radius);
    overflow: hidden; max-height: 150px; background: var(--surface-2);
  }
  /* display: block above would otherwise defeat the hidden attribute, and a
     thumb-less entry rendered an empty broken-image frame. */
  .rb-ev__shot[hidden] { display: none; }
  .rb-ev__shot img { display: block; width: 100%; height: auto; }
  .rb-ev__captured {
    display: block;
    padding: .35rem .5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: .56rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }
  .rb-ev__meta {
    font-family: var(--font-mono); font-size: .62rem; color: var(--ink-3);
    letter-spacing: .06em; text-transform: uppercase;
  }
  .rb-ev__title { font-weight: 600; font-size: .95rem; color: var(--ink); margin-top: .35rem; }
  .rb-ev__by { font-size: .78rem; color: var(--ink-3); margin-top: .2rem; }
  .recordband__feedlink { margin-top: .8rem; font-size: .9rem; }

  /* Holds only the evidence register the hero's inline references anchor
     to; the register renders its own heading. */
  .whatthisis { margin-top: 2.6rem; }

</style>
