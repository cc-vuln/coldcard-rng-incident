---
// Self-hosted fonts: a security-sensitive page should make zero third-party
// requests, so the former Google Fonts link tags are replaced by local woff2
// files under /public/fonts with the same families, weights and unicode-ranges.
import '../styles/fonts.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Shown under the masthead on interior pages */
  kicker?: string;
  /** Suppress the wide reading rail (used by the landing page) */
  bare?: boolean;
}

const { title, description, kicker, bare = false } = Astro.props;
const path = Astro.url.pathname;
// Shared links land as bare cards headed "Timeline" or "Evidence" without
// this; the landing page already names the incident and keeps its own title.
const fullTitle = path === '/' ? title : `${title} · COLDCARD entropy incident`;
const desc = description ??
  'An open source collection of what has been published about the July 2026 COLDCARD predictable-RNG incident, preserved as it was published and presented in plain words.';
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const CONTACT = import.meta.env.PUBLIC_CONTACT || 'info@cc-vuln.org';
const SOCIAL = 'https://x.com/cc_vuln';
const INDEXABLE = import.meta.env.PUBLIC_INDEXABLE === 'true';
// The source repository. Nothing is solicited or sold here; the project asks
// for corrections, sources and code rather than money.
const REPO = 'https://github.com/cc-vuln/coldcard-rng-incident';

/*
 * Intent-based primary navigation (docs/design/site-information-architecture.md
 * section 3). Labels are the question a reader brings, not the content type.
 * `match` lists every URL prefix that lights a link up: the affected journey
 * spans /risk/ and /safety/, which keep their URLs beneath the /affected/ hub
 * so no published link breaks.
 */
const nav: { href: string; label: string; match?: string[] }[] = [
  { href: '/', label: 'Overview' },
  { href: '/affected/', label: 'Am I affected?', match: ['/affected/', '/risk/', '/safety/'] },
  { href: '/how-it-broke/', label: 'What happened?' },
  { href: '/record/', label: 'The record' },
  { href: '/response/', label: 'The aftermath' },
  { href: '/about/', label: 'About' },
];

type NavItem = { href: string; match?: string[] };
const navMatches = (n: NavItem) => n.match ?? [n.href];
const isActive = (n: NavItem) =>
  n.href === '/' ? path === '/' : navMatches(n).some((m) => path.startsWith(m));
const navCurrent = (n: NavItem) => {
  const exact = path === n.href || path === n.href.replace(/\/$/, '');
  if (exact) return 'page';
  return isActive(n) ? 'location' : undefined;
};

/*
 * Section navigation.
 *
 * Six primary links were hiding around thirty pages. Anything not linked from
 * the body of whichever page you happened to land on was effectively invisible,
 * and /response/ was not reachable from the nav at all. A reader on
 * the separate mitigation pages had no way to discover each other.
 *
 * Keyed by URL prefix, so a page joins its section by living at the right path
 * and needs no per-page wiring. Sections with a single page have no entry and
 * render no second bar.
 */
// The affected journey is one section spanning three URL prefixes
// (/affected/, /risk/, /safety/): the hub is meant to make the boundary
// invisible, so all three keys share one entry list with one set of labels.
const AFFECTED_SUBNAV = [
  { href: '/affected/', label: 'Overview' },
  { href: '/risk/', label: 'Check: your risk' },
  { href: '/risk/estimator/', label: 'Check: estimator' },
  { href: '/risk/mitigations/', label: 'Check: dice, passphrase, multisig' },
  { href: '/risk/moving-funds/', label: 'Act: moving funds' },
  { href: '/safety/scams/', label: 'Avoid: scams' },
  { href: '/safety/seed-words/', label: 'Avoid: seed-word safety' },
];

const SUBNAV: Record<string, { href: string; label: string }[]> = {
  '/affected/': AFFECTED_SUBNAV,
  '/risk/': AFFECTED_SUBNAV,
  '/safety/': AFFECTED_SUBNAV,
  '/how-it-broke/': [
    { href: '/how-it-broke/', label: 'Generator path' },
    { href: '/how-it-broke/entropy/', label: 'Attack-cost estimates' },
    { href: '/how-it-broke/blast-radius/', label: 'Blast radius' },
  ],
  '/response/': [
    { href: '/response/', label: 'Custody providers' },
    { href: '/response/developers/', label: 'Developer activity' },
    { href: '/response/ai/', label: 'Did AI find this?' },
    { href: '/response/legal/', label: 'Legal context' },
  ],
  '/record/': [
    { href: '/record/', label: 'Sources' },
    { href: '/record/feed/', label: 'Feed' },
    { href: '/record/analysis/', label: 'Primary analysis' },
    { href: '/record/repos/', label: 'Published code' },
    { href: '/record/timeline/', label: 'Incident timeline' },
    { href: '/record/funds/', label: 'Funds accounting' },
    { href: '/record/firmware/', label: 'Firmware releases' },
    { href: '/record/changes/', label: 'Source changes' },
  ],
};

const subKey = Object.keys(SUBNAV).find((k) => path.startsWith(k));
const subnav = subKey ? SUBNAV[subKey] : [];
// Exact match: every sub-page starts with the section prefix, so a
// startsWith test would light up the overview link on all of them.
const subActive = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  {/*
    Indexing is opt-in, and deliberately so: a build that forgets the flag is a
    build search engines are told to leave alone. `just publish` sets it, the
    review deploy does not, so a preview on pages.dev cannot be indexed under a
    URL we do not intend to keep.
  */}
  <meta name="robots" content={INDEXABLE ? 'index,follow' : 'noindex,nofollow'} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/feed+json" title="cc-vuln.org source change record" href="/record/changes.json" />

  {/* Social cards: one shared 1200x630 banner, absolute URL from Astro.site */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="cc-vuln.org" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="cc-vuln.org banner: The public record, collected and explained. An open-source archive of the COLDCARD RNG incident, July 2026." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@cc_vuln" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="cc-vuln.org banner: The COLDCARD predictable-RNG incident. Primary-source archive, July 2026." />


  {/* Theme applied before paint to avoid a flash */}
  <script is:inline>
    (() => {
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>

  <header class="masthead">
    <div class="wrap masthead__inner">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true"></span>
        <span class="brand__text">
          <strong>COLDCARD RNG incident</strong>
          <span>the public record, collected and explained</span>
        </span>
      </a>

      <nav class="nav" aria-label="Primary">
        {nav.map((n) => (
          <a
            href={n.href}
            class:list={['nav__link', { 'is-active': isActive(n) }]}
            aria-current={navCurrent(n)}
          >
            {n.label}
          </a>
        ))}
      </nav>

      <button id="theme-toggle" class="theme-toggle" type="button"
              aria-label="Switch colour scheme" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
             stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      </button>
    </div>
  </header>

  {subnav.length > 0 && (
    <div class="subnav">
      <div class="wrap">
        <nav class="subnav__inner" aria-label="Section">
          {subnav.map((n) => (
            <a
              href={n.href}
              class:list={['subnav__link', { 'is-active': subActive(n.href) }]}
              aria-current={subActive(n.href) ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  )}

  {/*
    The section kicker bar used to render here. It restated location the primary
    nav and the subnav were both already showing, so on an interior page the
    section name appeared three times above the heading. The prop is still
    accepted, and pages still pass it, because it feeds the document title and
    is worth keeping as metadata; it just is not worth a band of chrome.
  */}

  <div class="disclaimer">
    <div class="wrap">
      {/*
        Collapsed by default. Both notices were taking four lines above every
        page and being scrolled past, which is the failure mode for a notice.
        The summary keeps the two claims that matter on screen: this is not
        advice, and nothing here will ask for recovery material. The detail is
        one click away for anybody who wants it.
      */}
      <details class="disclaimer__box">
        <summary class="disclaimer__summary">
          <span><strong>Informational only</strong>, and this site never asks for your seed words.</span>
          <span class="disclaimer__more">details</span>
        </summary>
        <div class="disclaimer__body">
          <p>
            <strong>Informational only.</strong> This is an open source collection of
            what others have published about the incident, together with an
            explanation of it. It is not financial, security or legal advice, and not
            a substitute for professional advice about your own situation. It is not
            affiliated with, endorsed by, or speaking for Coinkite. Material is
            attributed and quoted as published; where sources disagree their
            scenarios are kept separate with their assumptions rather than
            reconciled into one answer. Everything is meant to be checked against
            the linked evidence rather than taken on trust. Act on your own
            judgement.
            <a href="/about/#editorial-standards">Editorial standards and corrections</a>.
          </p>
          <p class="disclaimer__seed">
            <strong>Do not disclose recovery material to a website, form, message or support account.</strong>
            This site never asks for it. Deliberate recovery on independently verified
            offline equipment is a separate operation.
            <a href="/safety/seed-words/">Seed-word safety</a>.
          </p>
        </div>
      </details>
    </div>
  </div>

  <main id="main" class:list={['main', { 'main--bare': bare }]}>
    <slot />
  </main>

  <footer class="foot">
    {/*
      The "How this was made" provenance block used to lead this footer. It now
      lives once, on /about/ ("Who publishes this"), alongside the editorial
      standards it pointed at, instead of being repeated on every page.
    */}
    <div class="wrap foot__inner">
      <div>
        <p class="mono-label">Contact</p>
        <p class="foot__dim">
          Corrections, tips, legal notices and questions:
          <a href={'mailto:' + CONTACT}>{CONTACT}</a>
        </p>
        <p class="foot__dim">
          Project account: <a href={SOCIAL} rel="noopener">@cc_vuln</a>.
        </p>
      </div>
      <div>
        <p class="mono-label">Contribute</p>
        <p class="foot__dim">
          This is an open collection and it is incomplete. If you know of a
          thread, an analysis, a vendor statement or a capture the record is
          missing, send it: pointers to what we have missed are the most useful
          thing you can give. Corrections are as welcome as additions, and
          nothing is solicited or sold here.
        </p>
        <p class="foot__dim">
          <a href="/about/#editorial-standards">How to contribute and correct</a>
        </p>
        <ul class="foot__social">
          <li>
            <a href={REPO} rel="noopener" title="Source repository on GitHub">
              <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
              <span class="visually-hidden">Source repository on GitHub</span>
            </a>
          </li>
          <li>
            <a href={SOCIAL} rel="noopener" title="@cc_vuln on X">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span class="visually-hidden">@cc_vuln on X</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </footer>

  <script is:inline>
    const themeButton = document.getElementById('theme-toggle');
    const updateThemeButton = () => {
      const el = document.documentElement;
      const dark = el.dataset.theme === 'dark';
      const next = dark ? 'light' : 'dark';
      themeButton?.setAttribute('aria-pressed', String(dark));
      themeButton?.setAttribute('aria-label', `Use ${next} colour scheme`);
      themeButton?.setAttribute('title', `Use ${next} colour scheme`);
    };
    updateThemeButton();
    themeButton?.addEventListener('click', () => {
      const el = document.documentElement;
      const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
      el.dataset.theme = next;
      localStorage.setItem('theme', next);
      updateThemeButton();
      window.dispatchEvent(new CustomEvent('cc-theme-change', {
        detail: { theme: next },
      }));
    });
    // Both navigation rows scroll horizontally on narrow screens. Keep the
    // current location visible when it would otherwise begin off-screen. Run
    // again after fonts settle because their final widths change the scroll.
    const revealActiveNavigation = () => {
      document.querySelectorAll('.nav__link.is-active, .subnav__link.is-active')
        .forEach((link) => link.scrollIntoView({ block: 'nearest', inline: 'center' }));
    };
    revealActiveNavigation();
    document.fonts?.ready.then(revealActiveNavigation);
  </script>

  <style>
    .skip {
      position: absolute; left: -9999px; top: 0; z-index: 100;
      background: var(--surface); padding: .7rem 1rem; border-radius: 0 0 8px 0;
    }
    .skip:focus { left: 0; }

    .masthead {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: saturate(1.6) blur(12px);
      border-bottom: 1px solid var(--rule);
    }
    .masthead__inner {
      display: flex; align-items: center; gap: 1.5rem;
      min-height: 58px;
    }

    .brand { display: flex; align-items: center; gap: .62rem; text-decoration: none; flex-shrink: 0; }
    .brand__mark {
      width: 11px; height: 11px; border-radius: 2px;
      background: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }
    .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
    .brand__text strong { font-size: .84rem; font-weight: 600; letter-spacing: -.01em; }
    .brand__text span {
      font-family: var(--font-mono); font-size: .6rem;
      letter-spacing: .11em; text-transform: uppercase; color: var(--ink-3);
    }

    .nav { display: flex; gap: .2rem; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav__link {
      font-size: .82rem; text-decoration: none; padding: .38rem .68rem;
      border-radius: 7px; color: var(--ink-2); white-space: nowrap;
      transition: background .15s, color .15s;
    }
    .nav__link:hover { background: var(--surface-2); color: var(--ink); }
    .nav__link.is-active { color: var(--ink); background: var(--surface-2); font-weight: 500; }

    .theme-toggle {
      display: grid; place-items: center;
      width: 44px; height: 44px; flex-shrink: 0;
      border: 1px solid var(--rule); border-radius: 8px;
      background: transparent; color: var(--ink-3); cursor: pointer;
      transition: color .15s, border-color .15s;
    }
    .theme-toggle:hover { color: var(--ink); border-color: var(--rule-2); }

    /* Sticks below the masthead, not at the viewport top. At top: 0 it slid
       under the sticky masthead (z 50 vs 40) and vanished exactly when a
       reader scrolled, which on mobile is most of the time. The masthead is
       58px tall on desktop; below 640px the masthead goes static and scrolls
       away, and the subnav takes over the top edge itself. */
    .subnav {
      border-bottom: 1px solid var(--rule);
      background: var(--surface-2);
      position: sticky; top: 58px; z-index: 40;
    }
    .subnav__inner {
      display: flex; gap: .15rem;
      overflow-x: auto; scrollbar-width: none;
      padding-block: .3rem;
      padding-inline-end: 1.75rem;
      scroll-padding-inline: .7rem;
    }
    .subnav__inner::-webkit-scrollbar { display: none; }
    .subnav__link {
      font-size: .8rem; color: var(--ink-3);
      text-decoration: none; white-space: nowrap;
      padding: .42rem .7rem; border-radius: 7px;
      border-bottom: 2px solid transparent;
    }
    .subnav__link:hover { color: var(--ink); background: var(--surface); }
    .subnav__link.is-active {
      color: var(--ink); font-weight: 500;
      border-bottom-color: var(--accent);
      border-radius: 7px 7px 0 0;
    }

    .disclaimer {
      background: var(--warn-soft);
      border-bottom: 1px solid color-mix(in srgb, var(--warn) 26%, transparent);
      padding: .7rem 0;
    }
    .disclaimer p {
      font-size: .78rem; line-height: 1.6; color: var(--ink-2);
    }
    .disclaimer strong { color: var(--warn); }

    .disclaimer__box { font-size: .82rem; }
    .disclaimer__summary {
      display: flex; align-items: baseline; justify-content: center;
      gap: .6rem; cursor: pointer; list-style: none;
      padding-block: .1rem; text-align: center;
    }
    .disclaimer__summary::-webkit-details-marker { display: none; }
    .disclaimer__more {
      font-family: var(--font-mono); font-size: .6rem;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--ink-3); white-space: nowrap;
    }
    .disclaimer__summary:hover .disclaimer__more { color: var(--warn); }
    .disclaimer__box[open] .disclaimer__more::after { content: ' \2212'; }
    .disclaimer__box:not([open]) .disclaimer__more::after { content: ' +'; }
    .disclaimer__body {
      max-width: var(--w-note); margin-inline: auto; text-align: center;
      padding-top: .6rem;
    }
    .disclaimer__body p + p {
      margin-top: .55rem; padding-top: .55rem;
      border-top: 1px solid color-mix(in srgb, var(--warn) 30%, transparent);
    }
    /* Centred and measure-limited. These are the two things every visitor should
       read regardless of which page they landed on, and left-aligned full-width
       body text at this size reads as boilerplate to be skipped. */
    /* ch, not --w-note: this is one paragraph's own reading measure at its own
       font-size, which is what ch is for. It resolves to 702px here, and the
       780px token would widen every disclaimer line by 78px. The box around it
       uses the token, because that width is shared. */
    .disclaimer p {
      max-width: 78ch; margin-inline: auto; text-align: center;
    }
    /* Separated from the legal note above it: that one manages expectations,
       this one prevents the most likely way a reader loses money this week. */
    .disclaimer__short { display: none; }
    .disclaimer__seed {
      margin-top: .55rem; padding-top: .55rem;
      border-top: 1px solid color-mix(in srgb, var(--warn) 30%, transparent);
    }
    .disclaimer__seed strong { color: var(--danger); }

    .main { padding-block: clamp(2rem, 5vw, 3.6rem) 5rem; }
    .main--bare { padding-block: 0 5rem; }

    .foot { border-top: 1px solid var(--rule); background: var(--surface); padding-block: 2.4rem 3rem; margin-top: 4rem; }
    .foot__inner {
      display: grid; gap: 1.8rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      font-size: .82rem; line-height: 1.6;
    }
    .foot__inner .mono-label { margin-bottom: .45rem; }
    .foot__dim { color: var(--ink-3); margin-top: .3rem; }

    .foot__social {
      list-style: none; margin: .9rem 0 0; padding: 0;
      display: flex; gap: .5rem;
    }
    .foot__social a {
      display: inline-flex; align-items: center; justify-content: center;
      width: 2.2rem; height: 2.2rem;
      border: 1px solid var(--rule); border-radius: var(--radius);
      color: var(--ink-2);
    }
    .foot__social a:hover, .foot__social a:focus-visible {
      color: var(--ink); border-color: var(--rule-2);
      background: var(--surface-2);
    }
    @media (max-width: 640px) {
      .masthead { position: static; }
      .masthead__inner { flex-wrap: wrap; gap: .6rem; padding-block: .6rem; }
      .nav { order: 3; width: 100%; margin-left: 0; }
      /* 44px-class tap targets: the desktop padding tops out near 30px */
      .nav__link { padding: .62rem .68rem; }
      .subnav { top: 0; }
      .subnav__link { padding: .62rem .7rem; }
      .theme-toggle { margin-left: auto; }

      .disclaimer__summary {
        justify-content: space-between; text-align: left; line-height: 1.45;
      }
      .disclaimer__body { text-align: left; }
    }
  </style>
</body>
</html>
