---
/**
 * Client-side filter over whatever cards are on the page.
 *
 * No search dependency and no index to fall out of date: the cards are already
 * in the DOM with their text, and this hides the ones that do not match. That
 * keeps the page working with JavaScript off (everything visible, nothing
 * filtered) and keeps the site free of a search library, consistent with the
 * project's dependency posture.
 *
 * Cards opt in by carrying a data attribute; the matcher reads their text
 * content plus data-search, so titles, authors, excerpts and badges are all
 * searchable.
 *
 * Facets come in sets. `facets` is the single unlabelled set the component has
 * always had; `facetSets` renders several labelled rows instead. Rows are
 * single-select unless they opt into `multiple`; selections within a
 * multi-select row are ORed, and separate rows are ANDed (e.g. entry kind in
 * one row, source group in another). A facet is either an equality match (`value`
 * against `matchAttr`, default `data-group`) or, with `attr`, presence of a
 * boolean data attribute on the card (e.g. `attr: 'data-has-shot'`). A facet
 * with `default` starts active and its filter applies on load: a JS-only
 * enhancement, since nothing is pre-hidden in the markup and a scriptless
 * reader sees the whole list.
 */
interface Facet {
  value?: string;
  label: string;
  /** Presence-match this boolean data attribute instead of an equality. */
  attr?: string;
  /** Attribute to equality-match; defaults to data-group. */
  matchAttr?: string;
  /** Start active. Nothing is hidden in the markup on its account. */
  default?: boolean;
}
interface FacetSet {
  label: string;
  facets: Facet[];
  /** Allow more than one facet in this row to be active. */
  multiple?: boolean;
  /** Place the All reset at the far edge of the row. */
  allLast?: boolean;
}
interface Props {
  /** CSS selector for the searchable cards. */
  target: string;
  /** Selector for group wrappers hidden when they end up empty. */
  section?: string;
  placeholder?: string;
  facets?: Facet[];
  facetSets?: FacetSet[];
}
const {
  target,
  section = '',
  placeholder = 'Search the record',
  facets = [],
  facetSets = [],
} = Astro.props;
// Normalise to labelled sets: the explicit list, or the single unlabelled set
// the `facets` prop has always described.
const sets = (facetSets.length ? facetSets : [{ label: '', facets }]).map((set) => ({
  ...set,
  hasDefault: set.facets.some((facet) => facet.default),
}));
---

<div class="rs" data-target={target} data-section={section}>
  <div class="rs__row">
    <input
      class="rs__input"
      type="search"
      placeholder={placeholder}
      aria-label={placeholder}
      autocomplete="off"
      spellcheck="false"
    />
    <span class="rs__count" role="status" aria-live="polite"></span>
  </div>
  {sets.map((set) => (
    <div
      class="rs__facets"
      data-multiple={set.multiple ? '' : undefined}
      data-all-last={set.allLast ? '' : undefined}
      hidden={set.facets.length === 0}
    >
      <span class="rs__setlabel" hidden={!set.label}>{set.label}</span>
      <button
        type="button"
        class:list={['rs__facet', 'rs__facet--all', { 'is-on': !set.hasDefault }]}
        data-facet-all
        aria-pressed={set.hasDefault ? 'false' : 'true'}
      >All</button>
      {set.facets.map((f) => (
        <button
          type="button"
          class:list={['rs__facet', { 'is-on': f.default }]}
          data-facet={f.value ?? ''}
          data-facet-attr={f.attr}
          data-facet-match={f.matchAttr}
          data-default={f.default ? '' : undefined}
          aria-pressed={f.default ? 'true' : 'false'}
        >{f.label}</button>
      ))}
    </div>
  ))}
</div>

<script>
  // Shared by every visibility owner on the page. An element is visible only
  // when nothing has claimed a reason to hide it.
  window.applyVisibility = window.applyVisibility || function (el) {
    // `data-beyond` (not revealed yet) is ignored while a filter is active:
    // a search must see the whole record, not just the part already browsed.
    const filtering = document.documentElement.hasAttribute('data-filtering');
    el.hidden = el.hasAttribute('data-nomatch')
      || (!filtering && el.hasAttribute('data-beyond'));
  };

  document.querySelectorAll('.rs').forEach((rs) => {
    const targetSel = rs.getAttribute('data-target') || '';
    const sectionSel = rs.getAttribute('data-section') || '';
    const input = rs.querySelector('.rs__input');
    const count = rs.querySelector('.rs__count');
    const cards = [...document.querySelectorAll(targetSel)];
    const sections = sectionSel ? [...document.querySelectorAll(sectionSel)] : [];
    // Text is read once: these cards are static, and re-reading textContent on
    // every keystroke over a few hundred nodes is the one thing that would
    // make this feel slow.
    // The card excerpt is truncated, so the full note travels in data-search.
    // Without it, searching the tail of a note would silently match nothing.
    const haystacks = new Map(cards.map((c) => [
      c,
      ((c.textContent || '') + ' ' + (c.getAttribute('data-search') || '')).toLowerCase(),
    ]));
    // One state per facet row. A row contributes nothing while its All button
    // is active. Multi-select choices are ORed within their row; active rows
    // are ANDed with each other.
    const sets = [...rs.querySelectorAll('.rs__facets')].map((row) => ({
      buttons: [...row.querySelectorAll('.rs__facet')],
      multiple: row.hasAttribute('data-multiple'),
      selected: [],
    }));

    function facetMatches(card, btn) {
      const attr = btn.getAttribute('data-facet-attr') || '';
      const value = btn.getAttribute('data-facet') || '';
      const match = btn.getAttribute('data-facet-match') || 'data-group';
      return attr ? card.hasAttribute(attr) : card.getAttribute(match) === value;
    }

    function syncButtons(set) {
      for (const btn of set.buttons) {
        const on = btn.hasAttribute('data-facet-all')
          ? set.selected.length === 0
          : set.selected.includes(btn);
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    }

    function apply() {
      const q = (input.value || '').trim().toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      const active = sets.filter((s) => s.selected.length > 0);
      const filtering = terms.length > 0 || active.length > 0;
      // Set before any element is evaluated: applyVisibility reads it.
      if (filtering) document.documentElement.setAttribute('data-filtering', '');
      else document.documentElement.removeAttribute('data-filtering');
      let shown = 0;
      for (const card of cards) {
        const hay = haystacks.get(card) || '';
        const okFacet = active.every((s) =>
          s.selected.some((btn) => facetMatches(card, btn)));
        const okText = terms.every((t) => hay.includes(t));
        const show = okFacet && okText;
        // Ownership split: this component decides *matching*, and anything
        // else on the page (progressive reveal) decides *revealing*. Both
        // write their own flag; applyVisibility derives `hidden` from the
        // pair, so neither overrides the other.
        if (show) card.removeAttribute('data-nomatch');
        else card.setAttribute('data-nomatch', '');
        applyVisibility(card);
        if (show) shown += 1;
      }
      for (const sec of sections) {
        // Progressive reveal hides unrevealed cards without any filter being
        // active, and that must not empty their section. Only an active
        // filter collapses a section whose cards all failed to match.
        if (!filtering) { sec.hidden = false; continue; }
        const any = [...sec.querySelectorAll(targetSel)].some((c) => !c.hidden);
        sec.hidden = !any;
      }
      count.textContent = filtering
        ? `${shown} of ${cards.length} shown`
        : `${cards.length} items`;
      // Other visibility owners (the reveal control) may need to re-evaluate
      // now that filtering has started or stopped.
      document.dispatchEvent(new CustomEvent('rs:filter', { detail: { filtering } }));
    }

    input.addEventListener('input', apply);
    for (const set of sets) {
      set.buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.hasAttribute('data-facet-all')) {
            set.selected = [];
          } else if (set.multiple) {
            set.selected = set.selected.includes(btn)
              ? set.selected.filter((selected) => selected !== btn)
              : [...set.selected, btn];
          } else {
            set.selected = [btn];
          }
          syncButtons(set);
          apply();
        });
      });
    }
    // Initialise defaults without dispatching several intermediate filter
    // states when a multi-select row starts with more than one choice.
    for (const set of sets) {
      const defaults = set.buttons.filter((b) => b.hasAttribute('data-default'));
      set.selected = set.multiple ? defaults : defaults.slice(0, 1);
      syncButtons(set);
    }
    apply();
  });
</script>

<style>
  .rs { margin: 1.2rem 0 1.6rem; }
  .rs__row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .rs__input {
    flex: 1; min-width: 15rem;
    padding: .6rem .85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit; font-size: .92rem;
  }
  .rs__input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .rs__count {
    font-family: var(--font-mono); font-size: .66rem; color: var(--ink-3);
    letter-spacing: .06em; text-transform: uppercase;
  }
  .rs__facets { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .6rem; align-items: center; }
  .rs__facets[data-all-last] .rs__facet--all {
    order: 2;
    margin-left: auto;
  }
  .rs__setlabel {
    font-family: var(--font-mono); font-size: .66rem; color: var(--ink-3);
    letter-spacing: .06em; text-transform: uppercase;
    margin-right: .3rem;
  }
  .rs__facet {
    font-family: var(--font-mono); font-size: .6rem; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .6rem;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--surface); color: var(--ink-3);
    cursor: pointer;
  }
  .rs__facet:hover { color: var(--ink); border-color: var(--rule-2); }
  .rs__facet.is-on {
    background: var(--accent-soft); color: var(--accent); border-color: var(--accent);
  }
</style>
