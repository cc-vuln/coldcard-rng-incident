---
import Fig from './Fig.astro';

const caption = `One 32-bit word of the 96-bit unique ID reaches the fallback, XORed with the SysTick counter; the remaining 64 bits are not read. The real-time clock and its subsecond register seed the other two state words.`;
---

<Fig
  id="fig-uid-flow"
  viewBox="0 0 940 240"
  minWidth={640}
  title="How the unique ID reaches the fallback generator"
  desc="The STM32L4 96-bit unique ID splits: the first 32-bit word is read by the fallback and XORed with SysTick, the remaining 64 bits are not read. The RTC time and subsecond registers seed the other Yasmarang state words, producing the MicroPython fallback output."
  caption={caption}
>
  <defs>
    <marker id="arr-uf" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <!-- UID source -->
  <rect class="node" x="16" y="88" width="170" height="72" rx="8" />
  <text class="t" x="101" y="118">STM32L4</text>
  <text class="s" x="101" y="136">96-bit unique ID</text>

  <!-- the word that is read -->
  <rect class="node warn" x="260" y="36" width="200" height="60" rx="8" />
  <text class="t" x="360" y="61">first 32-bit word</text>
  <text class="s" x="360" y="79">read by the fallback</text>

  <!-- the bits that are not -->
  <rect class="node dead" x="260" y="152" width="200" height="60" rx="8" />
  <text class="t dim" x="360" y="177">remaining 64 bits</text>
  <text class="s" x="360" y="195">not read by the fallback</text>

  <line class="edge" x1="186" y1="110" x2="256" y2="66" marker-end="url(#arr-uf)" />
  <line class="edge" x1="186" y1="136" x2="256" y2="182" marker-end="url(#arr-uf)" />

  <!-- XOR with SysTick -->
  <line class="edge" x1="460" y1="66" x2="530" y2="66" marker-end="url(#arr-uf)" />
  <circle class="xor" cx="560" cy="66" r="26" />
  <text class="tx" x="560" y="71">XOR</text>
  <text class="el" x="497" y="48">with SysTick-&gt;VAL</text>

  <!-- resulting state -->
  <rect class="node warn" x="660" y="36" width="260" height="60" rx="8" />
  <text class="t" x="790" y="61">Yasmarang state</text>
  <text class="s" x="790" y="79">pad from the XOR, n and d from the RTC</text>

  <line class="edge" x1="586" y1="66" x2="656" y2="66" marker-end="url(#arr-uf)" />

  <!-- RTC input -->
  <rect class="node warn" x="470" y="170" width="180" height="56" rx="8" />
  <text class="t" x="560" y="194">RTC time and</text>
  <text class="t" x="560" y="210">subsecond</text>

  <line class="edge" x1="610" y1="170" x2="750" y2="100" marker-end="url(#arr-uf)" />

  <!-- output -->
  <rect class="node warn" x="660" y="160" width="260" height="56" rx="8" />
  <text class="t" x="790" y="194">MicroPython fallback output</text>

  <line class="edge" x1="790" y1="96" x2="790" y2="156" marker-end="url(#arr-uf)" />

  <style>
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.warn {
      fill: var(--warn-soft);
      stroke: var(--warn);
    }
    .node.dead {
      fill: none;
      stroke: var(--ink-3);
      stroke-dasharray: 6 4;
    }
    .t {
      font: 600 13px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .t.dim { fill: var(--ink-3); }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .xor {
      fill: var(--info-soft);
      stroke: var(--info);
      stroke-width: 1.5;
    }
    .tx {
      font: 600 11px var(--font-mono);
      fill: var(--info);
      text-anchor: middle;
    }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      text-anchor: middle;
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
