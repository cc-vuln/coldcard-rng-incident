---
import Fig from './Fig.astro';

const caption = `The call path and the libngu stream are unchanged. What changes is the link: CHIP_TRNG_32() still resolves to rng_get(), but the board's own rng.c now provides that symbol, backed by the STM32 hardware RNG, and the MicroPython fallback source is excluded from the build.`;
---

<Fig
  id="fig-after-hotfix"
  viewBox="0 0 960 486"
  minWidth={720}
  title="Seed generation after the hotfix"
  desc="The board's own rng.c now provides rng_get, backed by the STM32 hardware RNG, so the XOR output incorporates hardware random words. The libngu Yasmarang is unchanged and still XORed in. The MicroPython fallback source is excluded from the fixed build."
  caption={caption}
>
  <defs>
    <marker id="arr-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
    <marker id="arr-ah-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah ok" />
    </marker>
  </defs>

  <text class="band" x="16" y="28">AFTER THE HOTFIX</text>

  <!-- excluded fallback source, in the slot the inputs occupied -->
  <rect class="node dead" x="16" y="106" width="210" height="84" rx="8" />
  <text class="t dim" x="121" y="132">MicroPython Yasmarang</text>
  <text class="s" x="121" y="150">fallback source excluded</text>
  <text class="s" x="121" y="166">by the fixed build rule</text>
  <text class="el no" x="121" y="96">&#10005; compiled as an empty object</text>

  <!-- the board's rng_get, in the slot the fallback occupied -->
  <rect class="node ok" x="320" y="106" width="200" height="84" rx="8" />
  <text class="t mono" x="420" y="132">board rng.c</text>
  <text class="s mono" x="420" y="150">rng_get()</text>
  <text class="s" x="420" y="168">new in the hotfix</text>

  <!-- the peripheral, now reached, same slot as before -->
  <rect class="node ok" x="560" y="36" width="220" height="64" rx="8" />
  <text class="t" x="670" y="62">STM32 RNG peripheral</text>
  <text class="s" x="670" y="80">raises OSError on timeout</text>

  <line class="edge ok-edge" x1="440" y1="106" x2="598" y2="100" marker-end="url(#arr-ah-ok)" />
  <text class="el yes" x="516" y="92">hardware words</text>

  <!-- libngu lane, unchanged -->
  <rect class="node info" x="16" y="300" width="210" height="74" rx="8" />
  <text class="t" x="121" y="326">Compile-time initial state</text>
  <text class="s mono" x="121" y="343">pad 0x0a8ce26f</text>
  <text class="s mono" x="121" y="359">n 69, d 233, unchanged</text>

  <rect class="node info" x="16" y="392" width="210" height="70" rx="8" />
  <text class="t" x="121" y="416">Mk4/Mk5/Q normal boot</text>
  <text class="s" x="121" y="433">secure-element-derived reseed</text>
  <text class="s" x="121" y="449">unchanged</text>

  <line class="edge" x1="226" y1="337" x2="316" y2="355" marker-end="url(#arr-ah)" />
  <line class="edge dashed" x1="226" y1="427" x2="316" y2="385" marker-end="url(#arr-ah)" />

  <rect class="node info" x="320" y="330" width="200" height="84" rx="8" />
  <text class="t" x="420" y="356">libngu Yasmarang</text>
  <text class="s mono" x="420" y="374">my_yasmarang()</text>
  <text class="s" x="420" y="392">unchanged, still XORed in</text>

  <!-- XOR and outputs, same grid as before -->
  <line class="edge ok-edge" x1="520" y1="148" x2="610" y2="234" marker-end="url(#arr-ah-ok)" />
  <text class="el" x="560" y="172">CHIP_TRNG_32()</text>
  <line class="edge" x1="520" y1="372" x2="610" y2="266" marker-end="url(#arr-ah)" />

  <circle class="xor" cx="640" cy="250" r="28" />
  <text class="tx" x="640" y="255">XOR</text>

  <line class="edge" x1="668" y1="250" x2="706" y2="250" marker-end="url(#arr-ah)" />

  <rect class="node ok" x="710" y="225" width="230" height="50" rx="8" />
  <text class="t mono" x="825" y="256">ngu.random.bytes(32)</text>

  <line class="edge" x1="825" y1="275" x2="825" y2="301" marker-end="url(#arr-ah)" />

  <rect class="node ok" x="710" y="305" width="230" height="56" rx="8" />
  <text class="t" x="825" y="330">SHA-256 whitening</text>
  <text class="s" x="825" y="347">version-dependent</text>

  <line class="edge" x1="825" y1="361" x2="825" y2="386" marker-end="url(#arr-ah)" />

  <rect class="node ok" x="710" y="390" width="230" height="50" rx="8" />
  <text class="t" x="825" y="421">Your 24 words</text>

  <style>
    .band {
      font: 600 11px var(--font-ui);
      letter-spacing: 0.14em;
      fill: var(--safe);
    }
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.ok {
      fill: var(--safe-soft);
      stroke: var(--safe);
    }
    .node.info {
      fill: var(--info-soft);
      stroke: var(--info);
    }
    .node.dead {
      fill: none;
      stroke: var(--ink-3);
      stroke-dasharray: 6 4;
    }
    .t {
      font: 600 13.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .t.dim { fill: var(--ink-3); }
    .t.mono { font-family: var(--font-mono); font-size: 12.5px; }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .s.mono { font-family: var(--font-mono); font-size: 10.5px; }
    .xor {
      fill: var(--info-soft);
      stroke: var(--info);
      stroke-width: 1.5;
    }
    .tx {
      font: 600 12px var(--font-mono);
      fill: var(--info);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .edge.dashed { stroke-dasharray: 5 4; }
    .ok-edge { stroke: var(--safe); }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      text-anchor: middle;
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .el.no { fill: var(--danger); }
    .el.yes { fill: var(--safe); }
    .ah { fill: var(--ink-3); }
    .ah.ok { fill: var(--safe); }
  </style>
</Fig>
