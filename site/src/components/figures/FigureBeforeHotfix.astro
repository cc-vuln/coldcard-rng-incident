---
import Fig from './Fig.astro';

const caption = `On Mk2 and Mk3, the libngu stream starts from published constants. On the normal Mk4, Mk5 and Q boot path, one libngu state word is overwritten by a secure-element-derived value. In both cases the MicroPython side remains UID-and-timer derived, and the STM32 hardware RNG is not reached through this path.`;
---

<Fig
  id="fig-before-hotfix"
  viewBox="0 0 960 486"
  minWidth={720}
  title="Seed generation before the hotfix"
  desc="The MicroPython Yasmarang, seeded from the chip unique ID, SysTick and the real-time clock, and the libngu Yasmarang, started from published constants or an at-most-32-bit reseed, feed an XOR that produces the 32 seed bytes. The STM32 hardware RNG sits unconnected."
  caption={caption}
>
  <defs>
    <marker id="arr-bh" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <text class="band" x="16" y="28">BEFORE THE HOTFIX</text>

  <!-- MicroPython lane inputs -->
  <rect class="node warn" x="16" y="52" width="210" height="58" rx="8" />
  <text class="t" x="121" y="78">MCU unique ID</text>
  <text class="s" x="121" y="95">fixed device metadata</text>

  <rect class="node warn" x="16" y="122" width="210" height="58" rx="8" />
  <text class="t mono" x="121" y="148">SysTick-&gt;VAL</text>
  <text class="s" x="121" y="165">boot-relative counter</text>

  <rect class="node warn" x="16" y="192" width="210" height="58" rx="8" />
  <text class="t mono" x="121" y="218">RTC-&gt;TR, RTC-&gt;SSR</text>
  <text class="s" x="121" y="235">wall clock, subsecond</text>

  <line class="edge" x1="226" y1="81" x2="316" y2="130" marker-end="url(#arr-bh)" />
  <line class="edge" x1="226" y1="151" x2="316" y2="148" marker-end="url(#arr-bh)" />
  <line class="edge" x1="226" y1="221" x2="316" y2="166" marker-end="url(#arr-bh)" />

  <!-- MicroPython Yasmarang -->
  <rect class="node warn" x="320" y="106" width="200" height="84" rx="8" />
  <text class="t" x="420" y="132">MicroPython Yasmarang</text>
  <text class="s mono" x="420" y="150">rng_get()</text>
  <text class="s" x="420" y="168">software fallback</text>

  <!-- the peripheral that is not reached -->
  <rect class="node dead" x="560" y="36" width="220" height="64" rx="8" />
  <text class="t dim" x="670" y="62">STM32 RNG peripheral</text>
  <text class="s" x="670" y="80">not reached on this path</text>

  <line class="edge dead-edge" x1="440" y1="106" x2="598" y2="100" />
  <text class="el no" x="516" y="92">&#10005; not called</text>

  <!-- libngu lane inputs -->
  <rect class="node warn" x="16" y="300" width="210" height="74" rx="8" />
  <text class="t" x="121" y="326">Compile-time initial state</text>
  <text class="s mono" x="121" y="343">pad 0x0a8ce26f</text>
  <text class="s mono" x="121" y="359">n 69, d 233</text>

  <rect class="node warn" x="16" y="392" width="210" height="70" rx="8" />
  <text class="t" x="121" y="416">Mk4/Mk5/Q normal boot</text>
  <text class="s" x="121" y="433">secure-element-derived reseed</text>
  <text class="s" x="121" y="449">32 bits into one state word</text>

  <line class="edge" x1="226" y1="337" x2="316" y2="355" marker-end="url(#arr-bh)" />
  <line class="edge dashed" x1="226" y1="427" x2="316" y2="385" marker-end="url(#arr-bh)" />

  <!-- libngu Yasmarang -->
  <rect class="node warn" x="320" y="330" width="200" height="84" rx="8" />
  <text class="t" x="420" y="356">libngu Yasmarang</text>
  <text class="s mono" x="420" y="374">my_yasmarang()</text>
  <text class="s" x="420" y="392">second stream</text>

  <!-- XOR and outputs -->
  <line class="edge" x1="520" y1="148" x2="610" y2="234" marker-end="url(#arr-bh)" />
  <text class="el" x="560" y="172">CHIP_TRNG_32()</text>
  <line class="edge" x1="520" y1="372" x2="610" y2="266" marker-end="url(#arr-bh)" />

  <circle class="xor" cx="640" cy="250" r="28" />
  <text class="tx" x="640" y="255">XOR</text>

  <line class="edge" x1="668" y1="250" x2="706" y2="250" marker-end="url(#arr-bh)" />

  <rect class="node bad" x="710" y="225" width="230" height="50" rx="8" />
  <text class="t mono" x="825" y="256">ngu.random.bytes(32)</text>

  <line class="edge" x1="825" y1="275" x2="825" y2="301" marker-end="url(#arr-bh)" />

  <rect class="node bad" x="710" y="305" width="230" height="56" rx="8" />
  <text class="t" x="825" y="330">SHA-256 whitening</text>
  <text class="s" x="825" y="347">version-dependent</text>

  <line class="edge" x1="825" y1="361" x2="825" y2="386" marker-end="url(#arr-bh)" />

  <rect class="node bad" x="710" y="390" width="230" height="50" rx="8" />
  <text class="t" x="825" y="421">Your 24 words</text>

  <style>
    .band {
      font: 600 11px var(--font-ui);
      letter-spacing: 0.14em;
      fill: var(--danger);
    }
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.warn {
      fill: var(--warn-soft);
      stroke: var(--warn);
    }
    .node.bad {
      fill: var(--danger-soft);
      stroke: var(--danger);
    }
    .node.dead {
      fill: none;
      stroke: var(--ink-3);
      stroke-dasharray: 6 4;
    }
    .t {
      font: 600 13.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .t.dim { fill: var(--ink-3); }
    .t.mono { font-family: var(--font-mono); font-size: 12.5px; }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .s.mono { font-family: var(--font-mono); font-size: 10.5px; }
    .xor {
      fill: var(--info-soft);
      stroke: var(--info);
      stroke-width: 1.5;
    }
    .tx {
      font: 600 12px var(--font-mono);
      fill: var(--info);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .edge.dashed { stroke-dasharray: 5 4; }
    .dead-edge {
      stroke: var(--ink-3);
      stroke-width: 1.25;
      stroke-dasharray: 5 4;
    }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      text-anchor: middle;
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .el.no { fill: var(--danger); }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
