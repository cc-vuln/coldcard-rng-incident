---
import Fig from './Fig.astro';

const caption = `The intended chain begins with the STM32 hardware RNG. The regression changed the source behind the byte-generation call.`;
---

<Fig
  id="fig-intended-chain"
  viewBox="0 0 936 172"
  minWidth={640}
  title="Intended seed-generation design"
  desc="Five stages left to right: the STM32 hardware random number generator produces 16 or 32 random bytes, SHA-256 whitening is applied, the result is encoded as 12 or 24 BIP39 words, and those give the BIP32 master key."
  caption={caption}
>
  <defs>
    <marker id="arr-ic" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <text class="band" x="8" y="28">INTENDED DESIGN</text>

  <!-- stage 1 -->
  <rect class="node ok" x="8" y="52" width="156" height="66" rx="8" />
  <text class="t" x="86" y="80">STM32 RNG</text>
  <text class="s" x="86" y="98">analogue noise source</text>

  <line class="edge" x1="164" y1="85" x2="195" y2="85" marker-end="url(#arr-ic)" />

  <!-- stage 2 -->
  <rect class="node ok" x="199" y="52" width="156" height="66" rx="8" />
  <text class="t" x="277" y="80">Random bytes</text>
  <text class="s" x="277" y="98">16 or 32, by call</text>

  <line class="edge" x1="355" y1="85" x2="386" y2="85" marker-end="url(#arr-ic)" />

  <!-- stage 3 -->
  <rect class="node ok" x="390" y="52" width="156" height="66" rx="8" />
  <text class="t" x="468" y="74">SHA-256 whitening</text>
  <text class="s" x="468" y="90">single or double</text>
  <text class="s" x="468" y="105">by version</text>

  <line class="edge" x1="546" y1="85" x2="577" y2="85" marker-end="url(#arr-ic)" />

  <!-- stage 4 -->
  <rect class="node ok" x="581" y="52" width="156" height="66" rx="8" />
  <text class="t" x="659" y="80">BIP39 encoding</text>
  <text class="s" x="659" y="98">12 or 24 words</text>

  <line class="edge" x1="737" y1="85" x2="768" y2="85" marker-end="url(#arr-ic)" />

  <!-- stage 5 -->
  <rect class="node ok" x="772" y="52" width="156" height="66" rx="8" />
  <text class="t" x="850" y="80">BIP32 master key</text>
  <text class="s" x="850" y="98">then your addresses</text>

  <style>
    .band {
      font: 600 11px var(--font-ui);
      letter-spacing: 0.14em;
      fill: var(--safe);
    }
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.ok {
      fill: var(--safe-soft);
      stroke: var(--safe);
    }
    .t {
      font: 600 13.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
