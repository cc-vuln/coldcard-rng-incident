---
import Fig from './Fig.astro';

const caption = `The documented design. A uniform hardware term independent of the PRNG would make the XOR output uniform even if the other input were predictable, so independence and successful hardware sampling are load-bearing parts of the stated construction.`;
---

<Fig
  id="fig-documented-design"
  viewBox="0 0 920 250"
  minWidth={620}
  title="Documented seed-generation design"
  desc="A hardware TRNG measuring analogue transistor noise and a PRNG seeded at boot from the two secure elements feed an XOR, whose output passes through SHA-256 whitening to produce the 256-bit seed."
  caption={caption}
>
  <defs>
    <marker id="arr-dd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <!-- hardware TRNG input -->
  <rect class="node" x="20" y="40" width="200" height="64" rx="8" />
  <text class="t" x="120" y="68">Hardware TRNG</text>
  <text class="s" x="120" y="86">analogue transistor noise</text>

  <!-- PRNG input -->
  <rect class="node" x="20" y="146" width="200" height="78" rx="8" />
  <text class="t" x="120" y="172">PRNG</text>
  <text class="s" x="120" y="189">seeded at boot from</text>
  <text class="s" x="120" y="205">SE1 and SE2 TRNGs</text>

  <line class="edge" x1="220" y1="72" x2="313" y2="113" marker-end="url(#arr-dd)" />
  <line class="edge" x1="220" y1="185" x2="313" y2="137" marker-end="url(#arr-dd)" />

  <!-- XOR junction -->
  <circle class="xor" cx="340" cy="125" r="27" />
  <text class="tx" x="340" y="130">XOR</text>

  <line class="edge" x1="367" y1="125" x2="446" y2="125" marker-end="url(#arr-dd)" />

  <!-- whitening -->
  <rect class="node" x="450" y="93" width="210" height="64" rx="8" />
  <text class="t" x="555" y="121">SHA-256 whitening</text>
  <text class="s" x="555" y="139">described as reducing bias</text>

  <line class="edge" x1="660" y1="125" x2="736" y2="125" marker-end="url(#arr-dd)" />

  <!-- seed out -->
  <rect class="node" x="740" y="93" width="160" height="64" rx="8" />
  <text class="t mono" x="820" y="130">256-bit seed</text>

  <style>
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .xor {
      fill: var(--info-soft);
      stroke: var(--info);
      stroke-width: 1.5;
    }
    .t {
      font: 600 13.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .t.mono { font-family: var(--font-mono); font-size: 13px; }
    .tx {
      font: 600 12px var(--font-mono);
      fill: var(--info);
      text-anchor: middle;
    }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
