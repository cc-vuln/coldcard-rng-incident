---
import Fig from './Fig.astro';

const caption = `Solid edges show the on-chain movements as mapped in Galaxy Research's published flow of funds, with TFTC's published collector receipt and Block's reported 695-transaction set. The dotted edge marks the reported attribution of the 695-transaction set to the same operator. Both sets fall within Galaxy's published 41-minute window.`;
---

<Fig
  id="fig-funds-flow"
  viewBox="0 0 960 330"
  minWidth={700}
  title="Source-to-collector fund movements"
  desc="Five hundred source addresses sending about 594.48 BTC reach a first collector receiving 594.47722484 BTC, then the largest final holding plus a retained remainder. Six hundred ninety-five attributed source transactions reported by Block reach three first collectors receiving 488.10957948 BTC, then two batch consolidations. Both lanes end at the four final holdings Galaxy published, the largest 562.01962301 BTC. A dotted edge marks the reported same-operator attribution between the two sets."
  caption={caption}
>
  <defs>
    <marker id="arr-ff" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <!-- lane 1: the 500-address set -->
  <rect class="node" x="20" y="40" width="220" height="76" rx="8" />
  <text class="t" x="130" y="68">500 source addresses</text>
  <text class="m" x="130" y="90">about 594.48 BTC</text>

  <line class="edge" x1="240" y1="78" x2="286" y2="78" marker-end="url(#arr-ff)" />

  <rect class="node" x="290" y="40" width="200" height="76" rx="8" />
  <text class="t" x="390" y="68">first collector</text>
  <text class="m" x="390" y="90">594.47722484 BTC</text>

  <line class="edge" x1="490" y1="78" x2="536" y2="78" marker-end="url(#arr-ff)" />

  <rect class="node" x="540" y="40" width="190" height="76" rx="8" />
  <text class="t" x="635" y="66">largest final holding</text>
  <text class="s" x="635" y="84">plus retained remainder</text>

  <line class="edge" x1="730" y1="82" x2="758" y2="146" marker-end="url(#arr-ff)" />

  <!-- lane 2: the attributed 695-transaction set -->
  <rect class="node" x="20" y="200" width="220" height="76" rx="8" />
  <text class="t" x="130" y="224">695 attributed source</text>
  <text class="t" x="130" y="241">transactions</text>
  <text class="m" x="130" y="263">reported by Block</text>

  <line class="edge" x1="240" y1="238" x2="286" y2="238" marker-end="url(#arr-ff)" />

  <rect class="node" x="290" y="200" width="200" height="76" rx="8" />
  <text class="t" x="390" y="228">three first collectors</text>
  <text class="m" x="390" y="250">488.10957948 BTC</text>

  <line class="edge" x1="490" y1="238" x2="536" y2="238" marker-end="url(#arr-ff)" />

  <rect class="node" x="540" y="200" width="190" height="76" rx="8" />
  <text class="t" x="635" y="232">two batch</text>
  <text class="t" x="635" y="249">consolidations</text>

  <line class="edge" x1="730" y1="234" x2="758" y2="182" marker-end="url(#arr-ff)" />

  <!-- shared destination -->
  <rect class="node bad" x="760" y="120" width="180" height="88" rx="8" />
  <text class="t" x="850" y="146">four final holdings</text>
  <text class="m" x="850" y="168">largest 562.01962301 BTC</text>
  <text class="s" x="850" y="188">published by Galaxy, 31 Jul</text>

  <!-- attribution -->
  <line class="edge dashed" x1="130" y1="200" x2="130" y2="120" marker-end="url(#arr-ff)" />
  <text class="el" x="142" y="162">same-operator attribution</text>

  <style>
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.bad {
      fill: var(--danger-soft);
      stroke: var(--danger);
    }
    .t {
      font: 600 12.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .m {
      font: 11px var(--font-mono);
      fill: var(--ink-2);
      text-anchor: middle;
    }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .edge.dashed { stroke-dasharray: 5 4; }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
