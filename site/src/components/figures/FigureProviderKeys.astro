---
import Fig from './Fig.astro';

// The caption for this figure is passed by the page through the caption
// slot, because it carries a Claim marker.
---

<Fig
  id="fig-provider-keys"
  viewBox="0 0 920 418"
  minWidth={640}
  title="Provider-held keys in the threshold count"
  desc="An example 2-of-3 collaborative vault has owner key 1 from an affected COLDCARD seed, owner key 2 of other origin, and a provider-held key whose origin must be confirmed. If the provider key was not generated by an affected COLDCARD, one affected key is below the 2-of-3 threshold; if it was, two affected keys may meet the threshold."
  caption=""
>
  <slot name="caption" slot="caption" />
  <defs>
    <marker id="arr-pk" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <rect class="node ask" x="20" y="150" width="190" height="84" rx="8" />
  <text class="t" x="115" y="176">Example 2-of-3</text>
  <text class="t" x="115" y="193">collaborative vault</text>

  <line class="edge" x1="210" y1="176" x2="296" y2="66" marker-end="url(#arr-pk)" />
  <line class="edge" x1="210" y1="192" x2="296" y2="156" marker-end="url(#arr-pk)" />
  <line class="edge" x1="210" y1="208" x2="296" y2="250" marker-end="url(#arr-pk)" />

  <rect class="node bad" x="300" y="24" width="230" height="64" rx="8" />
  <text class="t" x="415" y="50">Owner key 1</text>
  <text class="s" x="415" y="68">affected COLDCARD seed</text>

  <rect class="node ok" x="300" y="124" width="230" height="64" rx="8" />
  <text class="t" x="415" y="150">Owner key 2</text>
  <text class="s" x="415" y="168">other origin</text>

  <rect class="node warn" x="300" y="224" width="230" height="64" rx="8" />
  <text class="t" x="415" y="250">Provider-held key</text>
  <text class="s" x="415" y="268">origin must be confirmed</text>

  <line class="edge" x1="530" y1="256" x2="616" y2="256" marker-end="url(#arr-pk)" />

  <rect class="node ask" x="620" y="214" width="270" height="84" rx="8" />
  <text class="t" x="755" y="240">Was the provider key also</text>
  <text class="t" x="755" y="257">generated by an affected</text>
  <text class="t" x="755" y="274">COLDCARD?</text>

  <line class="edge" x1="755" y1="214" x2="755" y2="100" marker-end="url(#arr-pk)" />
  <text class="el" x="770" y="160">No</text>

  <rect class="node ok" x="620" y="24" width="270" height="72" rx="8" />
  <text class="t" x="755" y="50">One affected key</text>
  <text class="s" x="755" y="68">below the 2-of-3 threshold</text>

  <line class="edge" x1="755" y1="298" x2="755" y2="326" marker-end="url(#arr-pk)" />
  <text class="el" x="770" y="316">Yes</text>

  <rect class="node bad" x="620" y="330" width="270" height="72" rx="8" />
  <text class="t" x="755" y="356">Two affected keys</text>
  <text class="s" x="755" y="374">threshold may be met</text>

  <style>
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.ask {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
    .node.bad {
      fill: var(--danger-soft);
      stroke: var(--danger);
    }
    .node.ok {
      fill: var(--safe-soft);
      stroke: var(--safe);
    }
    .node.warn {
      fill: var(--warn-soft);
      stroke: var(--warn);
    }
    .t {
      font: 600 12.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .s {
      font: 11px var(--font-ui);
      fill: var(--ink-3);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
