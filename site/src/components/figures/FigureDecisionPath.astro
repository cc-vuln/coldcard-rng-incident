---
import Fig from './Fig.astro';

const caption = `The branches identify which technical question comes next. They are not a substitute for the model-specific firmware range below.`;
---

<Fig
  id="fig-decision-path"
  viewBox="0 0 960 958"
  minWidth={720}
  title="Decision path for assessing exposure"
  desc="Where did the mnemonic come from: imported or generated elsewhere leads to a provenance check; generated on a COLDCARD leads to the firmware version at generation, then the dice workflow, then how funds are controlled, splitting into single-signature and threshold-wallet outcomes."
  caption={caption}
>
  <defs>
    <marker id="arr-dp" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" class="ah" />
    </marker>
  </defs>

  <!-- origin question -->
  <rect class="node ask" x="380" y="20" width="200" height="52" rx="8" />
  <text class="t" x="480" y="42">Where did the</text>
  <text class="t" x="480" y="59">mnemonic come from?</text>

  <line class="edge" x1="440" y1="72" x2="360" y2="126" marker-end="url(#arr-dp)" />
  <text class="el" x="336" y="102" text-anchor="end">imported or generated elsewhere</text>
  <line class="edge" x1="530" y1="72" x2="690" y2="126" marker-end="url(#arr-dp)" />
  <text class="el" x="640" y="96" text-anchor="middle">generated on a COLDCARD</text>

  <!-- provenance branch -->
  <rect class="node ask" x="230" y="130" width="240" height="72" rx="8" />
  <text class="t" x="350" y="154">Generation method and</text>
  <text class="t" x="350" y="171">provenance independently</text>
  <text class="t" x="350" y="188">verified?</text>

  <line class="edge" x1="290" y1="202" x2="125" y2="258" marker-end="url(#arr-dp)" />
  <text class="el" x="252" y="228" text-anchor="end">yes, outside the affected path</text>
  <rect class="node ok" x="20" y="262" width="190" height="64" rx="8" />
  <text class="t" x="115" y="288">Not affected by</text>
  <text class="t" x="115" y="305">this generator</text>

  <line class="edge" x1="360" y1="202" x2="360" y2="258" marker-end="url(#arr-dp)" />
  <text class="el" x="372" y="234">no or unknown</text>
  <rect class="node" x="250" y="262" width="220" height="64" rx="8" />
  <text class="t" x="360" y="288">Assess the original</text>
  <text class="t" x="360" y="305">generation method</text>

  <!-- firmware branch -->
  <rect class="node ask" x="590" y="130" width="220" height="72" rx="8" />
  <text class="t" x="700" y="162">Firmware used</text>
  <text class="t" x="700" y="179">at generation</text>

  <line class="edge" x1="640" y1="202" x2="570" y2="258" marker-end="url(#arr-dp)" />
  <text class="el" x="614" y="230" text-anchor="end">before affected range</text>
  <rect class="node ok" x="490" y="262" width="150" height="64" rx="8" />
  <text class="t" x="565" y="288">Not affected by</text>
  <text class="t" x="565" y="305">this incident</text>

  <line class="edge" x1="750" y1="202" x2="830" y2="248" marker-end="url(#arr-dp)" />
  <text class="el" x="762" y="222">named vendor fix release</text>
  <rect class="node info" x="730" y="252" width="210" height="84" rx="8" />
  <text class="t" x="835" y="276">Source fix verified;</text>
  <text class="t" x="835" y="293">published binary not</text>
  <text class="t" x="835" y="310">independently checked here</text>

  <line class="edge" x1="700" y1="202" x2="696" y2="386" marker-end="url(#arr-dp)" />
  <text class="el" x="712" y="360">inside affected range or unknown</text>

  <!-- dice branch -->
  <rect class="node ask" x="590" y="390" width="200" height="56" rx="8" />
  <text class="t" x="690" y="424">Dice workflow</text>

  <line class="edge" x1="640" y1="446" x2="445" y2="506" marker-end="url(#arr-dp)" />
  <text class="el" x="592" y="474" text-anchor="end">pure dice, sufficient fair secret rolls</text>
  <rect class="node ok" x="330" y="510" width="210" height="64" rx="8" />
  <text class="t" x="435" y="536">Affected generator</text>
  <text class="t" x="435" y="553">bypassed</text>

  <line class="edge" x1="700" y1="446" x2="668" y2="506" marker-end="url(#arr-dp)" />
  <text class="el" x="712" y="478">mixed dice</text>
  <rect class="node warn" x="580" y="510" width="170" height="56" rx="8" />
  <text class="t" x="665" y="534">Assess roll count</text>
  <text class="t" x="665" y="551">and secrecy</text>

  <line class="edge" x1="750" y1="446" x2="752" y2="616" marker-end="url(#arr-dp)" />
  <text class="el" x="764" y="540">none or unknown</text>
  <line class="edge" x1="665" y1="566" x2="668" y2="616" marker-end="url(#arr-dp)" />

  <!-- control question -->
  <rect class="node ask" x="590" y="620" width="220" height="64" rx="8" />
  <text class="t" x="700" y="648">How are funds</text>
  <text class="t" x="700" y="665">controlled?</text>

  <line class="edge" x1="650" y1="684" x2="445" y2="746" marker-end="url(#arr-dp)" />
  <text class="el" x="604" y="712" text-anchor="end">single signature</text>
  <rect class="node warn" x="330" y="750" width="200" height="56" rx="8" />
  <text class="t" x="430" y="774">Assess passphrase</text>
  <text class="t" x="430" y="791">and migrate</text>

  <line class="edge" x1="750" y1="684" x2="738" y2="736" marker-end="url(#arr-dp)" />
  <text class="el" x="764" y="710">threshold wallet</text>
  <rect class="node ask" x="620" y="740" width="230" height="72" rx="8" />
  <text class="t" x="735" y="766">Count affected keys</text>
  <text class="t" x="735" y="783">against threshold</text>

  <line class="edge" x1="700" y1="812" x2="510" y2="854" marker-end="url(#arr-dp)" />
  <text class="el" x="626" y="832" text-anchor="end">below threshold</text>
  <rect class="node info" x="380" y="858" width="220" height="72" rx="8" />
  <text class="t" x="490" y="884">Affected keys alone cannot</text>
  <text class="t" x="490" y="901">sign: rotate them</text>

  <line class="edge" x1="790" y1="812" x2="800" y2="854" marker-end="url(#arr-dp)" />
  <text class="el" x="806" y="834">at or above threshold</text>
  <rect class="node warn" x="680" y="858" width="260" height="84" rx="8" />
  <text class="t" x="810" y="882">Check script, descriptor and</text>
  <text class="t" x="810" y="899">public-key exposure</text>
  <text class="t" x="810" y="916">before moving</text>

  <style>
    .node {
      fill: var(--surface-2);
      stroke: var(--rule-2);
      stroke-width: 1.25;
    }
    .node.ask {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
    .node.ok {
      fill: var(--safe-soft);
      stroke: var(--safe);
    }
    .node.info {
      fill: var(--info-soft);
      stroke: var(--info);
    }
    .node.warn {
      fill: var(--warn-soft);
      stroke: var(--warn);
    }
    .t {
      font: 600 12.5px var(--font-ui);
      fill: var(--ink);
      text-anchor: middle;
    }
    .edge {
      stroke: var(--ink-3);
      stroke-width: 1.5;
      fill: none;
    }
    .el {
      font: 10.5px var(--font-mono);
      fill: var(--ink-3);
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 4px;
    }
    .ah { fill: var(--ink-3); }
  </style>
</Fig>
