---
import {
  SYSTICK_STATES, FULL_UNKNOWN_BITS, RESEED_BITS,
  LLFOURN_MK3_BITS, LLFOURN_MK4_BITS,
} from '../lib/entropy-models';

const DEVICE_MODELS = [
  {
    group: 'Block: Mk2 / Mk3',
    id: 'block-mk23-known',
    label: 'Block: timers and fallback state known (2^0)',
    minBits: 0,
    maxBits: 0,
    kind: 'conditional known-state case',
    relation: 'exact',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'Block describes one candidate when the relevant timer values, UID term and call history are known.',
  },
  {
    group: 'Block: Mk2 / Mk3',
    id: 'block-mk23-rtc',
    label: 'Block: stable-RTC scenario (about 2^16.3)',
    minBits: Math.log2(SYSTICK_STATES),
    maxBits: Math.log2(SYSTICK_STATES),
    kind: 'scenario',
    relation: 'approximate',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'Block models 80,000 SysTick possibilities when the real-time clock is stable and the other state is known.',
  },
  {
    group: 'Block: Mk2 / Mk3',
    id: 'block-mk23-uid-unknown',
    label: 'Block: UID-XOR-SysTick word unknown (at most 2^32)',
    minBits: FULL_UNKNOWN_BITS,
    maxBits: FULL_UNKNOWN_BITS,
    kind: 'upper-bound sensitivity',
    relation: 'at-most',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'Block gives a 2^32 ceiling when the effective 32-bit UID_low32 XOR SysTick value is entirely unknown. Block adds that unknown RNG-call history multiplies this count further.',
  },
  {
    group: 'Coinkite: Mk3 only',
    id: 'coinkite-mk23',
    label: 'Coinkite: published estimate (about 2^40)',
    minBits: 40,
    maxBits: 40,
    kind: 'published estimate',
    relation: 'approximate',
    source: 'Coinkite',
    href: '/record/sources/coinkite-backgrounder/',
    note: 'Coinkite retains uncertainty from the MCU identifier and timing inputs. This is an estimate, not a population measurement.',
  },
  {
    group: 'LLFOURN: Mk3 only',
    id: 'llfourn-mk3',
    label: 'LLFOURN: Mk3 model (about 2^40.3)',
    minBits: LLFOURN_MK3_BITS,
    maxBits: LLFOURN_MK3_BITS,
    kind: 'published estimate',
    relation: 'approximate',
    source: 'LLFOURN',
    href: '/record/sources/llfourn-model/',
    note: 'LLFOURN states about 2^20 MCU identifiers, 80,000 timing states and 16 button-press variants for Mk3.',
  },
  {
    group: 'Block: Mk2 / Mk3',
    id: 'block-mk23-ceiling',
    label: 'Block: loose enumeration ceiling (below 2^40.7)',
    minBits: Math.log2(SYSTICK_STATES * 86_400 * 256),
    maxBits: Math.log2(SYSTICK_STATES * 86_400 * 256),
    kind: 'upper-bound sensitivity',
    relation: 'below',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'This is a strict loose ceiling, not a lower bound or measured entropy. The result preserves that less-than relation.',
  },
  {
    group: 'Block: Mk4 / Mk5 / Q, successful reseed',
    id: 'block-mk4-known',
    label: 'Block: fallback state known (at most 2^32)',
    minBits: RESEED_BITS,
    maxBits: RESEED_BITS,
    kind: 'upper-bound sensitivity',
    relation: 'at-most',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'A successful reseed overwrites one 32-bit libngu state word. The calculator evaluates the at-most-32-bit boundary.',
  },
  {
    group: 'LLFOURN: Mk4 only',
    id: 'llfourn-mk4-known',
    label: 'LLFOURN: known-UID pessimistic case (2^32)',
    minBits: RESEED_BITS,
    maxBits: RESEED_BITS,
    kind: 'published estimate',
    relation: 'approximate',
    source: 'LLFOURN',
    href: '/record/sources/llfourn-2083312169316499663/',
    note: 'LLFOURN says known UID and more predictable button and clock behaviour can leave 32 bits of work per theft.',
  },
  {
    group: 'LLFOURN: Mk4 / Mk5 / Q',
    id: 'llfourn-mk4-revised',
    label: 'LLFOURN follow-up: revised range (about 2^58.3 to 2^62.3)',
    minBits: LLFOURN_MK4_BITS - 14,
    maxBits: LLFOURN_MK4_BITS - 10,
    kind: 'derived range from a published revision',
    relation: 'approximate',
    source: 'LLFOURN',
    href: '/record/sources/llfourn-followup/',
    note: 'LLFOURN later said the Mk4/Mk5/Q bit space was probably 10 to 14 bits smaller than the original estimate. This site derives the displayed endpoints by subtracting that range from the earlier model.',
  },
  {
    group: 'Coinkite: Mk4 / Mk5 / Q',
    id: 'coinkite-mk4',
    label: 'Coinkite: published estimate (about 2^72)',
    minBits: 72,
    maxBits: 72,
    kind: 'published estimate',
    relation: 'approximate',
    source: 'Coinkite',
    href: '/record/sources/coinkite-backgrounder/',
    note: 'Coinkite retains uncertainty from the MCU identifier, timing inputs and the 32-bit reseed. This is not a device measurement.',
  },
  {
    group: 'LLFOURN: Mk4 / Mk5 / Q',
    id: 'llfourn-mk4-initial',
    label: 'LLFOURN: initial model (about 2^72.3)',
    minBits: LLFOURN_MK4_BITS,
    maxBits: LLFOURN_MK4_BITS,
    kind: 'superseded published estimate',
    relation: 'approximate',
    source: 'LLFOURN',
    href: '/record/sources/llfourn-model/',
    note: 'This is LLFOURN\'s original Mk4-class model. A later post narrowed it by 10 to 14 bits.',
  },
  {
    group: 'Block: Mk4 / Mk5 / Q, successful reseed',
    id: 'block-mk4-ceiling',
    label: 'Block: loose enumeration ceiling (below 2^73.3)',
    minBits: Math.log2(120_000 * 86_400 * 256) + RESEED_BITS,
    maxBits: Math.log2(120_000 * 86_400 * 256) + RESEED_BITS,
    kind: 'upper-bound sensitivity',
    relation: 'below',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'This is a strict loose ceiling. The result preserves that less-than relation, and the timer terms are deliberately treated independently.',
  },
  {
    group: 'otaliptus: Mk4 only, tentative RTC models',
    id: 'otaliptus-mk4-rtc-problematic',
    label: 'otaliptus: RTC problematic (about 2^52 to 2^63)',
    minBits: 52,
    maxBits: 63,
    kind: 'tentative published range',
    relation: 'approximate',
    source: 'otaliptus',
    href: '/record/sources/otaliptus-technical/',
    note: 'The author labels this brainstorming and says details may be wrong. It assumes a remote attacker does not know the UID.',
  },
  {
    group: 'otaliptus: Mk4 only, tentative RTC models',
    id: 'otaliptus-mk4-rtc-working',
    label: 'otaliptus: RTC contributes (about 2^75 to 2^88)',
    minBits: 75,
    maxBits: 88,
    kind: 'tentative published range',
    relation: 'approximate',
    source: 'otaliptus',
    href: '/record/sources/otaliptus-technical/',
    note: 'The author labels this brainstorming and leaves the Mk4 RTC contribution unresolved.',
  },
  {
    group: 'Block: Mk4 / Mk5 / Q, conditional no-reseed path',
    id: 'block-mk4-no-reseed-known',
    label: 'Block: no reseed, UID/timers and call history known (2^0)',
    minBits: 0,
    maxBits: 0,
    kind: 'conditional known-state case',
    relation: 'exact',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'This requires a catchable exception before reseeding. One candidate follows only when the MicroPython UID/timer state and RNG-call history are also known. Block says ordinary production secure-element failures appear to halt, so hardware reachability remains unverified.',
  },
  {
    group: 'Block: Mk4 / Mk5 / Q, conditional no-reseed path',
    id: 'block-mk4-no-reseed-ceiling',
    label: 'Block: loose no-reseed ceiling (below 2^41.3)',
    minBits: Math.log2(120_000 * 86_400 * 256),
    maxBits: Math.log2(120_000 * 86_400 * 256),
    kind: 'conditional upper-bound sensitivity',
    relation: 'below',
    source: 'Block',
    href: '/record/sources/block-disclosure/',
    note: 'This is a strict loose ceiling. The no-reseed source path remains conditional pending hardware validation.',
  },
];

const groupedModels = [...new Set(DEVICE_MODELS.map(({ group }) => group))]
  .map((group) => [group, DEVICE_MODELS.filter((model) => model.group === group)] as const);
---

<section class="estimator" data-estimator aria-labelledby="estimator-heading">
  <div class="estimator__intro">
    <p class="mono-label">Interactive sensitivity model</p>
    <h2 id="estimator-heading">Build an attack scenario</h2>
    <p>
      Select descriptions of how secrets were generated. Do not enter
      wallet-specific data. The estimator script does not transmit inputs or
      write them to browser storage; current selections remain in page memory.
    </p>
  </div>

  <form class="estimator__form" data-form>
    <fieldset class="estimator__fieldset" aria-describedby="estimator-target-note">
      <legend>1. What does the attacker still need to search?</legend>
      <div class="choice-grid">
        <label class="choice">
          <input type="radio" name="target" value="seed" checked />
          <span><strong>Mnemonic candidates</strong><small>Device state, with optional dice</small></span>
        </label>
        <label class="choice">
          <input type="radio" name="target" value="passphrase" />
          <span><strong>Passphrase only</strong><small>The attacker has identified the mnemonic</small></span>
        </label>
        <label class="choice">
          <input type="radio" name="target" value="combined" />
          <span><strong>Mnemonic and passphrase</strong><small>Conditional combined search</small></span>
        </label>
      </div>
      <p class="field-note" id="estimator-target-note" data-target-note>
        This mode estimates the work to find a mnemonic from the selected device
        and dice model.
      </p>
    </fieldset>

    <fieldset class="estimator__fieldset" data-seed-fields>
      <legend>2. Describe mnemonic generation</legend>
      <label class="field" data-device-field>
        <span>Source model</span>
        <select name="deviceModel" data-device-model aria-describedby="estimator-model-note">
          <option value="">Choose one scenario</option>
          {groupedModels.map(([group, models]) => (
            <optgroup label={group}>
              {models?.map((model) => (
                <option
                  value={model.id}
                  data-min-bits={model.minBits}
                  data-max-bits={model.maxBits}
                  data-kind={model.kind}
                  data-relation={model.relation}
                  data-source={model.source}
                  data-href={model.href}
                  data-note={model.note}
                >
                  {model.label}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <p class="model-note" id="estimator-model-note" data-model-note aria-live="polite" hidden>
        <span data-model-kind></span>. <span data-model-copy></span>
        <a data-model-source href="/how-it-broke/entropy/">Read the source model</a>.
      </p>

      <div class="field-row">
        <label class="field">
          <span>Dice path</span>
          <select name="diceMode" data-dice-mode aria-describedby="estimator-dice-note">
            <option value="none">No independent dice term</option>
            <option value="mixed">Mixed into a device-generated seed</option>
            <option value="pure">Pure dice, replacing the device path</option>
          </select>
        </label>
        <label class="field" data-roll-field hidden>
          <span>Fair, independent D6 rolls</span>
          <input name="rolls" type="number" inputmode="numeric" min="1" max="1000" step="1" value="50" aria-describedby="estimator-dice-note" />
        </label>
        <label class="field" data-output-field hidden>
          <span>Mnemonic entropy size</span>
          <select name="outputBits" aria-describedby="estimator-dice-note">
            <option value="128">12 words, 128-bit entropy</option>
            <option value="256">24 words, 256-bit entropy</option>
          </select>
        </label>
      </div>
      <p class="field-note" id="estimator-dice-note" data-dice-note aria-live="polite" hidden></p>
    </fieldset>

    <fieldset class="estimator__fieldset" data-passphrase-fields hidden>
      <legend data-passphrase-legend>3. Describe the passphrase construction</legend>
      <div class="field-row">
        <label class="field">
          <span>Uniform random construction</span>
          <select name="passphraseKind" data-passphrase-kind aria-describedby="estimator-passphrase-note">
            <option value="diceware" data-base="7776" data-default-length="5">Diceware words, 7,776-word list</option>
            <option value="bip39" data-base="2048" data-default-length="8">BIP39 English-list words used as text</option>
            <option value="lowercase" data-base="26" data-default-length="10">Lowercase characters, 26-character alphabet</option>
            <option value="alphanumeric" data-base="62" data-default-length="12">Alphanumeric characters, 62-character alphabet</option>
            <option value="custom">Custom ideal uncertainty in bits</option>
          </select>
        </label>
        <label class="field" data-passphrase-length-field>
          <span data-passphrase-length-label>Number of words</span>
          <input name="passphraseLength" type="number" inputmode="numeric" min="1" max="50" step="1" value="5" aria-describedby="estimator-passphrase-note" />
        </label>
        <label class="field" data-custom-bits-field hidden>
          <span>Ideal uncertainty in bits</span>
          <input name="customBits" type="number" inputmode="decimal" min="0" max="512" step="0.1" value="64" aria-describedby="estimator-passphrase-note" />
        </label>
      </div>
      <p class="field-note" id="estimator-passphrase-note">
        These constructions assume every choice is independent and uniform, and
        that the attacker knows the alphabet, list, length and separator. A
        human-chosen or reused phrase cannot be assigned ideal entropy from its
        length here. Results are capped at the 512-bit BIP39 seed output. A
        particular wallet-data target may impose a lower effective collision
        boundary.
      </p>
    </fieldset>

    <fieldset class="estimator__fieldset">
      <legend data-rate-legend>3. Set a candidate-check rate</legend>
      <div class="field-row">
        <label class="field">
          <span>Checks per second</span>
          <select name="ratePreset" data-rate-preset aria-describedby="estimator-rate-note">
            <option value="4000">4,000/s</option>
            <option value="2000000" selected>2 million/s</option>
            <option value="16000000">16 million/s</option>
            <option value="1000000000">1 billion/s</option>
            <option value="custom">Custom rate</option>
          </select>
        </label>
        <label class="field" data-custom-rate-field hidden>
          <span>Custom checks per second</span>
          <input name="customRate" type="number" inputmode="decimal" min="0.000001" max="1000000000000000" step="any" value="2000000" aria-describedby="estimator-rate-note" />
        </label>
      </div>
      <p class="field-note" id="estimator-rate-note">
        This is a sensitivity input, not a measured benchmark. One check means
        testing a complete candidate against the target wallet data. Device-state
        and PBKDF2 passphrase checks may have very different real rates.
      </p>
    </fieldset>

    <div class="estimator__controls">
      <button class="estimator__reset" type="reset">Reset inputs</button>
    </div>
  </form>

  <section class="result" data-result aria-live="polite" aria-atomic="true">
    <h3 class="result__eyebrow">Illustrative result</h3>
    <p class="result__empty" id="estimator-result-message" data-empty>Choose a published device scenario to calculate the search time.</p>
    <div data-result-values hidden>
      <div class="result__headline">
        <div>
          <span>Modelled search-space boundary</span>
          <strong data-space></strong>
        </div>
        <div>
          <span>Half-space time</span>
          <strong data-half-time></strong>
        </div>
        <div>
          <span>Full-space time</span>
          <strong data-full-time></strong>
        </div>
      </div>
      <p class="result__equation" data-equation></p>
      <p class="result__relation" data-relation-note></p>
      <p class="result__qualification" data-qualification></p>
    </div>
  </section>

  <noscript>
    <div class="callout callout--amber">
      <span class="callout__title">JavaScript is off</span>
      The calculator needs JavaScript. The same source scenarios and static
      half-space examples remain available in
      <a href="/how-it-broke/entropy/">Attack-cost estimates</a>, with separate
      <a href="/risk/mitigations/#passphrase">passphrase</a> and
      <a href="/risk/mitigations/#dice">dice</a> tables.
    </div>
  </noscript>
</section>

<script is:inline>
(() => {
  const root = document.querySelector('[data-estimator]');
  if (!root) return;

  const form = root.querySelector('[data-form]');
  const seedFields = root.querySelector('[data-seed-fields]');
  const passphraseFields = root.querySelector('[data-passphrase-fields]');
  const passphraseLegend = root.querySelector('[data-passphrase-legend]');
  const rateLegend = root.querySelector('[data-rate-legend]');
  const targetNote = root.querySelector('[data-target-note]');
  const deviceField = root.querySelector('[data-device-field]');
  const deviceSelect = root.querySelector('[data-device-model]');
  const modelNote = root.querySelector('[data-model-note]');
  const modelKind = root.querySelector('[data-model-kind]');
  const modelCopy = root.querySelector('[data-model-copy]');
  const modelSource = root.querySelector('[data-model-source]');
  const diceSelect = root.querySelector('[data-dice-mode]');
  const rollField = root.querySelector('[data-roll-field]');
  const outputField = root.querySelector('[data-output-field]');
  const diceNote = root.querySelector('[data-dice-note]');
  const passphraseSelect = root.querySelector('[data-passphrase-kind]');
  const passphraseLengthField = root.querySelector('[data-passphrase-length-field]');
  const passphraseLengthLabel = root.querySelector('[data-passphrase-length-label]');
  const customBitsField = root.querySelector('[data-custom-bits-field]');
  const rateSelect = root.querySelector('[data-rate-preset]');
  const customRateField = root.querySelector('[data-custom-rate-field]');
  const empty = root.querySelector('[data-empty]');
  const values = root.querySelector('[data-result-values]');
  const space = root.querySelector('[data-space]');
  const halfTime = root.querySelector('[data-half-time]');
  const fullTime = root.querySelector('[data-full-time]');
  const equation = root.querySelector('[data-equation]');
  const relationNote = root.querySelector('[data-relation-note]');
  const qualification = root.querySelector('[data-qualification]');

  const number = new Intl.NumberFormat('en-US', { maximumSignificantDigits: 3 });
  const precise = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 });
  const secondsPerYear = 365.25 * 86_400;

  const fieldNumber = (name) => Number(form.elements[name].value);
  const targetMode = () => form.elements.target.value;

  const setVisibility = (element, visible) => {
    element.hidden = !visible;
    element.querySelectorAll('input, select').forEach((control) => {
      control.disabled = !visible;
    });
  };

  const relationSymbol = (relation) => ({
    exact: '=',
    approximate: '\u2248',
    'at-most': '\u2264',
    below: '<',
  }[relation] || '\u2248');

  const relationDescription = (relation) => ({
    exact: 'The underlying candidate count is exact under the stated conditional inputs; a non-integer displayed exponent and all displayed times are rounded.',
    approximate: 'This is an approximate scenario. Candidate counts and times remain approximate.',
    'at-most': 'This is an at-most boundary. Candidate counts and times are ceilings, not expected values.',
    below: 'This is a strict loose ceiling. Candidate counts and times stay below the displayed values.',
  }[relation] || 'The displayed result is an illustrative sensitivity calculation.');

  const formatBits = (minBits, maxBits, relation = 'approximate') => {
    const directed = relation === 'below' || relation === 'at-most';
    const displayBits = (bits) => directed
      ? Math.ceil(bits * 10) / 10
      : bits;
    const min = precise.format(displayBits(minBits));
    const max = precise.format(displayBits(maxBits));
    const value = Math.abs(minBits - maxBits) < 1e-9
      ? `2^${min}`
      : `2^${min} to 2^${max}`;
    const exactlyDisplayed = [minBits, maxBits]
      .every((bits) => Math.abs((bits * 100) - Math.round(bits * 100)) < 1e-9);
    const displayRelation = relation === 'exact' && !exactlyDisplayed
      ? 'approximate'
      : relation;
    return `${relationSymbol(displayRelation)} ${value}`;
  };

  const roundSignificant = (value, digits = 3) => Number(value.toPrecision(digits));
  const ceilSignificant = (value, digits = 3) => {
    if (value === 0) return 0;
    const scale = 10 ** (digits - 1 - Math.floor(Math.log10(Math.abs(value))));
    return Math.ceil(value * scale) / scale;
  };
  const durationValue = (value, direction) => direction === 'up'
    ? ceilSignificant(value)
    : roundSignificant(value);
  const durationUnit = (value, unit) =>
    `${number.format(value)} ${unit}${Math.abs(value - 1) < 1e-12 ? '' : 's'}`;

  const formatDuration = (seconds, direction = 'nearest') => {
    if (!Number.isFinite(seconds)) return 'beyond numeric range';
    if (seconds < 0.001) return durationUnit(durationValue(seconds, direction), 'second');
    if (seconds < 60) return durationUnit(durationValue(seconds, direction), 'second');
    if (seconds < 3_600) return durationUnit(durationValue(seconds / 60, direction), 'minute');
    if (seconds < 86_400) return durationUnit(durationValue(seconds / 3_600, direction), 'hour');
    if (seconds < 63_115_200) return durationUnit(durationValue(seconds / 86_400, direction), 'day');

    const years = seconds / secondsPerYear;
    if (years >= 1e33) return `${durationValue(years, direction).toExponential(2)} years`;
    const magnitudes = [
      [1e30, 'nonillion'],
      [1e27, 'octillion'],
      [1e24, 'septillion'],
      [1e21, 'sextillion'],
      [1e18, 'quintillion'],
      [1e15, 'quadrillion'],
      [1e12, 'trillion'],
      [1e9, 'billion'],
      [1e6, 'million'],
    ];
    const magnitude = magnitudes.find(([size]) => years >= size);
    if (magnitude) return `${number.format(durationValue(years / magnitude[0], direction))} ${magnitude[1]} years`;
    return durationUnit(durationValue(years, direction), 'year');
  };

  const formatRange = (low, high, formatter) => {
    const first = formatter(low);
    const second = formatter(high);
    return Math.abs(low - high) < Math.max(1e-12, Math.abs(high) * 1e-12)
      ? first
      : `${first} to ${second}`;
  };

  const formatQualifiedRange = (low, high, formatter, relation) => {
    const timeRelation = relation === 'exact' ? 'approximate' : relation;
    const direction = relation === 'below' || relation === 'at-most' ? 'up' : 'nearest';
    return `${relationSymbol(timeRelation)} ${formatRange(low, high, (value) => formatter(value, direction))}`;
  };

  const passphraseBits = () => {
    const option = passphraseSelect.selectedOptions[0];
    if (option.value === 'custom') return fieldNumber('customBits');
    return Math.log2(Number(option.dataset.base)) * fieldNumber('passphraseLength');
  };

  const clearInvalid = () => {
    root.querySelectorAll('[aria-invalid="true"]').forEach((control) => {
      control.removeAttribute('aria-invalid');
      control.removeAttribute('aria-errormessage');
    });
  };

  const markInvalid = (control) => {
    control.setAttribute('aria-invalid', 'true');
    control.setAttribute('aria-errormessage', 'estimator-result-message');
  };

  const updateControls = (event) => {
    const target = targetMode();
    const usesSeed = target !== 'passphrase';
    const usesPassphrase = target !== 'seed';
    setVisibility(seedFields, usesSeed);
    setVisibility(passphraseFields, usesPassphrase);

    passphraseLegend.textContent = target === 'passphrase'
      ? '2. Describe the passphrase construction'
      : '3. Describe the passphrase construction';
    rateLegend.textContent = target === 'seed'
      ? '3. Set a candidate-check rate'
      : target === 'passphrase'
        ? '3. Set a candidate-check rate'
        : '4. Set a candidate-check rate';

    targetNote.textContent = target === 'seed'
      ? 'This mode estimates the work to find a mnemonic from the selected device and dice model.'
      : target === 'passphrase'
        ? 'This conservative mode assumes the attacker has identified the mnemonic, so only the passphrase candidate space remains.'
        : 'Multiplying the spaces is valid only when the target does not let the attacker isolate the mnemonic and passphrase searches. The result is conditional, not a universal wallet cost.';

    const diceMode = diceSelect.value;
    const needsDeviceModel = usesSeed && diceMode !== 'pure';
    setVisibility(deviceField, needsDeviceModel);

    const selectedModel = deviceSelect.selectedOptions[0];
    const hasModel = needsDeviceModel && Boolean(selectedModel?.value);
    modelNote.hidden = !hasModel;
    if (hasModel) {
      modelKind.textContent = selectedModel.dataset.kind;
      modelCopy.textContent = selectedModel.dataset.note;
      modelSource.textContent = `Read ${selectedModel.dataset.source}'s source`;
      modelSource.href = selectedModel.dataset.href;
    }

    const usesDice = usesSeed && diceMode !== 'none';
    setVisibility(rollField, usesDice);
    setVisibility(outputField, usesDice);
    diceNote.hidden = !usesDice;
    if (usesDice) {
      diceNote.textContent = diceMode === 'pure'
        ? 'Pure dice replaces the device scenario. Usable mnemonic uncertainty is the smaller of roll entropy and output size.'
        : 'Mixed dice adds independent roll uncertainty to the selected device model, capped by the mnemonic output size.';
    }

    const passphraseOption = passphraseSelect.selectedOptions[0];
    const customPassphrase = passphraseOption.value === 'custom';
    setVisibility(passphraseLengthField, usesPassphrase && !customPassphrase);
    setVisibility(customBitsField, usesPassphrase && customPassphrase);
    passphraseLengthLabel.textContent = ['diceware', 'bip39'].includes(passphraseOption.value)
      ? 'Number of words'
      : 'Number of characters';
    if (event?.target === passphraseSelect && !customPassphrase) {
      form.elements.passphraseLength.value = passphraseOption.dataset.defaultLength;
    }

    setVisibility(customRateField, rateSelect.value === 'custom');
  };

  const calculate = () => {
    clearInvalid();
    const target = targetMode();
    const selectedModel = deviceSelect.selectedOptions[0];
    let minSeedBits = 0;
    let maxSeedBits = 0;
    // Passphrase-only mode keeps this initial value: an ideal uniform
    // construction is a ceiling on real passphrase uncertainty, not an
    // exact count. Every other mode overwrites it from the seed branch.
    let resultRelation = 'at-most';
    const parts = [];

    if (target !== 'passphrase') {
      const diceMode = diceSelect.value;
      if (diceMode !== 'pure' && !selectedModel?.value) {
        markInvalid(deviceSelect);
        empty.textContent = 'Choose a published device scenario to calculate the search time.';
        empty.hidden = false;
        values.hidden = true;
        return;
      }

      const outputBits = fieldNumber('outputBits');
      const rolls = fieldNumber('rolls');
      const rollBits = rolls * Math.log2(6);
      const rollLabel = `D6 roll${rolls === 1 ? '' : 's'}`;
      if (diceMode !== 'none' && (
        !Number.isInteger(rolls) || rolls < 1 || rolls > 1_000
      )) {
        markInvalid(form.elements.rolls);
        empty.textContent = 'Enter a whole-number roll count from 1 to 1,000.';
        empty.hidden = false;
        values.hidden = true;
        return;
      }
      if (diceMode === 'pure') {
        minSeedBits = Math.min(rollBits, outputBits);
        maxSeedBits = minSeedBits;
        resultRelation = 'at-most';
        parts.push(`pure dice: ${rolls} ${rollLabel} (${precise.format(rollBits)} input bits), capped at ${outputBits} output bits`);
      } else {
        minSeedBits = Number(selectedModel.dataset.minBits);
        maxSeedBits = Number(selectedModel.dataset.maxBits);
        resultRelation = selectedModel.dataset.relation || 'approximate';
        parts.push(`${selectedModel.textContent.trim()}: ${formatBits(minSeedBits, maxSeedBits, resultRelation)}`);
        if (diceMode === 'mixed') {
          const uncappedMixedMinBits = minSeedBits + rollBits;
          const uncappedMixedMaxBits = maxSeedBits + rollBits;
          const lowerEndpointCapped = uncappedMixedMinBits >= outputBits;
          const upperEndpointCapped = uncappedMixedMaxBits >= outputBits;
          minSeedBits = Math.min(minSeedBits + rollBits, outputBits);
          maxSeedBits = Math.min(maxSeedBits + rollBits, outputBits);
          if (lowerEndpointCapped || resultRelation === 'exact') {
            resultRelation = 'at-most';
          }
          const capNote = lowerEndpointCapped
            ? `both endpoints capped at ${outputBits} output bits`
            : upperEndpointCapped
              ? `upper endpoint capped at ${outputBits} output bits`
              : `${outputBits}-bit output cap not reached`;
          parts.push(`mixed dice: ${rolls} ${rollLabel}, +${precise.format(rollBits)} bits, ${capNote}`);
        }
      }
    }

    let phraseBits = 0;
    if (target !== 'seed') {
      const phraseLength = fieldNumber('passphraseLength');
      const customPassphrase = passphraseSelect.value === 'custom';
      const customBitsBlank = customPassphrase
        && form.elements.customBits.value.trim() === '';
      phraseBits = passphraseBits();
      if (!Number.isFinite(phraseBits) || phraseBits < 0 || customBitsBlank
        || (customPassphrase && phraseBits > 512)
        || (!customPassphrase && (
          !Number.isInteger(phraseLength) || phraseLength < 1 || phraseLength > 50
        ))) {
        markInvalid(customPassphrase
          ? form.elements.customBits
          : form.elements.passphraseLength);
        empty.textContent = 'Enter a valid passphrase uncertainty value.';
        empty.hidden = false;
        values.hidden = true;
        return;
      }
      const phraseModel = passphraseSelect.selectedOptions[0].textContent.trim();
      const phraseInput = customPassphrase
        ? `${precise.format(phraseBits)} stated bits`
        : `length ${phraseLength}, ${precise.format(phraseBits)} ideal bits`;
      parts.push(`passphrase: ${phraseModel}, ${phraseInput}`);
    }

    const rate = rateSelect.value === 'custom'
      ? fieldNumber('customRate')
      : Number(rateSelect.value);
    if (!Number.isFinite(rate) || rate < 0.000001 || rate > 1_000_000_000_000_000) {
      if (rateSelect.value === 'custom') markInvalid(form.elements.customRate);
      empty.textContent = 'Enter a candidate-check rate from 10^-6 through 10^15 per second.';
      empty.hidden = false;
      values.hidden = true;
      return;
    }

    const uncappedMinBits = minSeedBits + phraseBits;
    const uncappedMaxBits = maxSeedBits + phraseBits;
    const minBits = target === 'seed' ? uncappedMinBits : Math.min(uncappedMinBits, 512);
    const maxBits = target === 'seed' ? uncappedMaxBits : Math.min(uncappedMaxBits, 512);
    if (target !== 'seed' && uncappedMinBits >= 512) {
      resultRelation = 'at-most';
    }
    if (target !== 'seed' && uncappedMaxBits >= 512) {
      parts.push('BIP39 seed output: capped at 512 bits');
    }
    const minCandidates = 2 ** minBits;
    const maxCandidates = 2 ** maxBits;
    const halfChecks = (candidates) => Math.max(1, candidates / 2);
    const minHalfSeconds = halfChecks(minCandidates) / rate;
    const maxHalfSeconds = halfChecks(maxCandidates) / rate;
    const minFullSeconds = minCandidates / rate;
    const maxFullSeconds = maxCandidates / rate;

    space.textContent = formatBits(minBits, maxBits, resultRelation);
    halfTime.textContent = formatQualifiedRange(minHalfSeconds, maxHalfSeconds, formatDuration, resultRelation);
    fullTime.textContent = formatQualifiedRange(minFullSeconds, maxFullSeconds, formatDuration, resultRelation);
    equation.textContent = `${parts.join(' + ')} at ${number.format(rate)} checks/s.`;
    relationNote.textContent = relationDescription(resultRelation);
    qualification.textContent = target === 'combined'
      ? 'Conditional combined-space result. If wallet data lets the attacker identify the mnemonic separately, use passphrase-only mode instead. The 512-bit BIP39 output is a ceiling; a particular wallet-data target may have a lower effective collision boundary.'
      : target === 'passphrase'
        ? 'The mnemonic is treated as known. The stated uniform construction is an upper bound on the uncertainty in a real passphrase, so the result is a ceiling rather than an expected value. The 512-bit BIP39 output is a further ceiling; a particular wallet-data target may have a lower effective collision boundary.'
        : diceSelect.value === 'pure'
          ? 'The affected device model is bypassed. This assumes fair, independent, secret and accurately entered rolls.'
          : 'This is a sensitivity calculation for the selected published scenario, not a deadline or a measurement of this wallet.';

    empty.hidden = true;
    values.hidden = false;
  };

  form.addEventListener('input', (event) => {
    updateControls(event);
    calculate();
  });
  form.addEventListener('change', (event) => {
    updateControls(event);
    calculate();
  });
  form.addEventListener('reset', () => {
    window.setTimeout(() => {
      updateControls();
      calculate();
    }, 0);
  });
  form.addEventListener('submit', (event) => event.preventDefault());

  updateControls();
  calculate();
})();
</script>

