---
/**
 * The call for material, placed where a reader is already looking at the
 * collection rather than only in the footer.
 *
 * The project's premise is that crowdsourced material makes the most complete
 * record, so asking for it is a feature of the site, not a courtesy note in
 * the repository. The ask is deliberately concrete: people send things when
 * they know what is wanted and that it is easy.
 */
interface Props {
  /** Shown when the block sits under a specific collection rather than the landing. */
  context?: string;
}
const { context = '' } = Astro.props;
const CONTACT = import.meta.env.PUBLIC_CONTACT || 'info@cc-vuln.org';
const REPO = 'https://github.com/cc-vuln/coldcard-rng-incident';
---

<aside class="contrib" aria-labelledby="contrib-h">
  <p class="contrib__tag" id="contrib-h">Help complete the record</p>
  <p class="contrib__lead">
    {context || 'This collection is incomplete, and the gaps are the point.'}
    Threads, analyses, vendor statements, screenshots and corrections are all
    wanted, and a pointer to something we have missed is the single most useful
    thing you can send. You do not need to write anything up: a link is enough.
  </p>
  <p class="contrib__ways">
    <a class="contrib__btn" href={'mailto:' + CONTACT}>Email {CONTACT}</a>
    <a class="contrib__btn" href={REPO} rel="noopener">Open an issue on GitHub</a>
  </p>
  <p class="contrib__note">
    Published material only, please. Do not send anything containing recovery
    words, private keys or another person's private information.
  </p>
</aside>

<style>
  .contrib {
    border: 1px solid var(--rule-2);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 1.2rem var(--inset-box);
    margin-block: 2rem;
  }
  .contrib__tag {
    font-family: var(--font-mono); font-size: .63rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
  }
  .contrib__lead {
    margin-top: .5rem; max-width: 68ch;
    font-size: .98rem; line-height: 1.6;
  }
  .contrib__ways {
    display: flex; flex-wrap: wrap; gap: .6rem;
    margin-top: .9rem;
  }
  .contrib__btn {
    display: inline-block;
    font-size: .85rem;
    padding: .45rem .9rem;
    border: 1px solid var(--rule-2); border-radius: var(--radius);
    background: var(--surface); color: var(--ink);
    text-decoration: none;
  }
  .contrib__btn:hover, .contrib__btn:focus-visible {
    border-color: var(--accent); color: var(--accent);
  }
  .contrib__note {
    margin-top: .8rem;
    font-size: .8rem; color: var(--ink-3); max-width: 66ch;
  }
</style>
