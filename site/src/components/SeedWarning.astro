---
/**
 * Seed-word disclosure warning shown immediately before the exposure triage.
 *
 * Exposure assessment does not require secret material. Recovery can require
 * deliberate entry into an independently verified offline signer or recovery
 * tool, which is distinct from sending words to a remote service or person.
 *
 * `compact` renders the one-line form. It must not merely hide the detail:
 * `hidden` still ships every word, so the full 146-word warning was being
 * published on seven pages that only display the lead. The link out stays in
 * both forms, because a reader who needs the detail needs the way to it.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<aside class="sw" class:list={{ 'sw--compact': compact }} role="note">
  <p class="sw__tag">Protect recovery material</p>

  <p class="sw__lead">
    Do not disclose seed words to a website, form, support agent, email or
    message. Enter them only into an independently verified offline signer or
    recovery tool that you deliberately selected.
  </p>

  {!compact && (
    <div class="sw__more">
      <p>
        Checking exposure to this incident does not require the words, a passphrase,
        private keys or an extended private key. The relevant facts are the seed's
        original generation source, the model and firmware used at generation, and
        the dice workflow. Passphrase construction and wallet policy then affect the
        response.
      </p>
      <p>
        A request to submit recovery material for an exposure check, support case or
        remote migration would expose key material and, where public wallet data is
        known, enable offline passphrase testing. Supplying enough signing material
        to meet the wallet policy would give the recipient spending authority.
        Deliberate recovery on verified offline equipment is a separate operation.
      </p>
    </div>
  )}

  <p class="sw__foot">
    <a href="/safety/seed-words/">How to assess a request and respond to a disclosure &rarr;</a>
  </p>
</aside>

<style>
  .sw {
    border: 1px solid color-mix(in srgb, var(--danger) 45%, var(--rule));
    border-left: 3px solid var(--danger);
    background: var(--danger-soft);
    border-radius: var(--radius);
    padding: 1.2rem var(--inset-box);
    margin-block: 1.6rem;
  }
  .sw__tag {
    font-family: var(--font-mono); font-size: .63rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--danger);
  }
  .sw__lead {
    margin-top: .5rem;
    font-size: 1.02rem; line-height: 1.6; font-weight: 500;
    max-width: 68ch;
  }
  .sw__more { margin-top: .8rem; }
  .sw__more p { font-size: .89rem; line-height: 1.65; color: var(--ink-2); max-width: 70ch; }
  .sw__more p + p { margin-top: .6rem; }
  .sw__foot { margin-top: .6rem; }
  .sw__foot a {
    font-family: var(--font-mono); font-size: .76rem;
    color: var(--danger); text-decoration: none;
  }
  .sw__foot a:hover { text-decoration: underline; }

  .sw--compact { padding: .85rem var(--inset-box); margin-block: 0; }
  .sw--compact .sw__lead { font-size: .88rem; font-weight: 400; }
</style>
