---
/**
 * Interactive triage.
 *
 * The front door. Someone arrives frightened and needs an answer in under a
 * minute, not a long explainer. One to six questions, then a result
 * that names their situation and links to the depth.
 *
 * Design constraints:
 *  - Nothing leaves the browser. No analytics, no network calls, no seed words
 *    or xpubs are ever asked for. Said explicitly, because after an incident
 *    like this "enter your details to check" is exactly what the scams do.
 *  - Degrades without JavaScript: the noscript block below is a short prose
 *    summary plus a link to /risk/, which carries the same decision path as a
 *    static diagram and tables. The interactive tree itself is not rendered
 *    server-side, so /risk/ is the fallback, not this component.
 *  - Results state the cost range and whose estimate it is, rather than a
 *    single authoritative number, because the published figures genuinely differ.
 */
---

<section class="triage" id="triage" aria-labelledby="triage-h">
  <div class="triage__head">
    <p class="mono-label">Start here</p>
    <h2 id="triage-h">Are your coins affected?</h2>
    <p class="triage__sub">
      Six questions at most. Your answers are processed by code running in
      your browser and are not transmitted. <strong>This site never asks for
      seed words, passphrases or extended private keys</strong>.
    </p>
  </div>

  <div class="triage__app" data-triage>
    <div class="triage__progress" aria-hidden="true"><span data-bar></span></div>

    <div class="triage__stage" data-stage role="group" aria-live="polite"></div>

    <div class="triage__controls">
      <button type="button" class="btn btn--ghost" data-back hidden>Back</button>
      <button type="button" class="btn btn--ghost" data-restart hidden>Start over</button>
    </div>
  </div>

  <noscript>
    <div class="callout is-info">
      <span class="callout__title">JavaScript is off</span>
      <p>
        The interactive version needs it. The same logic is written out as a
        decision tree on <a href="/risk/">Your risk</a>, and the immediate classification is:
        a seed is affected if it was generated on a COLDCARD, on firmware from
        an affected firmware version. Pure dice generation starts from the rolls
        and bypasses the affected generator. Dice added to a device-generated
        seed are hashed into it, and Coinkite's advisory treats at least 50 fair,
        independent rolls that were never recorded or exposed as removing the
        risk from this RNG issue alone; fewer rolls, or any uncertainty about the
        count, the privacy of the rolls or which words you kept, leaves the seed
        in the affected group. Passphrases and multisig thresholds must then be
        assessed separately. See <a href="/risk/mitigations/#dice">dice-generated and
        dice-mixed seeds</a> for the conditions in full.
      </p>
    </div>
  </noscript>
</section>

<script is:inline>
(() => {
  const root = document.querySelector('[data-triage]');
  if (!root) return;
  const stage = root.querySelector('[data-stage]');
  const bar = root.querySelector('[data-bar]');
  const backBtn = root.querySelector('[data-back]');
  const restartBtn = root.querySelector('[data-restart]');

  // --- question graph -------------------------------------------------------
  // next() returns either a question id or a verdict id. Question numbering is
  // computed from the graph rather than stored per question: a hand-written
  // ordinal drifts as soon as a branch is added, which is how the component
  // previously showed two different questions as "4 of 4".
  const Q = {
    origin: {
      q: 'Where did this seed come from?',
      hint: 'The words themselves, not the device you use today.',
      opts: [
        { k: 'coldcard', label: 'Generated on a COLDCARD',
          sub: 'You pressed New Seed Words, or used the dice option, on the device' },
        { k: 'elsewhere_verified', label: 'Imported from a verified source outside the affected path',
          sub: 'Its original generation method and provenance were independently checked' },
        { k: 'elsewhere_unverified', label: 'Imported, but the original source is not independently verified',
          sub: 'The words may have originated on another device, including an affected COLDCARD' },
        { k: 'unsure', label: 'I am not sure',
          sub: 'The generation path remains unresolved until its provenance is checked' },
      ],
      next: (a) => {
        if (a === 'elsewhere_verified') return 'V_UNAFFECTED_IMPORT';
        if (a === 'coldcard') return 'when';
        return 'V_ORIGIN_UNVERIFIED';
      },
    },

    when: {
      q: 'When was the seed created, and on which model?',
      hint: 'What matters is the firmware running when the seed was made, not what is installed now. The date alone does not prove that the hotfix had been installed.',
      help: ['How to check your device\'s firmware version', '/record/firmware/#check-your-device'],
      opts: [
        { k: 'old', label: 'Mk1, or Mk2/Mk3 on v3.2.2 or earlier',
          sub: 'The pre-v4 firmware line' },
        { k: 'fixed', label: 'Generated after installing the model-specific hotfix',
          sub: 'Vendor-listed Mk2/Mk3 v4.2.0, Mk4/Mk5 v5.6.0, Q v1.5.0Q, or the named Edge 6.6.0 releases' },
        { k: 'mk23', label: 'Mk2 or Mk3 on the affected v4 firmware line',
          sub: 'Firmware v4.0.0 to v4.1.9' },
        { k: 'mk45q', label: 'Mk4, Mk5 or Q on an affected pre-hotfix release',
          sub: 'Mk4 v5.0.0 to v5.5.1, Mk5 v5.5.0 to v5.5.1, or Q v0.0.3Q to v1.4.1Q' },
        { k: 'unsure', label: 'I really do not know',
          sub: 'Treated as affected' },
      ],
      next: (a) => {
        if (a === 'old') return 'V_UNAFFECTED_OLD';
        if (a === 'fixed') return 'V_UNAFFECTED_FIXED';
        return 'dice';
      },
    },

    dice: {
      q: 'How were dice used when the seed was created?',
      hint: 'Pure dice generation starts from the rolls. Mixing dice into a device-generated seed is a different path and did not enforce a minimum on affected firmware, but the rolls were still hashed into the seed.',
      opts: [
        { k: 'pure_met', label: 'Pure dice, with the full minimum',
          sub: 'At least 50 D6 rolls for 12 words, or 99 for 24 words' },
        { k: 'pure_short', label: 'Pure dice, but fewer rolls or I am unsure',
          sub: 'The exact count and output length must be checked' },
        { k: 'mixed', label: 'I added dice to a device-generated seed',
          sub: 'Add Dice Rolls on the word screen. The next question decides how this is classified' },
        { k: 'none', label: 'No, or I do not remember',
          sub: 'No independent dice margin is assumed' },
      ],
      next: (a) => {
        if (a === 'pure_met') return 'V_UNAFFECTED_DICE';
        if (a === 'pure_short') return 'V_DICE_REVIEW';
        if (a === 'mixed') return 'mixed_rolls';
        return 'held';
      },
    },

    // Coinkite's advisory draws its dice exception at 50 fair, independent,
    // private rolls and applies it to mixed dice as well as pure dice. Before
    // this branch existed, every mixed-dice answer fell through to `held` and
    // the component told a user with 99 private rolls to prioritise migration.
    mixed_rolls: {
      q: 'How many rolls did you add, and were they private?',
      hint: 'The vendor draws its dice exception at 50 fair, independent rolls that were never recorded or exposed. Secrecy covers anything that could have captured the rolls, including a photograph of the device screen while you entered them.',
      help: ['What the dice paths do, and the conditions attached', '/risk/mitigations/#dice'],
      opts: [
        { k: 'met', label: 'At least 50 fair, independent rolls, and they stayed private',
          sub: 'Never written down, photographed or screen-recorded, and I know which words I kept afterwards' },
        { k: 'short', label: 'Fewer than 50 rolls',
          sub: 'The rolls still added search space, but below the threshold the vendor uses' },
        { k: 'unknown', label: 'I am not certain of the count, the fairness, the privacy or which words I kept',
          sub: 'Treated as affected, which is what the advisory itself directs' },
      ],
      next: (a) => {
        if (a === 'met') return 'V_UNAFFECTED_MIXED_DICE';
        if (a === 'short') return 'V_MIXED_DICE_REVIEW';
        return 'held';
      },
    },

    held: {
      q: 'How are the coins held?',
      hint: 'A passphrase or a multisig threshold can still stand between an attacker and your funds.',
      opts: [
        { k: 'single', label: 'Single signature, no passphrase' },
        { k: 'passphrase', label: 'Single signature with a BIP39 passphrase' },
        { k: 'multi_under', label: 'Multisig, and fewer keys came from affected devices than my threshold',
          sub: 'For example one COLDCARD key in a 2-of-3' },
        { k: 'multi_over_spent', label: 'Multisig at or above threshold, and the relevant script or descriptor is exposed',
          sub: 'For example through a coordinator export, backup or previous script reveal' },
        { k: 'multi_over_unspent', label: 'Multisig at or above threshold, and the complete script may still be hidden',
          sub: 'This must be verified for the current outputs and wallet records' },
      ],
      next: (a) => ({
        single: 'V_ACT',
        passphrase: 'pass_strength',
        multi_under: 'V_BELOW_THRESHOLD',
        multi_over_spent: 'V_ACT_MULTI',
        multi_over_unspent: 'V_UNSPENT',
      }[a]),
    },

    pass_strength: {
      q: 'How was that passphrase chosen?',
      hint: 'Once the seed words are recoverable, the passphrase carries the entire security burden on its own.',
      opts: [
        { k: 'strong', label: 'Uniformly random, five or more Diceware words or equivalent',
          sub: 'Five or more words picked at random by dice or a tool, not by you' },
        { k: 'medium', label: 'Randomly generated but shorter',
          sub: 'Picked at random, but fewer than five words' },
        { k: 'invented', label: 'I thought it up myself',
          sub: 'Even a long one you invented and can recall' },
        { k: 'reused', label: 'It is reused from somewhere else' },
      ],
      next: (a) => ({
        strong: 'V_PASS_STRONG',
        medium: 'V_PASS_MEDIUM',
        invented: 'V_ACT_PASS',
        reused: 'V_ACT_PASS',
      }[a]),
    },
  };

  // --- verdicts -------------------------------------------------------------
  const V = {
    V_UNAFFECTED_IMPORT: {
      tone: 'safe', tag: 'Not affected, if the origin holds',
      head: 'Not affected by this bug, if the original generation method holds',
      body: 'This result rests entirely on the provenance you have just reported: that the seed\'s original generation method was independently checked and sits outside the affected COLDCARD path. The written decision path treats an unverified origin as unresolved rather than safe.',
      todo: ['Confirm how and where the words were originally generated; importing them into another device does not establish that.', 'This conclusion is limited to this predictable-generator incident. The original generator and backup process have their own security assumptions.'],
      links: [['Why seed origin matters', '/how-it-broke/'], ['Full risk criteria', '/risk/']],
    },
    V_ORIGIN_UNVERIFIED: {
      tone: 'warn', tag: 'Origin unresolved',
      head: 'The generation path cannot be classified',
      body: 'An imported or otherwise uncertain mnemonic is not evidence of an affected COLDCARD seed, but this incident cannot be ruled out until the original generator and method are independently verified.',
      todo: ['Check contemporaneous device, firmware, backup and generation records without disclosing recovery material.', 'If provenance remains unresolved, plan conservatively rather than treating the seed as unaffected.'],
      links: [['Full risk criteria', '/risk/'], ['Seed-word safety', '/safety/seed-words/']],
    },
    V_UNAFFECTED_OLD: {
      tone: 'safe', tag: 'Not affected by this bug',
      head: 'The seed predates the affected v4 path',
      body: 'Seed generation moved to the affected path in firmware v4.0.0, released 17 March 2021. The pre-v4 Mk2/Mk3 path called the STM32 hardware RNG directly.',
      todo: ['If the device was later updated and the seed was regenerated, classify the later generation separately.'],
      links: [['Firmware dates for every model', '/record/firmware/']],
    },
    V_UNAFFECTED_FIXED: {
      tone: 'warn', tag: 'Vendor-published fixed release',
      head: 'The generation used the model-specific fixed release',
      body: 'Coinkite\'s advisory, revised on 1 August 2026, now names v4.2.0 as the fixed release for Mk2 and Mk3 together, having previously described it as an Mk3 release. The source checked by this project records the fix for v4.2.0, Mk4/Mk5 v5.6.0, Q v1.5.0Q and the named Edge 6.6.0 releases. This project verified those source records and release listings, but did not independently reproduce or disassemble the signed firmware images and did not separately verify Mk2 execution. Installing a hotfix later does not repair an older seed.',
      todo: ['Confirm the exact version running when the words were generated, not only the version installed today.'],
      links: [['Firmware versions and evidence', '/record/firmware/']],
    },
    V_UNAFFECTED_DICE: {
      tone: 'safe', tag: 'Independent dice path',
      head: 'The pure-dice path bypassed the affected generator',
      body: 'Pure dice generation starts from the roll string instead of a device-generated seed. Fifty independent D6 rolls provide about 129.25 bits; 99 provide about 255.91 bits. A 12-word output carries at most 128 bits and a 24-word output at most 256.',
      todo: ['This assumes independent, honestly recorded rolls and the stated minimum for the chosen output length.'],
      links: [['Verifying dice yourself', '/risk/mitigations/#dice']],
    },
    V_DICE_REVIEW: {
      tone: 'warn', tag: 'Count the rolls',
      head: 'Pure dice changes the calculation, but the count matters',
      body: 'Pure dice bypasses the affected generator, but its candidate space is bounded by the number of independent rolls and by the mnemonic output size. Older and ephemeral flows could allow fewer than the 50-roll or 99-roll minimum enforced in the firmware state checked on 1 August 2026.',
      todo: ['Use the dice page to calculate the exact roll entropy.', 'If you cannot establish the roll count, do not classify the wallet as unaffected.'],
      links: [['Dice thresholds and version caveats', '/risk/mitigations/#dice'], ['Moving funds (single-signature)', '/risk/moving-funds/'], ['Multisig migration', '/risk/moving-funds/#threshold-wallets']],
    },
    V_UNAFFECTED_MIXED_DICE: {
      tone: 'safe', tag: 'Not at risk from this issue alone',
      head: 'The dice you added are hashed into the seed, and the vendor\'s exception covers this case',
      body: 'Every roll you entered was mixed into the seed rather than discarded, so those rolls still count. On affected firmware the device hashed each roll symbol into the seed as it was pressed and assigned the resulting digest back. Coinkite\'s advisory, as captured on 1 August 2026, puts 50 to 98 independent private rolls at a dice contribution of at least 128 bits and 99 or more at approximately 256 bits, and states that where at least 50 fair and independent rolls were entered and the rolls were not recorded or exposed, it does not consider the resulting seed at risk from this RNG issue alone.',
      todo: ['The advisory limits this to the final seed words shown after the dice were added. If you are uncertain which words you kept, it directs you to migrate rather than to rely on the exception.', 'While rolls are entered the device displays the running SHA-256 digest, and the final digest is the seed itself. A photograph or screen recording of that display defeats the exception even if no individual roll was ever written down.', 'This covers the RNG issue alone. Backup handling, passphrase choice and anything else derived from the seed keep their own assumptions.'],
      links: [['Verifying dice yourself', '/risk/mitigations/#dice'], ['The advisory as captured', '/record/sources/coinkite-mk3-advisory/'], ['Full risk criteria', '/risk/']],
    },
    V_MIXED_DICE_REVIEW: {
      tone: 'warn', tag: 'Count the rolls',
      head: 'Fewer than 50 added rolls sits below the vendor\'s dice exception',
      body: 'Mixed dice do add search space: every fair independent roll of a six-sided die contributes about 2.585 bits, and the firmware folds each one into the seed through SHA-256 rather than discarding it. Below 50 rolls, though, the added entropy is smaller than the 128-bit mnemonic input, and Coinkite\'s advisory sends anyone under that count to its migration guidance instead of to the exception. The defensible figure is the roll count you actually entered, not a safe or unsafe label.',
      todo: ['Use the dice page to calculate the exact entropy for the count you entered.', 'If the roll sequence, or the running digest the device displayed while you entered it, was ever photographed or recorded, the added margin does not hold at all.', 'Treat the added rolls as a margin to be measured rather than a reason to leave the funds where they are.'],
      links: [['Dice thresholds and version caveats', '/risk/mitigations/#dice'], ['Moving funds (single-signature)', '/risk/moving-funds/'], ['Multisig migration', '/risk/moving-funds/#threshold-wallets']],
    },
    V_BELOW_THRESHOLD: {
      tone: 'warn', tag: 'Below threshold, if fully counted',
      head: 'The affected keys do not meet the policy threshold',
      body: 'If every key has been counted correctly and no other key is compromised, recovering the affected keys alone is insufficient to spend. The wallet has nevertheless lost some of its intended failure margin.',
      todo: ['Rotate the affected key or keys through a deliberate, verified process.', 'Count any provider-held affected key as part of the same policy.'],
      links: [['Multisig threshold arithmetic', '/risk/mitigations/#multisig'], ['Provider-held keys', '/response/#provider-keys']],
    },
    V_UNSPENT: {
      tone: 'warn', tag: 'Descriptor visibility matters',
      head: 'Your wallet setup may not be public, but that has to be checked',
      body: 'Whether an attacker can even attempt this depends on details of your wallet that may never have been published. A native or nested P2WSH output commits to its witness script and reveals that script only when spent, and in nested form the scriptSig reveals the redeem-script witness program, so an attacker without the complete descriptor faces an extra barrier. An exposed individual co-signer xpub still gives them a way to test that signer. Address reuse on its own does not publish the script.',
      todo: ['Read the migration page before moving. A first spend can publish the complete script needed to construct a competing transaction.', 'Check the actual output type and whether the complete descriptor, script, derivation data or individual co-signer xpubs are already available outside the devices.'],
      links: [['Migrating and script disclosure', '/risk/moving-funds/#threshold-wallets'], ['Threshold and visibility', '/risk/mitigations/#multisig']],
      urgent: true,
    },
    V_PASS_STRONG: {
      tone: 'warn', tag: 'Passphrase is the remaining secret',
      head: 'Use the exact candidate count, not a generic strength label',
      body: 'How much protection the passphrase gives depends on exactly how it was built, not on a general label. A uniformly random five-word Diceware passphrase has 7,776^5 candidates, about 64.62 bits; six words have about 77.55 bits. Once the seed words are known, candidates can be tested offline, so the cost depends on the construction and the attack rate.',
      todo: ['Check the passphrase table using the exact generation method and length.', 'Plan migration without assuming the passphrase restores the original seed entropy.'],
      links: [['Passphrase candidate counts', '/risk/mitigations/#passphrase']],
    },
    V_PASS_MEDIUM: {
      tone: 'warn', tag: 'Finite offline search space',
      head: 'A shorter random passphrase has a measurable candidate set',
      body: 'A shorter random passphrase still has a countable set of possibilities. Four uniformly random Diceware words have 7,776^4 candidates, about 51.70 bits. Time to search varies by several orders of magnitude with the test rate, and the table shows those assumptions explicitly.',
      todo: ['Review the exact cost table and migrate through a deliberate process.'],
      links: [['The passphrase cost table', '/risk/mitigations/#passphrase']],
    },
    V_ACT_PASS: {
      tone: 'danger', tag: 'Prioritise migration',
      head: 'A human-chosen or reused passphrase has no reliable generic bit count',
      body: 'Once the mnemonic is recoverable, an attacker can test passphrase candidates offline against known wallet data. Human patterns and reused credentials can make the effective candidate set much smaller than the character count suggests.',
      todo: ['Move to a wallet generated from independently verified entropy.', 'Do not reuse the old passphrase in the replacement wallet.', 'Inventory anything else derived from this seed (BIP85 children, XOR shares, backups): what else is affected.'],
      links: [['Moving funds step by step', '/risk/moving-funds/'], ['What else is affected', '/how-it-broke/blast-radius/'], ['Passphrase modelling limits', '/risk/mitigations/#passphrase']],
      urgent: true,
    },
    V_ACT: {
      tone: 'danger', tag: 'Prioritise migration',
      head: 'No additional passphrase or threshold is assumed',
      body: 'This is a single-signature wallet from an affected seed, without an independent passphrase or pure-dice path. Published models vary widely by device and attacker knowledge; use the model register rather than treating one figure as verified.',
      todo: ['Generate a new seed on fixed firmware or a different device and move the balance through a verified process.', 'Verify the destination fingerprint before and after.', 'Do not reuse the old words. The weakness travels with them.', 'Inventory anything else derived from this seed (BIP85 children, XOR shares, backups): what else is affected.'],
      links: [['Moving funds step by step', '/risk/moving-funds/'], ['What else is affected', '/how-it-broke/blast-radius/'], ['Published attack models', '/how-it-broke/entropy/']],
      urgent: true,
    },
    V_ACT_MULTI: {
      tone: 'danger', tag: 'Prioritise migration',
      head: 'The threshold can be met with affected keys, and prior spends may expose the script',
      body: 'If at least the threshold number of keys came from affected seeds, the policy no longer excludes an attacker who can recover those keys. A disclosed complete P2WSH script provides its public-key targets and the construction required to spend, allowing affected keys to be searched independently. Recovering several keys still requires work on each one.',
      todo: ['Treat the configuration as exposed under the published models.', 'Read the migration page first because script disclosure can create a competing-spend window.'],
      links: [['Migrating and script disclosure', '/risk/moving-funds/#threshold-wallets'], ['Threshold arithmetic', '/risk/mitigations/#multisig']],
      urgent: true,
    },
  };

  // --- state ----------------------------------------------------------------
  let path = [];   // [{id, answer}]
  let current = 'origin';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const isVerdict = (id) => id.startsWith('V_');

  // How many questions can still follow, counting this one. The graph is
  // acyclic, so the recursion terminates, and the count stays correct when a
  // branch is added or removed. Used for both the ordinal and the progress bar,
  // so neither can be left behind by a change to the tree.
  const questionsRemaining = (id) => {
    if (isVerdict(id)) return 0;
    const q = Q[id];
    return 1 + Math.max(...q.opts.map((o) => questionsRemaining(q.next(o.k))));
  };

  function render() {
    if (isVerdict(current)) return renderVerdict(V[current]);
    renderQuestion(Q[current]);
  }

  function renderQuestion(q) {
    const answered = path.length;
    const total = answered + questionsRemaining(current);
    bar.style.width = (answered / total * 100) + '%';
    stage.innerHTML = '';

    const h = document.createElement('div');
    h.className = 'q__head';
    h.innerHTML =
      '<p class="q__num">Question ' + (answered + 1) + ' of ' + total + '</p>' +
      '<h3 class="q__title"></h3>' +
      (q.hint ? '<p class="q__hint"></p>' : '');
    h.querySelector('.q__title').textContent = q.q;
    if (q.hint) h.querySelector('.q__hint').textContent = q.hint;
    if (q.help) {
      const help = document.createElement('p');
      help.className = 'q__help';
      const a = document.createElement('a');
      a.href = q.help[1];
      a.textContent = q.help[0];
      help.appendChild(a);
      h.appendChild(help);
    }
    stage.appendChild(h);

    const list = document.createElement('div');
    list.className = 'q__opts';
    q.opts.forEach((o) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opt';
      const strong = document.createElement('span');
      strong.className = 'opt__label';
      strong.textContent = o.label;
      b.appendChild(strong);
      if (o.sub) {
        const s = document.createElement('span');
        s.className = 'opt__sub';
        s.textContent = o.sub;
        b.appendChild(s);
      }
      b.addEventListener('click', () => {
        path.push({ id: current, answer: o.k });
        current = q.next(o.k);
        render();
        stage.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
      });
      list.appendChild(b);
    });
    stage.appendChild(list);

    backBtn.hidden = path.length === 0;
    restartBtn.hidden = path.length === 0;
  }

  function renderVerdict(v) {
    bar.style.width = '100%';
    stage.innerHTML = '';

    const card = document.createElement('div');
    card.className = 'verdict verdict--' + v.tone;

    const tag = document.createElement('span');
    tag.className = 'verdict__tag';
    tag.textContent = v.tag;
    card.appendChild(tag);

    const h = document.createElement('h3');
    h.className = 'verdict__head';
    h.textContent = v.head;
    card.appendChild(h);

    const p = document.createElement('p');
    p.className = 'verdict__body';
    p.textContent = v.body;
    card.appendChild(p);

    // Only for the mixed-dice answers that fell through into the affected flow.
    // The two mixed-dice verdicts already state the position in full, and the
    // note would contradict the exception they grant.
    const mixedUnresolved = path.some(
      (step) => step.id === 'mixed_rolls' && step.answer === 'unknown',
    );
    if (mixedUnresolved) {
      const diceNote = document.createElement('p');
      diceNote.className = 'verdict__body';
      diceNote.textContent =
        'This result is conservative by construction. You added dice to a device-generated seed, and each fair independent D6 roll contributes about 2.585 bits which the firmware hashes into the seed. Coinkite\'s advisory extends its exception only to at least 50 fair, independent rolls that were not recorded or exposed, and only to the final words shown after the dice were added, so an unconfirmed count or an unconfirmed roll history keeps the seed in the affected group. If you can later establish the count and the conditions from your own records, answer the questions again.';
      card.appendChild(diceNote);
    }

    if (v.todo && v.todo.length) {
      const ul = document.createElement('ul');
      ul.className = 'verdict__todo';
      v.todo.forEach((t) => {
        const li = document.createElement('li');
        li.textContent = t;
        ul.appendChild(li);
      });
      card.appendChild(ul);
    }

    if (v.links && v.links.length) {
      const nav = document.createElement('div');
      nav.className = 'verdict__links';
      v.links.forEach(([label, href]) => {
        const a = document.createElement('a');
        a.className = 'btn btn--solid';
        a.href = href;
        a.textContent = label;
        nav.appendChild(a);
      });
      card.appendChild(nav);
    }

    if (v.urgent) {
      const warn = document.createElement('p');
      warn.className = 'verdict__scam';
      warn.textContent =
        'Before you act: do not disclose seed words, passphrases or private keys to a website, DM or support account. ' +
        'Take firmware only from coldcard.com and verify the signature. ';
      const how = document.createElement('a');
      how.href = '/record/firmware/#check-your-device';
      how.textContent = 'How to check your device\'s firmware version';
      warn.appendChild(how);
      card.appendChild(warn);
    }

    stage.appendChild(card);
    backBtn.hidden = false;
    restartBtn.hidden = false;

  }

  backBtn.addEventListener('click', () => {
    const prev = path.pop();
    current = prev ? prev.id : 'origin';
    render();
  });

  restartBtn.addEventListener('click', () => {
    path = []; current = 'origin';
    render();
  });

  render();
})();
</script>

