# Copy to .env and fill in. Never commit .env.

# The live domain. Used for canonical URLs and the sitemap.
SITE_URL=https://cc-vuln.org

# Cloudflare Pages project name (created once, see docs/operations.md).
CF_PAGES_PROJECT=cc-vuln

# Contact address shown across the website. A Cloudflare Email Routing alias on
# the domain forwards to your real inbox without revealing it.
PUBLIC_CONTACT=info@cc-vuln.org

# Optional: Signal alerting via `NOTIFY=relay ./scripts/notify.sh` (see
# docs/operations.md, "Signal alerting"). SSH host of your internal
# notification relay, plus the remote binary and config path it runs with.
# Leave unset to keep the relay path disabled (the default `local` path needs
# none of this).
NOTIFY_SSH_HOST=notify-relay-host
NOTIFY_REMOTE_BIN=/path/to/notification-relay/bin/notification-relay
NOTIFY_REMOTE_CONFIG=/path/to/notification-relay/config.yaml

# Publish captured screenshots of short social posts (see docs/publication.md,
# "What the published site shows"). Attached media and Reddit captures are
# never staged regardless of this flag.
PUBLIC_X_MEDIA=false

# X capture cookie source for capture-x.sh (gallery-dl --cookies-from-browser
# syntax: a browser name, optionally browser:/path/to/profile). Point it at
# the capture browser profile once its sessions are signed in.
X_COOKIES_BROWSER=chromium:.capture-browser/profile

# Watched-account X discovery uses only the official read-only X API. Create an
# X developer App whose registered use covers public-source discovery
# and transient AI-assisted relevance assessment, then put its app-only bearer
# token here. API content is not used for model training. Keep the watcher
# disabled while its API-health classifications are being proved.
# `just discover-x --check-auth` checks only that the local token is present.
X_API_BEARER_TOKEN=
X_DISCOVERY_ENABLED=false
X_DISCOVERY_MAX_WATCHES=6
X_DISCOVERY_PROFILE_DELAY=30
X_DISCOVERY_COOLDOWN_HOURS=24

# Cloudflare Pages deploy credentials for `just deploy`. Use a token scoped
# to Pages:Edit only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The unattended agents read text strangers wrote, so they run as their own
# account rather than as the account that owns this file. None of the
# variables here reach them: scripts/run-agent.sh builds their environment
# from an allowlist rather than inheriting one. See
# docs/design/agent-sandbox.md and docs/operations.md, "The agent account".
#
# AGENT_SANDBOX=off is a deliberate, recorded opt-out for a clone with no
# agent account, or for debugging a prompt. It leaves the agent able to read
# this file. Leave it unset in production; the drivers refuse to run
# unprotected rather than warning and continuing.
AGENT_SANDBOX=
AGENT_SANDBOX_USER=cc-agent

# Three interchangeable providers are installed in /usr/local/bin, each
# speaking the same `<bin> -p "<prompt>"` contract and each authenticating
# from the agent account's own home rather than an operator's:
#
#   /usr/local/bin/cc-agent-<name>   one wrapper per provider
#
# Which providers those are is not recorded in this repository. See
# AGENTS.local.md, and docs/operations.md, "The provider, and swapping
# between them".
#
# Swapping is this line and nothing else. The three variables below are
# independent, so the sweep can run on one provider while intake runs on
# another, which is also how you compare them on the same queue.
#
# Review agent CLI for scripts/agent-review.sh and the community-thread intake
# agent (scripts/agent-discovery-intake.sh). Optional; the archive works
# without it (diffs stay unreviewed and discovery candidates wait in
# DISCOVERY.md until classified). Any non-interactive CLI invoked as:
# <bin> -p "<prompt>".
REVIEW_AGENT_BIN=

# Separate processor for operator-approved X triage. It receives transiently
# hydrated X API content, so do not fall back to REVIEW_AGENT_BIN. Configure a
# local or otherwise approved non-interactive CLI with the same `-p <prompt>`
# interface only after reviewing the App's data-processing terms.
X_REVIEW_AGENT_BIN=

# Bound each archive-review invocation by both candidate count and aggregate
# diff bytes. One oversized diff is always admitted so the queue cannot stall.
# Defaults: 15 differences and 120000 bytes.
REVIEW_BATCH_SIZE=15
REVIEW_BATCH_BYTES=120000

# Optional separate agent for scripts/claim-sweep.sh; falls back to
# REVIEW_AGENT_BIN when unset.
CLAIM_SWEEP_AGENT_BIN=

# Fixed browser timezone for captures, so recaptures render identically and
# the browser clock matches the deployment network path. Defaults to UTC.
CAPTURE_BROWSER_TZ=

# nostr identity and discovery (see docs/operations.md, "nostr"). The nsec is
# the project's own posting key, generated once with `just nostr-keygen`; keep
# an offline backup. The pubkey/npub are public and are baked into the site
# build (NIP-05 at /.well-known/nostr.json, the npub on /cite/).
NOSTR_SECRET_KEY=
PUBLIC_NOSTR_PUBKEY_HEX=
PUBLIC_NOSTR_NPUB=
# Relays the identity publishes to, and the NIP-50 search relays discovery
# queries. Comma-separated wss:// URLs. Search relay survey from the capture
# host (6 Aug 2026, via NIP-66 monitor events): the defaults below all answer
# a live "coldcard" query; relay.nostr.band is TCP-unreachable, and
# relay.noswhere.com, relay.nostrcheck.me, relay.vertexlab.io,
# filter.nostr.wine, relay.orly.dev and relay.mleku.dev connect but return
# nothing.
NOSTR_WRITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
NOSTR_SEARCH_RELAYS=wss://search.nos.today,wss://nostrja-kari-nip50.heguro.com,wss://antiprimal.net,wss://relay.ditto.pub,wss://nostr.wine
# Manual probation kill switch, same posture as X_DISCOVERY_ENABLED.
NOSTR_DISCOVERY_ENABLED=false
