.venv/
__pycache__/
*.pyc
archive/x/_capture-*.log
.DS_Store
site/node_modules/
site/dist/
site/.astro/
site/.wrangler/
.env
.work/

# Operator kill switch for the scheduled publish timer: while this exists,
# scripts/publish-scheduled.sh skips every tick and says why.
.no-publish
site/tools/private-tokens.json
AGENTS.local.md
site/public/x-media/
site/src/data/x-media.json

# Captured video: kept on the capture host, never committed. Too large for
# hosting limits, and the sidecar hashes already establish what was held.
archive/x/**/*.mp4
archive/x/**/*.mov
archive/x/**/*.webm

# Browser profile and installed Chromium: a signed-in session must never
# reach a commit.
.capture-browser/

# Withheld sources: none. A source can opt out of having its captured
# bodies published by setting `withhold_text = true` in sources.toml,
# which scripts/check_publishable.py then keeps out of any commit.
# A repository is publication too, and a clone outlives a deletion.


# Pre-overwrite safety tarballs from the backup-before-clobbering workflow.
# Local safety net only, never project content.
.backups/

# Local tool permissions, editor configuration and the scratch directories the
# agent CLIs create in the tree are excluded in .git/info/exclude instead of
# here. An ignore rule that names a provider discloses which tooling this
# project runs, and that belongs with .env and AGENTS.local.md.
